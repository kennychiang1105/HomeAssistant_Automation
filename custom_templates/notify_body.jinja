{# ──────────────────────────────────────────────────────
   通知內文排版 (V4.1.0)：LINE Flex 與 HA 通知共用同一份「行模型」，版面一致。
   - 每一個項目行都有圖示（先依關鍵字挑；沒有關鍵字時，「本次更新／版本」段落用 update，其餘用 info），不再「有的有、有的沒有」。
   - 「名稱：舊版 → 新版」與「名稱：V1.2.3」一律拆成兩行：名稱一行、版本獨立一行（舊版灰色、新版綠色粗體）。
   - 每個項目之間空一行（margin）；【小標題】獨立成行、藍色粗體；第一行是通知重點（粗體、較大）。
   用法：{% from 'notify_body.jinja' import flex_rows, md_lines %}
   圖示檔：/local/icons/b/<name>.png（96px）。新增圖示或關鍵字時修改本檔後執行 homeassistant.reload_custom_templates。
   ────────────────────────────────────────────────────── #}
{% macro pick(t) -%}
{%- if t | regex_search('門鈴') -%}doorbell
{%- elif t | regex_search('電量|電池|耗材') -%}battery
{%- elif t | regex_search('溫度|°C|體感|冷氣|空調') -%}thermo
{%- elif t | regex_search('濕度|降雨|豪雨|下雨|水位|洩洪') -%}drop
{%- elif t | regex_search('PM2|PM1|空氣|清淨機') -%}air
{%- elif t | regex_search('風扇|風速') -%}fan
{%- elif t | regex_search('門鎖|上鎖|已鎖|解鎖') -%}lock
{%- elif t | regex_search('鐵門|車庫') -%}gate
{%- elif t | regex_search('車牌|Tesla|充電|車輛') -%}car
{%- elif t | regex_search('攝影|影像|截圖|影片|監視') -%}camera
{%- elif t | regex_search('地震|震度|規模') -%}quake
{%- elif t | regex_search('天氣|颱風|氣象') -%}weather
{%- elif t | regex_search('保全|闖入|入侵|防區') -%}shield
{%- elif t | regex_search('網路|網關|Wi-Fi|WiFi|連線|離線|伺服器|斷線') -%}network
{%- elif t | regex_search('廣播|喇叭|語音') -%}speaker
{%- elif t | regex_search('燈') -%}bulb
{%- elif t | regex_search('家人|有人|人員|在家|離家|回家|到家') -%}person
{%- elif t | regex_search('\d{1,2}:\d{2}|分鐘|小時|秒後|預估|天數|時間') -%}clock
{%- elif t | regex_search('注意|警告|異常|請確認|⚠|‼|❗') -%}alarm
{%- elif t | regex_search('已完成|成功|已關閉|已開啟|已啟動|已執行|正常|✅') -%}check
{%- elif t | regex_search('設定|系統|參數|模式') -%}gear
{%- elif t | regex_search('更新|版本') -%}update
{%- endif -%}
{%- endmacro %}

{# 去掉行首的項目符號與 emoji（圖示取代它們） #}
{% macro clean(t) -%}
{{- (t | trim) | regex_replace('^[\s•·\-\*]*([🌀-🫿☀-➿⬀-⯿️]\s*)*', '') | trim -}}
{%- endmacro %}
{% macro bullet(t) -%}
{{- (t | trim) | regex_replace('^[•·\-\*]+\s*', '') | trim -}}
{%- endmacro %}

{# 前處理：①每句（以「。」結尾）自成一行；②版本行拆成「名稱」＋「@@V@@舊@@新」兩行；網址行不拆 #}
{% macro prep(lines) -%}
{%- set arrow_re = '^(.+?)[：:]\s*(.*?\d.*?)\s*(?:→|->|➜)\s*(.+?)\s*$' -%}
{%- set one_re = '^(.+?)[：:]\s*((?:[Vv]\d|\d+\.\d+\.\d+|\d+(?:\.\d+)?\s*[（(]上次).*)$' -%}
{%- set ver_hint = '[Vv]\d|\d+\.\d+\.\d+|[Bb]eta' -%}
{%- set ns = namespace(out=[]) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.out = ns.out + [''] -%}
  {%- elif t | regex_search('https?://') -%}
    {%- set ns.out = ns.out + [t] -%}
  {%- elif t | regex_search('→|->|➜') and t | regex_search(ver_hint) and (t | regex_findall(arrow_re) | length) > 0 -%}
    {%- set m = (t | regex_findall(arrow_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@' ~ (m[1] | trim) ~ '@@' ~ (m[2] | trim)] -%}
  {%- elif (t | regex_findall(one_re) | length) > 0 and not (t | regex_search('。')) -%}
    {%- set m = (t | regex_findall(one_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@@@' ~ (m[1] | trim)] -%}
  {%- else -%}
    {%- for part in (t | regex_replace('。\s*', '。\n')).split('\n') -%}
      {%- if part | trim != '' -%}{%- set ns.out = ns.out + [part | trim] -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# 行模型：JSON 清單，每個元素 {k: hdr|sec|ent|ver, t, icon, old, new, gap} #}
{% macro model(lines0) -%}
{%- set lines = prep(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], first=true, sect='', gap=false) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.gap = true -%}
  {%- elif ns.first -%}
    {%- set ns.out = ns.out + [{'k': 'hdr', 't': bullet(t)}] -%}
    {%- set ns.first = false -%}
  {%- elif t.startswith('@@V@@') -%}
    {%- set p = t[5:].split('@@') -%}
    {%- set ns.out = ns.out + [{'k': 'ver', 'old': p[0], 'new': p[1] if p | length > 1 else ''}] -%}
  {%- elif t | regex_search('^[【\[].+[】\]]$') -%}
    {%- set ns.sect = t -%}
    {%- set ns.out = ns.out + [{'k': 'sec', 't': t}] -%}
    {%- set ns.gap = false -%}
  {%- else -%}
    {%- set n = pick(t) | trim -%}
    {%- set ic = n if n else ('update' if ns.sect | regex_search('更新|版本') else 'info') -%}
    {%- set c = clean(t) | trim -%}
    {%- set ns.out = ns.out + [{'k': 'ent', 't': c if c else t, 'icon': ic, 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# LINE Flex：回傳 JSON 字串（清單） #}
{% macro flex_rows(lines0, base, max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[]) -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set ns.out = ns.out + [{"type": "text", "text": it.t, "size": "md", "weight": "bold", "wrap": true, "lineSpacing": "4px", "color": "#111827"}] -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.out = ns.out + [{"type": "text", "text": it.t, "size": "sm", "weight": "bold", "wrap": true, "margin": "xxl", "color": "#2F80ED"}] -%}
  {%- elif it.k == 'ent' -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "md", "margin": ('xxl' if it.gap else 'lg'), "contents": [{"type": "image", "url": base ~ it.icon ~ ".png?v=1", "size": "20px", "flex": 0, "aspectMode": "fit"}, {"type": "text", "text": it.t, "size": "sm", "weight": "bold", "wrap": true, "flex": 1, "lineSpacing": "4px", "color": "#1F2937"}]}] -%}
  {%- else -%}
    {%- set spans = ([{"type": "span", "text": it.old, "color": "#9CA3AF"}, {"type": "span", "text": "   →   ", "color": "#9CA3AF"}] if it.old else []) + [{"type": "span", "text": it.new, "weight": "bold", "color": ("#16A34A" if it.old else "#4B5563")}] -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "xs", "paddingStart": "28px", "contents": [{"type": "text", "size": "xs", "wrap": true, "contents": spans}]}] -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# HA 通知（Markdown）：與 LINE 同一份行模型；每個項目之間空一行，版本接在名稱下一行 #}
{% macro md_lines(lines0, base, url='', max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(md=[]) -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set ns.md = ns.md + ['**' ~ body ~ '**'] -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.md = ns.md + ['**' ~ it.t ~ '**'] -%}
  {%- elif it.k == 'ent' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set ns.md = ns.md + ['- <img src="' ~ base ~ it.icon ~ '.png" width="18" height="18"> ' ~ body] -%}
  {%- else -%}
    {%- set v = ('<code>' ~ it.old ~ '</code> → <b><code>' ~ it.new ~ '</code></b>') if it.old else ('<code>' ~ it.new ~ '</code>') -%}
    {%- if ns.md | length > 0 -%}
      {%- set ns.md = ns.md[:-1] + [ns.md[-1] ~ '<br>' ~ v] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.md | join('\n\n') -}}
{%- endmacro %}
