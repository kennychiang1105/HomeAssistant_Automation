{# ──────────────────────────────────────────────────────
   通知內文排版 (V4.1.6)：LINE Flex 與 HA 通知共用同一份「行模型」，版面一致。
   - V4.1.6：圖示只放在「小標題（冒號結尾）」「名稱：數值」與「警告」行（標題行不放，保持單行）；圖示顏色依重要度（紅=緊急、橘=警告、綠=正常完成、藍=一般），共 70 款（www/icons/b2/<名稱>_<n|g|o|r>.png）（警告、異常、未關、未上鎖、離線、不穩…），一般項目不放圖示以免干擾閱讀；
             「名稱：數值」拆成灰色小字名稱＋粗體數值（例如 客廳門鎖電量　76%）；一般句子用正常粗細。
   - V4.1.0（已被上一行取代）：每一個項目行都有圖示。
   - 「名稱：舊版 → 新版」與「名稱：V1.2.3」一律拆成兩行：名稱一行、版本獨立一行（舊版灰色、新版綠色粗體）。
   - 每個項目之間空一行（margin）；【小標題】獨立成行、藍色粗體；第一行是通知重點（粗體、較大）。
   用法：{% from 'notify_body.jinja' import flex_rows, md_lines %}
   圖示檔：/local/icons/b/<name>.png（96px）。新增圖示或關鍵字時修改本檔後執行 homeassistant.reload_custom_templates。
   ────────────────────────────────────────────────────── #}
{% macro pick(t) -%}
{%- if t | regex_search('門鈴') -%}doorbell
{%- elif t | regex_search('電量|電池|耗材|濾網') -%}battery
{%- elif t | regex_search('離家|外出|出門') -%}homeout
{%- elif t | regex_search('到家|回家|返家') -%}homein
{%- elif t | regex_search('解鎖|開鎖|已開鎖') -%}unlock
{%- elif t | regex_search('指紋|密碼|鑰匙|卡片') -%}key
{%- elif t | regex_search('門鎖|上鎖|已鎖|未鎖') -%}lock
{%- elif t | regex_search('鐵門|車庫') and t | regex_search('開啟|打開|未關|沒關|開著') -%}gateopen
{%- elif t | regex_search('鐵門|車庫') -%}gate
{%- elif t | regex_search('天數|日期|星期|今天|明天|本週|週報') -%}calendar
{%- elif t | regex_search('預估|倒數|分鐘|等待|秒後|逾時|剩餘') -%}hourglass
{%- elif t | regex_search('\d{1,2}:\d{2}|時間|時刻') -%}clock
{%- elif t | regex_search('溫度|°C|體感') -%}thermo
{%- elif t | regex_search('冷氣|空調|暖氣') -%}ac
{%- elif t | regex_search('濕度') -%}humid
{%- elif t | regex_search('降雨|豪雨|下雨|水位|洩洪|漏水') -%}drop
{%- elif t | regex_search('PM2|PM1|空氣|清淨機|CO2|二氧化碳|一氧化碳|揮發|VOC|甲醛|懸浮微粒') -%}air
{%- elif t | regex_search('風扇|風速') -%}fan
{%- elif t | regex_search('Tesla|充電|充電樁') -%}ev
{%- elif t | regex_search('電壓|電流|功率|用電|耗電|插座') -%}plug
{%- elif t | regex_search('車牌|車輛|汽車|車子') -%}car
{%- elif t | regex_search('影片|錄影') -%}video
{%- elif t | regex_search('攝影|影像|截圖|監視') -%}camera
{%- elif t | regex_search('地震|震度|規模') -%}quake
{%- elif t | regex_search('颱風|氣象|天氣|豪雨') -%}weather
{%- elif t | regex_search('紫外線|UV|日出|日落|白天|早安') -%}sun
{%- elif t | regex_search('晚安|夜間|深夜') -%}moon
{%- elif t | regex_search('熟睡|睡眠|睡') -%}bed
{%- elif t | regex_search('闖入|入侵') -%}shieldoff
{%- elif t | regex_search('警戒|布防|撤防') -%}shieldlock
{%- elif t | regex_search('保全|防區') -%}shield
{%- elif t | regex_search('警報') -%}alarm
{%- elif t | regex_search('路由|AP|Wi-Fi|WiFi') -%}router
{%- elif t | regex_search('伺服器|主機|NAS') -%}server
{%- elif t | regex_search('網路|網關|連線|離線|斷線') -%}network
{%- elif t | regex_search('麥克風') -%}mic
{%- elif t | regex_search('廣播|喇叭|語音|HomePod') -%}speaker
{%- elif t | regex_search('電視') -%}tv
{%- elif t | regex_search('燈') -%}bulb
{%- elif t | regex_search('感應|移動|偵測|動作') -%}motion
{%- elif t | regex_search('家人|人員|所有人|成員') -%}people
{%- elif t | regex_search('在家|有人|人物') -%}person
{%- elif t | regex_search('樓梯') -%}stairs
{%- elif t | regex_search('客廳') -%}sofa
{%- elif t | regex_search('臥室|房間') -%}bed
{%- elif t | regex_search('廁所|浴室') -%}toilet
{%- elif t | regex_search('廚房') -%}kitchen
{%- elif t | regex_search('大門|房門|門(?!檻)') -%}door
{%- elif t | regex_search('手機|平板|iPhone|iPad') -%}phone
{%- elif t | regex_search('位置|地點|座標') -%}pin
{%- elif t | regex_search('次數|數量|統計|計數') -%}counter
{%- elif t | regex_search('款式|型號|名稱|版本') -%}tag
{%- elif t | regex_search('更新') -%}update
{%- elif t | regex_search('重置|重啟|重新|重試') -%}refresh
{%- elif t | regex_search('關機|開機|電源') -%}power
{%- elif t | regex_search('公告|提醒|宣告') -%}announce
{%- elif t | regex_search('通知|訊息|LINE') -%}mail
{%- elif t | regex_search('Bot|對話') -%}chat
{%- elif t | regex_search('維修|維護|保養') -%}tool
{%- elif t | regex_search('設定|參數|模式|情境|系統') -%}gear
{%- elif t | regex_search('失敗|異常|錯誤') -%}bug
{%- elif t | regex_search('已完成|成功|正常') -%}check
{%- endif -%}
{%- endmacro %}

{# 重要度配色：r 紅（緊急）／o 橘（警告）／g 綠（正常完成）／n 藍（一般資訊） #}
{% macro tone(t) -%}
{%- if t | regex_search('緊急|入侵|闖入|警報|地震|火災|一氧化碳|嚴重') -%}r
{%- elif t | regex_search('注意|警告|異常|失敗|未完成|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠') -%}o
{%- elif t | regex_search('已完成|完成|完畢|成功|正常|已關閉|已上鎖|皆已|已恢復|已啟動|已執行|已開啟|已提前|已關') -%}g
{%- else -%}n
{%- endif -%}
{%- endmacro %}

{# V4.1.6：過長的句子在「，」靠近中間處斷行（LINE 自動換行會留下孤字，例如「請注／意。」）#}
{% macro balance(t, lim) -%}
{%- if (t | length) <= lim or '，' not in t -%}{{ t }}
{%- else -%}
  {%- set parts = t.split('，') -%}
  {%- set ns = namespace(lines=[], cur='') -%}
  {%- for p in parts -%}
    {%- set piece = p ~ ('，' if not loop.last else '') -%}
    {%- if ns.cur != '' and ((ns.cur | length) + (piece | length)) > lim -%}
      {%- set ns.lines = ns.lines + [ns.cur] -%}{%- set ns.cur = piece -%}
    {%- else -%}
      {%- set ns.cur = ns.cur ~ piece -%}
    {%- endif -%}
  {%- endfor -%}
  {{- (ns.lines + [ns.cur]) | join('\n') -}}
{%- endif -%}
{%- endmacro %}

{# V4.1.6：行內顏色標記 ⟦g:文字⟧（綠）⟦o:…⟧（黃）⟦r:…⟧（紅）⟦n:…⟧（灰）→ LINE span 清單（JSON） #}
{% macro mspans(txt, dflt='#111827') -%}
{%- set cmap = {'g': '#16A34A', 'o': '#D97706', 'r': '#DC2626', 'n': '#9CA3AF'} -%}
{%- set ns = namespace(o=[]) -%}
{%- for c, t1, t2 in (txt | regex_findall('⟦([rogn]):([^⟧]*)⟧|([^⟦]+)')) -%}
  {%- if c and t1 -%}{%- set ns.o = ns.o + [{"type": "span", "text": t1, "color": cmap[c], "weight": "bold"}] -%}
  {%- elif t2 -%}{%- set ns.o = ns.o + [{"type": "span", "text": t2, "color": dflt}] -%}{%- endif -%}
{%- endfor -%}
{{- ns.o | tojson -}}
{%- endmacro %}
{# 同一套標記 → HA 通知（HTML） #}
{% macro mhtml(txt) -%}
{{- txt | regex_replace('⟦g:([^⟧]*)⟧', '<span style="color:#16A34A"><b>\\1</b></span>') | regex_replace('⟦o:([^⟧]*)⟧', '<span style="color:#D97706"><b>\\1</b></span>')
       | regex_replace('⟦r:([^⟧]*)⟧', '<span style="color:#DC2626"><b>\\1</b></span>') | regex_replace('⟦n:([^⟧]*)⟧', '<span style="color:#9CA3AF">\\1</span>') -}}
{%- endmacro %}

{# V4.1.6：空氣品質讀數的燈號（綠 g／黃 o／紅 r），回傳 ⟦g⟧ 這種行尾標記；標記會被排版吃掉、並把該行數值與圖示染成對應顏色 #}
{% macro env_tag(kind, v) -%}
{%- set x = v | float(0) -%}
{%- if kind == 'co2' -%}{{ '⟦g⟧' if x < 1000 else ('⟦o⟧' if x < 2000 else '⟦r⟧') }}
{%- elif kind == 'pm' -%}{{ '⟦g⟧' if x <= 15 else ('⟦o⟧' if x <= 35 else '⟦r⟧') }}
{%- elif kind == 'pm10' -%}{{ '⟦g⟧' if x <= 54 else ('⟦o⟧' if x <= 125 else '⟦r⟧') }}
{%- elif kind == 'pm1' -%}{{ '⟦g⟧' if x <= 15 else ('⟦o⟧' if x <= 35 else '⟦r⟧') }}
{%- elif kind == 'tvoc' -%}{{ '⟦g⟧' if x <= 220 else ('⟦o⟧' if x <= 600 else '⟦r⟧') }}
{%- elif kind == 'co' -%}{{ '⟦g⟧' if x < 9 else ('⟦o⟧' if x < 35 else '⟦r⟧') }}
{%- elif kind == 'ch2o' -%}{{ '⟦g⟧' if x <= 0.05 else ('⟦o⟧' if x <= 0.08 else '⟦r⟧') }}
{%- elif kind == 'temp' -%}{{ '⟦g⟧' if (15 <= x <= 30) else ('⟦o⟧' if (10 <= x < 15 or 30 < x < 40) else '⟦r⟧') }}
{%- elif kind == 'hum' -%}{{ '⟦g⟧' if (40 <= x <= 60) else ('⟦o⟧' if (30 <= x < 40 or 60 < x <= 70) else '⟦r⟧') }}
{%- endif -%}
{%- endmacro %}

{# V4.1.6：句尾的「請注意」拆出來，後面加注意圖示。回傳 JSON [前段, 請注意] ；沒有就回 ["",""] #}
{% macro ca_split(t) -%}
{%- set m = t | regex_findall('^(.*?)\\s*(請注意[。.]?)$') -%}
{%- if m | length > 0 and (m[0][0] == '' or m[0][0][-1:] in ['，', ',']) -%}{{ [m[0][0], m[0][1]] | tojson }}{%- else -%}["", ""]{%- endif -%}
{%- endmacro %}

{# V4.1.6：需要注意的行才放圖示 #}
{% macro is_warn(t) -%}
{%- if t | regex_search('注意|警告|異常|失敗|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠|‼|❗|入侵|闖入|緊急') -%}1{%- endif -%}
{%- endmacro %}

{# 去掉行首的項目符號與 emoji（圖示取代它們） #}
{% macro noemoji(t) -%}
{{- (t | trim) | regex_replace('[🌀-🫿☀-➿⬀-⯿️‼❗❓]\uFE0F?', '') | regex_replace('^[，,、\s]+', '') | regex_replace('[，,、]+(?=。|$)', '') | regex_replace('\s{2,}', ' ') | trim -}}
{%- endmacro %}
{% macro untag(t) -%}
{{- (t | trim) | regex_replace('^[\[【][^\]】]{1,8}[\]】]\s*(?=\S)', '') -}}
{%- endmacro %}
{% macro clean(t) -%}
{{- noemoji(untag((t | trim) | regex_replace('^[\s•·\-\*]+', ''))) -}}
{%- endmacro %}
{% macro bullet(t) -%}
{{- noemoji(untag((t | trim) | regex_replace('^[•·\-\*]+\s*', ''))) -}}
{%- endmacro %}

{# 前處理：①每句（以「。」結尾）自成一行；②版本行拆成「名稱」＋「@@V@@舊@@新」兩行；網址行不拆 #}
{% macro prep(lines) -%}
{%- set arrow_re = '^(.+?)[：:]\s*(.*?\d.*?)\s*(?:→|->|➜)\s*(.+?)\s*$' -%}
{%- set one_re = '^(.+?)[：:]\s*((?:[Vv]\d|\d+\.\d+\.\d+|\d+(?:\.\d+)?\s*[（(]上次).*)$' -%}
{%- set ver_hint = '[Vv]\d|\d+\.\d+\.\d+|[Bb]eta' -%}
{%- set ns = namespace(out=[]) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.out = ns.out + [''] -%}
  {%- elif t | regex_search('https?://') -%}
    {%- set ns.out = ns.out + [t] -%}
  {%- elif t | regex_search('→|->|➜') and t | regex_search(ver_hint) and (t | regex_findall(arrow_re) | length) > 0 -%}
    {%- set m = (t | regex_findall(arrow_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@' ~ (m[1] | trim) ~ '@@' ~ (m[2] | trim)] -%}
  {%- elif (t | regex_findall(one_re) | length) > 0 and not (t | regex_search('。')) -%}
    {%- set m = (t | regex_findall(one_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@@@' ~ (m[1] | trim)] -%}
  {%- else -%}
    {%- for part in (t | regex_replace('。\s*', '。\n')).split('\n') -%}
      {%- if part | trim != '' -%}{%- set ns.out = ns.out + [part | trim] -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# 行模型：JSON 清單，每個元素 {k: hdr|sec|ent|ver, t, icon, old, new, gap} #}
{% macro model(lines0) -%}
{%- set lines = prep(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], first=true, sect='', gap=false, insec=false, base='n', hi=0) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.gap = true -%}
  {%- elif ns.first -%}
    {%- set hb = bullet(t) -%}
    {%- set ns.base = tone(hb) | trim -%}
    {%- set hc = ca_split(hb) | from_json(['', '']) -%}
    {%- set hcat = 'bell' if (hb | regex_search('通知$|通知。$')) else (pick(hb) | trim) -%}
    {%- set hbal = (hb | replace('，', '，\n')) if (hb.count('，') >= 2 and not hb.endswith('，')) else balance(hb, 15 - (2 if hc[1] else 0)) -%}
    {%- set hn = (hbal.split('\n') | map('length') | max) + (2 if hc[1] else 0) -%}
    {%- set ns.out = ns.out + [{'k': 'hdr', 't': hb, 'tb': hbal, 'ca': hc[1], 'pre': '', 'cain': false, 'icon': (hcat if hcat else 'announce'), 'tone': tone(hb) | trim, 'hsz': ([16, (246 / ([hn, 1] | max)) | int] | min)}] -%}
    {%- set ns.first = false -%}
  {%- elif t.startswith('@@V@@') -%}
    {%- set p = t[5:].split('@@') -%}
    {%- set ns.out = ns.out + [{'k': 'ver', 'old': p[0], 'new': p[1] if p | length > 1 else ''}] -%}
  {%- elif t.startswith('※') -%}
    {%- set flat = t.startswith('※※') -%}
    {#- V4.2.0 新格式：除了不縮排的圖例說明（※※），所有 ※ 備註／提醒都是小字、縮排對齊上一列圖示、上方有橫線；舊的 ※~ 寫法仍相容 -#}
    {%- set small = not flat -%}
    {%- set ns.out = ns.out + [{'k': 'note', 't': (t[2:] if (flat or t.startswith('※~')) else t[1:]) | trim, 'sub': ns.insec and not flat, 'flat': flat, 'small': small, 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- elif t | regex_search('^[【\[].+[】\]]$') -%}
    {%- set ns.sect = t -%}
    {%- set ns.out = ns.out + [{'k': 'sec', 't': t}] -%}
    {%- set ns.gap = false -%}
  {%- else -%}
    {%- set tgm = t | regex_findall('⟦([rog])⟧\\s*$') -%}
    {%- set tg = tgm[0] if tgm | length > 0 else '' -%}
    {%- set c = clean(t) | regex_replace('\\s*⟦[rog]⟧\\s*$', '') | trim -%}
    {%- set body = c if c else t -%}
    {%- set warn = is_warn(t) | trim == '1' -%}
    {#- V4.1.6：沒有冒號但是「名稱 數值」的舊式行（例如「開始時間 2026-10-15 23:59」「目前狀態 charging」）也當成名稱／數值行 -#}
    {%- set lv1 = (body | regex_findall('^([^：:。，,\s]{1,12})[：:]\s*(.+)$')) if not (body | regex_search('https?://')) else [] -%}
    {%- set lv2 = (body | regex_findall('^([^\s：:。，,]{0,6}(?:時間|溫度|狀態|車輛|用時|用電量|電量|天數|數量|名稱|型號|款式|位置|模式|情境|金額|次數|版本|狀況|濕度|濃度|數值|剩餘|容量|功率|電壓|電流))\s+([^。，,]{1,40})$')) if (lv1 | length == 0 and not (body | regex_search('https?://'))) else [] -%}
    {%- set lv = lv1 if lv1 | length > 0 else lv2 -%}
    {%- set is_sec = body | regex_search('^[^。]{1,16}[：:]$') -%}
    {#- V4.1.6：圖示只給「小標題行（以冒號結尾）」「名稱：數值」與「警告」行；一般句子不放圖示；顏色依重要度 -#}
    {%- set cat = pick(body) | trim -%}
    {%- set icon = (cat if cat else 'alarm') if warn else ((cat if cat else 'list') if is_sec else ((cat if cat else 'tag') if lv | length > 0 else '')) -%}
    {%- if ns.gap and not is_sec -%}{%- set ns.insec = false -%}{%- endif -%}
    {%- set sub = ns.insec and not is_sec and not warn -%}
    {%- if is_sec -%}{%- set ns.insec = true -%}{%- endif -%}
    {%- set ec = (ca_split(body) | from_json(['', ''])) if (lv | length == 0) else ['', ''] -%}
    {%- set lim = (20 if sub else 15) - (2 if ec[1] else 0) -%}
    {#- V4.1.6：同一則圖示顏色以標題為主；挑最多 2 個重點「名稱：數值」行（用電量、電量、預估、用時、狀態…）換成對比色 -#}
    {%- set own = tg if tg else (tone(body) | trim) -%}
    {%- set hl = (lv | length > 0) and tg == '' and (own not in ['r', 'o']) and ns.hi < 3 and (lv[0][0] | regex_search('開始時間|結束時間|用電量|電量|預估|剩餘|用時|已開啟|狀態|情境|模式|金額|次數')) -%}
    {%- if hl -%}{%- set ns.hi = ns.hi + 1 -%}{%- endif -%}
    {%- set acc = {'n': ['g', 'p', 'g'], 'g': ['n', 'p', 'n'], 'o': ['n', 'p', 'n'], 'r': ['n', 'p', 'n']}[ns.base if ns.base in ['n', 'g', 'o', 'r'] else 'n'] -%}
    {%- set etone = tg if tg else own if own in ['r', 'o'] else (acc[ns.hi - 1] if hl else ns.base) -%}
    {%- set ns.out = ns.out + [{'k': 'ent', 't': body, 'tb': (body if (lv | length > 0) else balance(body, lim)), 'ca': ec[1], 'pre': balance(ec[0], lim), 'cain': (ec[1] != '' and (body | length) <= lim), 'sub': sub, 'icon': icon, 'tone': etone, 'ttone': own, 'vt': tg, 'sec': is_sec, 'lab': (lv[0][0] if lv | length > 0 else ''), 'val': (lv[0][1] if lv | length > 0 else ''), 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# LINE Flex：回傳 JSON 字串（清單） #}
{# V4.2.0：每個小段落（小標題行／【段落】）上方加一條橫線；提醒小字（※~）上方加一條短橫線（連續的提醒只在第一行上方加） #}
{% macro flex_rows(lines0, base, max_icons=5, hsep=false) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], last_small=false) -%}
{%- set b2 = base | replace('/icons/b/', '/icons/b2/') -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set himg = {"type": "image", "url": b2 ~ it.icon ~ "_" ~ it.tone ~ ".png?v=1", "size": "24px", "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
    {%- if it.ca -%}
      {%- set htxt = {"type": "text", "size": (it.hsz ~ "px"), "weight": "bold", "wrap": true, "flex": 1, "lineSpacing": "4px", "color": "#111827", "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": "⚠︎", "color": "#F2994A"}]} -%}
    {%- else -%}
      {%- set htxt = {"type": "text", "text": it.tb, "size": (it.hsz ~ "px"), "weight": "bold", "wrap": true, "flex": 1, "lineSpacing": "4px", "color": "#111827"} -%}
    {%- endif -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "4px", "alignItems": "flex-start", "contents": [himg, htxt]}] -%}
    {%- if hsep -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
  {%- elif it.k == 'note' -%}
    {%- if it.gap and not it.flat and (ns.out | length > 0) -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- elif it.small and not ns.last_small -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "md", "paddingStart": "28px", "contents": [{"type": "separator", "color": "#E5E7EB"}]}] -%}
    {%- endif -%}
    {%- set lg = (it.t | regex_findall('綠色\\s*(\\S+?)\\s+黃色\\s*(\\S+?)\\s+紅色\\s*(\\S+)')) if it.flat else [] -%}
    {%- if lg | length > 0 -%}
      {#- V4.2.0：顏色示意條：圓點顏色與卡片裡的綠／橘／紅一致，字小一點 -#}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": "lg", "paddingAll": "8px", "paddingStart": "12px", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "spacing": "lg", "alignItems": "center", "contents": [
        {"type": "text", "text": "顏色示意", "size": "xxs", "color": "#9CA3AF", "flex": 0},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#16A34A", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][0], "color": "#6B7280"}]},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#D97706", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][1], "color": "#6B7280"}]},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#DC2626", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][2], "color": "#6B7280"}]}]}] -%}
    {%- else -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": ('xl' if it.gap else 'xs'), "paddingStart": ('0px' if it.flat else ('28px' if it.small else ('48px' if it.sub else '28px'))), "contents": [{"type": "text", "size": ("xxs" if it.small else "xs"), "wrap": true, "flex": 1, "color": "#9CA3AF", "contents": (mspans(it.t, '#9CA3AF') | from_json([]))}]}] -%}
    {%- endif -%}
  {%- elif it.k == 'sec' -%}
    {%- if ns.out | length > 0 -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
    {%- set ns.out = ns.out + [{"type": "text", "text": it.t, "size": "sm", "weight": "bold", "wrap": true, "margin": ("lg" if ns.out | length > 1 else "xxl"), "paddingStart": "2px", "color": "#2F80ED"}] -%}
  {%- elif it.k == 'ent' -%}
    {%- set sepd = (it.sec or it.gap) and (ns.out | length > 0) -%}
    {%- if sepd -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
    {%- set col = ({"r": "#B91C1C", "o": "#B45309"}[it.ttone] if it.ttone in ["r", "o"] else ("#111827" if it.sec else "#374151")) -%}
    {%- set sz = "xs" if it.sub else "sm" -%}
    {%- if it.lab and '⟦' in it.val -%}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": [{"type": "span", "text": it.lab ~ "  ", "color": "#6B7280", "size": "xs"}] + (mspans(it.val, '#111827') | from_json([]))} -%}
    {%- elif it.lab -%}
      {%- set txt = {"type": "text", "size": "sm", "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": [{"type": "span", "text": it.lab ~ "  ", "color": "#6B7280", "size": "xs"}, {"type": "span", "text": it.val, "weight": "bold", "size": sz, "color": ({"r": "#DC2626", "o": "#D97706", "g": "#16A34A"}[it.vt] if it.vt else ({"r": "#B91C1C", "o": "#B45309"}[it.ttone] if it.ttone in ["r", "o"] else "#111827"))}]} -%}
    {%- elif '⟦' in it.tb -%}
      {#- V4.2.0：一般句子（沒有圖示）也支援 ⟦o:重點⟧ 顏色標記，其餘一般色 -#}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": (mspans(it.tb, '#111827') | from_json([]))} -%}
    {%- elif it.ca -%}
      {#- 句尾「請注意」：注意符號（無圓圈）接在同一段文字最後，換行時跟著文字走 -#}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if it.icon else "regular"), "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": "⚠︎", "color": "#F2994A", "weight": "bold"}]} -%}
    {%- else -%}
      {%- set txt = {"type": "text", "text": it.tb, "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if (it.icon and not it.lab) else "regular")} -%}
    {%- endif -%}
    {%- set mg = 'md' if sepd else ('xl' if it.gap else ('sm' if it.sub else 'md')) -%}
    {%- set pad = '48px' if it.sub else '28px' -%}
    {%- set ipad = '28px' if it.sub else '2px' -%}
    {%- if it.icon -%}
      {%- set iimg = {"type": "image", "url": b2 ~ it.icon ~ "_" ~ it.tone ~ ".png?v=1", "size": ('14px' if it.sub else '20px'), "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "6px", "alignItems": "flex-start", "margin": mg, "paddingStart": ipad, "contents": [iimg, txt]}] -%}
    {%- else -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": mg, "paddingStart": pad, "contents": [txt]}] -%}
    {%- endif -%}
  {%- else -%}
    {%- set spans = ([{"type": "span", "text": it.old, "color": "#9CA3AF"}, {"type": "span", "text": "   →   ", "color": "#9CA3AF"}] if it.old else []) + [{"type": "span", "text": it.new, "weight": "bold", "color": ("#16A34A" if it.old else "#4B5563")}] -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "xs", "paddingStart": "48px", "contents": [{"type": "text", "size": "xs", "wrap": true, "contents": spans}]}] -%}
  {%- endif -%}
  {%- set ns.last_small = (it.small | default(false)) if it.k == 'note' else false -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# HA 通知（Markdown）：與 LINE 同一份行模型；每個項目之間空一行，版本接在名稱下一行 #}
{% macro md_lines(lines0, base, url='', max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(md=[]) -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set ns.md = ns.md + ['<img src="' ~ (base | replace('/icons/b/', '/icons/b2/')) ~ it.icon ~ '_' ~ it.tone ~ '.png" width="20" height="20" style="vertical-align:middle"> **' ~ body ~ '**' ~ ('<span style="color:#F2994A">⚠︎</span>' if it.ca else '')] -%}
  {%- elif it.k == 'note' -%}
    {%- set ns.md = ns.md + [('  ' if (it.sub and not it.flat) else '') ~ '<sub style="color:#9CA3AF">' ~ mhtml(it.t) ~ '</sub>'] -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.md = ns.md + ['**' ~ it.t ~ '**'] -%}
  {%- elif it.k == 'ent' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set pre = ('<img src="' ~ (base | replace('/icons/b/', '/icons/b2/')) ~ it.icon ~ '_' ~ it.tone ~ '.png" width="18" height="18" style="vertical-align:middle"> ') if it.icon else '' -%}
    {%- set ind = '  ' if it.sub else '' -%}
    {%- set caimg = '<span style="color:#F2994A">⚠︎</span>' if it.ca else '' -%}
    {%- if it.lab and not url -%}
      {%- set vcol = {'r': '#DC2626', 'o': '#D97706', 'g': '#16A34A'}[it.vt] if it.vt else '' -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ it.lab ~ '&nbsp;&nbsp;' ~ (mhtml(it.val) if '⟦' in it.val else (('<span style="color:' ~ vcol ~ '">**' ~ it.val ~ '**</span>') if vcol else ('**' ~ it.val ~ '**')))] -%}
    {%- else -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ body ~ caimg] -%}
    {%- endif -%}
  {%- else -%}
    {%- set v = ('<code>' ~ it.old ~ '</code> → <b><code>' ~ it.new ~ '</code></b>') if it.old else ('<code>' ~ it.new ~ '</code>') -%}
    {%- if ns.md | length > 0 -%}
      {%- set ns.md = ns.md[:-1] + [ns.md[-1] ~ '<br>' ~ v] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.md | join('\n\n') -}}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   災防地區解析輔助：拆分時段、重點三區標籤（竹南紅、苗栗藍、新竹綠）、其他縣市收合
   ────────────────────────────────────────────────────── #}
{% macro parse_alert_region(reg) -%}
  {%- set r0 = reg | regex_replace('[(（][^)）]*[)）]', '') | regex_replace('局部地區$', '') | trim -%}
  {%- set parts = r0.split('、') -%}
  {%- set res_ns = namespace(time_prefix='', targets=[], others=[]) -%}
  {%- for p in parts -%}
    {%- set item = p | trim -%}
    {%- set m_time = item | regex_findall('^(.*(?:上午|下午|晚上|中午|晨|夜))\\s*(.*)$') -%}
    {%- if m_time | length > 0 -%}
      {%- if res_ns.time_prefix == '' -%}
        {%- set res_ns.time_prefix = m_time[0][0] | trim -%}
      {%- endif -%}
      {%- set item = m_time[0][1] | trim -%}
    {%- endif -%}
    {%- if item != '' -%}
      {%- if '竹南' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'zhunan', 'col': '#DC2626', 'bg': '#FEE2E2', 'bd': '#FCA5A5', 'dot': '🔴'}] -%}
      {%- elif '苗栗' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'miaoli', 'col': '#2F80ED', 'bg': '#EFF6FF', 'bd': '#BFDBFE', 'dot': '🔵'}] -%}
      {%- elif '新竹' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'hsinchu', 'col': '#16A34A', 'bg': '#F0FDF4', 'bd': '#BBF7D0', 'dot': '🟢'}] -%}
      {%- else -%}
        {%- set res_ns.others = res_ns.others + [item] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{- {'time': res_ns.time_prefix, 'targets': res_ns.targets, 'others': res_ns.others} | tojson -}}
{%- endmacro %}

{# V4.2.3（SOP-21）：依廣播內容判斷音效類別：只有「疏散／撤離」警告＝evac（CWBEEW，與地震預警同為最緊急的提示音）；
   其餘（颱風、豪雨、燈號、海嘯、土石流…一般災害廣播）回傳 dflt（空字串＝依等級用普通提示音） #}
{% macro broadcast_kind(msg, dflt='') -%}
{%- if (msg | string) | regex_search('疏散|撤離') -%}evac{%- else -%}{{ dflt }}{%- endif -%}
{%- endmacro %}

{# V4.2.2：HA 狀態上限 255 字元。REST 感測器 sensor.disaster_raw 的內文超過就會被改成 unknown（2026-10-23 颱風訊息太長，一直報錯、訊息進不來）。
   超長時濃縮成「只含竹南／苗栗／新竹」的版本（格式與原文相同，下游解析不用改）；255 字內原樣回傳。 #}
{% macro disaster_digest(msg) -%}
{%- set s = (msg | string) | trim -%}
{%- if s | length <= 255 -%}{{- s -}}
{%- else -%}
  {%- set s0 = s | regex_replace('^一、概述[：:]\\s*', '') -%}
  {%- set ns = namespace(segs=[], out='') -%}
  {%- set lead_m = s0 | regex_findall('((?:第[0-9]+號)?颱風及其外圍環流影響)') -%}
  {%- set lead = (lead_m[0] if lead_m | length > 0 else (s0.split('，')[0] | trim)) -%}
  {%- set items = s0 | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- for reg, cond, lamp in items -%}
    {%- set p = parse_alert_region(reg) | from_json -%}
    {%- if p.targets | length > 0 -%}
      {%- set ns.segs = ns.segs + [(p.time if ns.segs | length == 0 else '') ~ (p.targets | map(attribute='name') | join('、')) ~ '局部地區有' ~ (cond | trim) ~ '(' ~ lamp ~ '燈號)'] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ns.segs | length > 0 -%}
    {%- set rain = namespace(l=[]) -%}
    {%- for gp in (free_parse(s0) | from_json).groups if gp.local | length > 0 -%}
      {%- set rain.l = rain.l + [(gp.time if rain.l | length == 0 else '') ~ (gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- set ns.out = lead ~ '，' ~ (ns.segs | join('，')) ~ (('，' ~ (rain.l | join('，'))) if rain.l | length > 0 else '') ~ '，請嚴加防範。' -%}
    {%- if ns.out | length > 255 -%}
      {%- set ns.out = lead ~ '，' ~ (ns.segs | join('，')) ~ '，請嚴加防範。' -%}
    {%- endif -%}
  {%- else -%}
    {%- set fp = free_parse(s0) | from_json -%}
    {%- for gp in fp.groups if gp.local | length > 0 -%}
      {%- set ns.segs = ns.segs + [(gp.time if ns.segs | length == 0 else '') ~ (gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if ns.segs | length > 0 -%}
      {%- set ns.out = ((fp.lead ~ '，') if fp.lead else '') ~ (ns.segs | join('，')) -%}
      {%- for tp in fp.tips -%}
        {%- if (ns.out ~ '，' ~ tp) | length <= 250 -%}{%- set ns.out = ns.out ~ '，' ~ tp -%}{%- endif -%}
      {%- endfor -%}
      {%- set ns.out = ns.out ~ '。' -%}
    {%- endif -%}
  {%- endif -%}
  {%- if ns.out == '' or ns.out | length > 255 -%}
    {%- set cut = s0[:250] -%}
    {%- set k = [cut.rfind('，'), cut.rfind('。')] | max -%}
    {{- (cut[:k + 1] if k > 40 else cut) -}}
  {%- else -%}{{- ns.out -}}{%- endif -%}
{%- endif -%}
{%- endmacro %}

{# V4.2.2：災害訊息「在地內容簽章」：只留下影響竹南／苗栗／新竹的燈號、地區與條件，不看其他縣市與時段文字（NCDR 常常只改其他縣市就再發一版，不該重複通知） #}
{% macro disaster_sig(msg) -%}
{%- set s0 = (msg | string) | trim -%}
{%- set items = s0 | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
{%- set ns = namespace(sig=[]) -%}
{%- for reg, cond, lamp in items -%}
  {%- set p = parse_alert_region(reg) | from_json -%}
  {%- if p.targets | length > 0 -%}
    {%- set ns.sig = ns.sig + [lamp ~ ':' ~ (p.targets | map(attribute='name') | sort | join('/')) ~ ':' ~ (cond | trim)] -%}
  {%- endif -%}
{%- endfor -%}
{%- set fps = namespace(o=[]) -%}
{%- for gp in (free_parse(s0) | from_json).groups if gp.local | length > 0 -%}
  {%- set fps.o = fps.o + [gp.hazard ~ ':' ~ (gp.local | sort | join('/'))] -%}
{%- endfor -%}
{%- if ns.sig | length > 0 or fps.o | length > 0 -%}{{ ((ns.sig + fps.o) | sort | join('|'))[:240] }}{%- else -%}{{ (s0 | regex_replace('\\s+', ''))[:240] }}{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   語音專用：只念苗栗（含竹南）、新竹縣市，保證完整句結尾、絕不硬切斷句
   ────────────────────────────────────────────────────── #}
{% macro disaster_voice(msg) -%}
{%- if msg not in ['', 'unknown', 'unavailable', 'none', 'None', none] -%}
  {%- set s0 = (msg | string) | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
  {%- set parts = s0.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^[一1]、(?:概述)?[:：\\s]*', '') | trim -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- if items | length > 0 -%}
    {%- set b_ns = namespace(blocks=[]) -%}
    {%- for reg, cond, lamp in items -%}
      {%- set h_ns = namespace(hits=[]) -%}
      {%- if '竹南' in reg -%}{%- set h_ns.hits = h_ns.hits + ['竹南'] -%}{%- endif -%}
      {%- if '苗栗' in reg -%}
        {%- if '苗栗縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗縣'] -%}
        {%- elif '苗栗市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗市'] -%}
        {%- elif '竹南' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗'] -%}{%- endif -%}
      {%- endif -%}
      {%- if '新竹市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹市'] -%}{%- endif -%}
      {%- if '新竹縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹縣'] -%}
      {%- elif '新竹' in reg and '新竹市' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹'] -%}{%- endif -%}
      {%- if h_ns.hits | length > 0 -%}
        {%- set b_ns.blocks = b_ns.blocks + [h_ns.hits | join('、') ~ '局部地區為' ~ lamp ~ '燈號，有' ~ (cond | trim)] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set fvl = free_parse(s_main) | from_json -%}
    {%- set rn = namespace(b=[]) -%}
    {%- for gp in fvl.groups if gp.local | length > 0 -%}
      {%- set rn.b = rn.b + [(gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if b_ns.blocks | length > 0 or rn.b | length > 0 -%}
      {{- '氣象署發布：' ~ ((b_ns.blocks + rn.b) | join('；')) ~ '。' -}}
    {%- endif -%}
  {%- else -%}
    {%- set fv = free_parse(s_main) | from_json -%}
    {%- set lg = namespace(b=[], t='') -%}
    {%- for gp in fv.groups if gp.local | length > 0 -%}
      {%- if lg.t == '' and gp.time -%}{%- set lg.t = gp.time -%}{%- endif -%}
      {%- set lg.b = lg.b + [(gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if lg.b | length > 0 -%}
      {%- set vo = namespace(t='氣象署發布：' ~ ((fv.lead ~ '，') if fv.lead else '') ~ ((lg.t ~ '，') if lg.t else '') ~ (lg.b | join('；'))) -%}
      {%- for tp in fv.tips -%}
        {%- if (vo.t ~ '，' ~ tp) | length <= 130 -%}{%- set vo.t = vo.t ~ '，' ~ tp -%}{%- endif -%}
      {%- endfor -%}
      {{- vo.t ~ '。' -}}
    {%- else -%}
    {%- set s_clean = s_main | replace('\r', '') -%}
    {%- set raw_sents = (s_clean | replace('。', '。\n') | replace('；', '；\n')).split('\n') -%}
    {%- set m_ns = namespace(sents=[]) -%}
    {%- for sent in raw_sents -%}
      {%- set st = sent | regex_replace('^[一二三四五六七八九十\\d]+[、.：:]\\s*', '') | regex_replace('[。；;]+$', '') | trim -%}
      {%- if st != '' and (('竹南' in st) or ('苗栗' in st) or ('新竹' in st)) -%}
        {%- set m_ns.sents = m_ns.sents + [st] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if m_ns.sents | length > 0 -%}
      {%- set o_ns = namespace(out='') -%}
      {%- for st in m_ns.sents -%}
        {%- set cand = (o_ns.out ~ ('，' if o_ns.out != '' else '') ~ st) -%}
        {%- if cand | length <= 130 or o_ns.out == '' -%}
          {%- set o_ns.out = cand -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if o_ns.out != '' -%}
        {{- o_ns.out ~ ('。' if not o_ns.out.endswith(('。', '！', '!')) else '') -}}
      {%- endif -%}
    {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   離家戶外摘要專用：解析近 36 小時內影響苗栗／竹南／新竹的災害（颱風、海嘯、豪雨、強風燈號、淹水等）
   回傳 JSON：{"line": 通知項目行, "note": 通知提醒行, "voice": 廣播白話提醒句, "col": "r"|"o"|""}
   ────────────────────────────────────────────────────── #}
{% macro disaster_hint(msg, updated_ts=0) -%}
{%- set ts = updated_ts | float(0) -%}
{%- set fresh = (ts <= 0) or ((now().timestamp() - ts) <= 36 * 3600) -%}
{%- set s_raw = (msg | string) | trim if msg not in ['', 'unknown', 'unavailable', 'none', 'None', none] else '' -%}
{%- set skip = (s_raw == '') or not fresh or (s_raw | regex_search('解除|已無警戒|降至|已降至|演練|演習|模擬')) or ((s_raw | regex_search('地震')) and not (s_raw | regex_search('海嘯'))) -%}
{%- if skip -%}
  {{- {"line": "", "note": "", "voice": "", "col": "", "has_rain": false, "has_wind": false} | tojson -}}
{%- else -%}
  {%- set s0 = s_raw | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
  {%- set parts = s0.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^[一1]、(?:概述)?[:：\\s]*', '') | trim -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- set ns = namespace(short=[], v_items=[], lamps=[], sents=[], by={}, hzs=[]) -%}
  {%- if items | length > 0 -%}
    {%- for reg, cond, lamp in items -%}
      {%- set h_ns = namespace(hits=[]) -%}
      {%- if '竹南' in reg -%}{%- set h_ns.hits = h_ns.hits + ['竹南'] -%}{%- endif -%}
      {%- if '苗栗' in reg -%}
        {%- if '苗栗縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗縣'] -%}
        {%- elif '苗栗市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗市'] -%}
        {%- elif '竹南' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗'] -%}{%- endif -%}
      {%- endif -%}
      {%- if '新竹市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹市'] -%}{%- endif -%}
      {%- if '新竹縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹縣'] -%}
      {%- elif '新竹' in reg and '新竹市' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹'] -%}{%- endif -%}
      {%- if h_ns.hits | length > 0 -%}
        {%- set area = h_ns.hits | join('、') -%}
        {%- set ns.lamps = ns.lamps + [lamp] -%}
        {%- set mw = cond | regex_findall('陣風(\\d+)級') -%}
        {%- if '陣風' in cond or '平均風' in cond -%}
          {%- set hz = '強風' ~ (('・陣風' ~ mw[0] ~ '級以上') if mw | length > 0 else '') -%}
          {%- set vhz = '強風燈號' -%}
        {%- elif '超大豪雨' in cond -%}{%- set hz, vhz = '超大豪雨', '超大豪雨燈號' -%}
        {%- elif '大豪雨' in cond -%}{%- set hz, vhz = '大豪雨', '大豪雨燈號' -%}
        {%- elif '豪雨' in cond -%}{%- set hz, vhz = '豪雨', '豪雨燈號' -%}
        {%- elif '大雨' in cond -%}{%- set hz, vhz = '大雨', '大雨燈號' -%}
        {%- elif '38度' in cond or '36度' in cond or '高溫' in cond -%}{%- set hz, vhz = '高溫', '高溫燈號' -%}
        {%- elif '10度' in cond or '6度' in cond or '低溫' in cond -%}{%- set hz, vhz = '低溫', '低溫燈號' -%}
        {%- else -%}{%- set hz, vhz = (cond | trim), (lamp ~ '燈號') -%}{%- endif -%}
        {%- set ns.short = ns.short + [area ~ lamp ~ '燈號（' ~ hz ~ '）'] -%}
        {%- set ns.by = dict(ns.by, **{lamp: ((ns.by.get(lamp, []) + [area]) | unique | list)}) -%}
        {%- set hz_s = hz.split('・')[0] -%}
        {%- if hz_s not in ns.hzs -%}{%- set ns.hzs = ns.hzs + [hz_s] -%}{%- endif -%}
        {%- set ns.v_items = ns.v_items + [area ~ '為' ~ lamp ~ vhz] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- set s_clean = s_main | replace('\r', '') -%}
    {%- set raw_sents = (s_clean | replace('。', '。\n') | replace('；', '；\n')).split('\n') -%}
    {%- for sent in raw_sents -%}
      {%- set st = sent | regex_replace('^[一二三四五六七八九十\\d]+[、.：:]\\s*', '') | regex_replace('[。；;]+$', '') | trim -%}
      {%- if st != '' and (('竹南' in st) or ('苗栗' in st) or ('新竹' in st) or (st | regex_search('國家級警報|空襲|飛彈'))) -%}
        {%- set ns.sents = ns.sents + [st] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if (ns.short | length == 0) and (ns.sents | length == 0) -%}
    {{- {"line": "", "note": "", "voice": "", "col": "", "has_rain": false, "has_wind": false} | tojson -}}
  {%- else -%}
    {%- if '颱風' in s_main and '東北風' in s_main -%}{%- set cause = '東北風偏強及颱風外圍環流影響' -%}
    {%- elif '颱風外圍環流' in s_main or '外圍環流' in s_main -%}{%- set cause = '颱風外圍環流影響' -%}
    {%- elif '颱風警報' in s_main -%}{%- set cause = '颱風警報發布中' -%}
    {%- elif '颱風' in s_main -%}{%- set cause = '受颱風影響' -%}
    {%- elif '東北風' in s_main or '東北季風' in s_main -%}{%- set cause = '東北季風偏強' -%}
    {%- elif '西南氣流' in s_main or '西南風' in s_main -%}{%- set cause = '西南氣流影響' -%}
    {%- elif '鋒面' in s_main -%}{%- set cause = '受鋒面影響' -%}
    {%- else -%}{%- set cause = '' -%}{%- endif -%}
    {%- set is_red = ('紅色' in ns.lamps) or (s_main | regex_search('海嘯|疏散|撤離|土石流|堰塞|超大豪雨|大豪雨|颱風警報|國家級警報|空襲|飛彈|一級淹水')) -%}
    {%- set col = 'r' if is_red else 'o' -%}
    {%- if '海嘯' in s_main -%}
      {%- set adv = '目前有海嘯警報，沿海與河口可能有危險巨浪，請立即遠離海邊往高處避難' -%}
    {%- elif s_main | regex_search('疏散|撤離|土石流|堰塞') -%}
      {%- set adv = '目前有疏散與土石流警戒，山區與溪邊有危險，請配合指示遠離危險區域' -%}
    {%- elif '颱風警報' in s_main -%}
      {%- set adv = '目前有颱風警報，可能帶來強陣風與豪大雨，外出有危險請多加小心並攜帶雨具' -%}
    {%- elif '颱風' in s_main and (s_main | regex_search('陣風|平均風|強風')) -%}
      {%- set adv = '受颱風外圍環流影響，可能下雨且有強陣風，外出請帶傘並小心騎車與行車安全' -%}
    {%- elif '颱風' in s_main -%}
      {%- set adv = '受颱風影響，天氣不穩定可能下雨或刮強風，外出請帶傘並注意安全' -%}
    {%- elif s_main | regex_search('超大豪雨|大豪雨|豪雨') -%}
      {%- set adv = '目前有豪雨警戒，可能下大雨導致道路積水與視線不佳，請帶雨具並避開低窪路段' -%}
    {%- elif '大雨' in s_main -%}
      {%- set adv = '目前有大雨特報，可能會下大雨，外出請記得帶傘並注意行車視線' -%}
    {%- elif s_main | regex_search('淹水|洩洪|放水|溢流') -%}
      {%- set adv = '目前有淹水或水庫放水警戒，低窪處與溪邊可能有積淹水危險，行車請勿涉水' -%}
    {%- elif s_main | regex_search('陣風|平均風|強風') -%}
      {%- set adv = '目前有強風特報，戶外陣風強勁，騎車與開車請減速握穩，並留意路樹與掉落物' -%}
    {%- elif s_main | regex_search('高溫|36度|38度') -%}
      {%- set adv = '目前有高溫特報，戶外相當炎熱，外出請注意防曬並多補充水分' -%}
    {%- elif s_main | regex_search('低溫|寒流|10度|6度') -%}
      {%- set adv = '目前有低溫特報，氣溫明顯偏低，外出請多加保暖衣物' -%}
    {%- elif s_main | regex_search('停水|暫停供水') -%}
      {%- set adv = '目前有停水通知，請留意家中用水與儲水安排' -%}
    {%- elif '停電' in s_main -%}
      {%- set adv = '目前有停電通知，請留意電器與照明安排' -%}
    {%- else -%}
      {%- set adv = '目前有在地災害告警，外出請多加留意周遭環境安全' -%}
    {%- endif -%}
    {%- if ns.short | length > 0 -%}
      {%- set line_body = (cause ~ '，' if cause else '') ~ (ns.short | join('、')) -%}
      {%- set adv_tail = adv | regex_replace('^受[^，]+影響，', '') | regex_replace('^目前[^，]+，', '') -%}
      {%- set v_out = '災害提醒：' ~ (cause ~ '，' if cause else '') ~ (ns.v_items | join('，')) ~ '，' ~ adv_tail ~ '。' -%}
    {%- else -%}
      {%- set sum_txt = (ns.sents[:2] | join('，')) | regex_replace('[。；;]+', '，') | regex_replace('，$', '') -%}
      {%- set sum_voice = sum_txt | regex_replace('，[^，。]*請[^，。]*$', '') -%}
      {%- set line_body = sum_txt[:80] -%}
      {%- set v_out = '災害提醒：' ~ (sum_voice if sum_voice else sum_txt)[:90] ~ '，' ~ (adv | regex_replace('^目前[^，]+，', '') | regex_replace('^受[^，]+影響，', '')) ~ '。' -%}
    {%- endif -%}
    {#- 通知用短版：原因＋災種為一般色，只有紅／橙色燈號的地區標色；黃色燈號與其他文字一般色 -#}
    {%- if ns.short | length > 0 -%}
      {%- set c_s = '颱風警報' if '颱風警報' in s_main else ('颱風外圍' if '颱風' in s_main else ('東北風' if ('東北風' in s_main or '東北季風' in s_main) else ('西南氣流' if ('西南氣流' in s_main or '西南風' in s_main) else ('鋒面' if '鋒面' in s_main else '')))) -%}
      {%- set hz_t = ns.hzs | join('・') -%}
      {%- set head_t = ((c_s ~ '・') if (c_s and c_s not in hz_t) else '') ~ hz_t -%}
      {#- V4.2.0：獨立一個小段落「氣象告警：」，每個重點一行（原因、各色燈號的地區），縮排顯示；只有紅／橙色燈號的地區標色 -#}
      {%- set pt = namespace(o=['', '氣象告警：']) -%}
      {%- if head_t -%}{%- set pt.o = pt.o + ['原因：' ~ head_t] -%}{%- endif -%}
      {%- for lp in ['紅色', '橙色', '黃色'] -%}
        {%- if ns.by.get(lp) -%}
          {%- set areas = ns.by[lp] | join('、') -%}
          {%- if lp == '黃色' -%}
            {%- set pt.o = pt.o + [lp ~ '燈號：' ~ areas] -%}
          {%- else -%}
            {%- set lc = 'r' if lp == '紅色' else 'o' -%}
            {%- set pt.o = pt.o + [lp ~ '燈號：⟦' ~ lc ~ ':' ~ areas ~ '⟧⟦' ~ lc ~ '⟧'] -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set line_s = pt.o | join('\n') -%}
    {%- else -%}
      {%- set line_s = '\n氣象告警：\n※ ⟦' ~ col ~ ':' ~ line_body[:40] ~ '⟧' -%}
    {%- endif -%}
    {%- set adv_map = {
      '目前有海嘯警報，沿海與河口可能有危險巨浪，請立即遠離海邊往高處避難': '沿海可能有巨浪，⟦C:請立即遠離海邊往高處避難⟧',
      '目前有疏散與土石流警戒，山區與溪邊有危險，請配合指示遠離危險區域': '山區溪邊有危險，⟦C:請配合指示遠離危險區域⟧',
      '目前有颱風警報，可能帶來強陣風與豪大雨，外出有危險請多加小心並攜帶雨具': '可能有強陣風與豪大雨，⟦C:外出請小心並帶雨具⟧',
      '受颱風外圍環流影響，可能下雨且有強陣風，外出請帶傘並小心騎車與行車安全': '可能下雨、有強陣風，外出請⟦C:帶傘、小心行車⟧',
      '受颱風影響，天氣不穩定可能下雨或刮強風，外出請帶傘並注意安全': '天氣不穩，外出請⟦C:帶傘、注意安全⟧',
      '目前有豪雨警戒，可能下大雨導致道路積水與視線不佳，請帶雨具並避開低窪路段': '可能下大雨積水，請⟦C:帶雨具、避開低窪⟧',
      '目前有大雨特報，可能會下大雨，外出請記得帶傘並注意行車視線': '可能下大雨，外出請⟦C:帶傘⟧',
      '目前有淹水或水庫放水警戒，低窪處與溪邊可能有積淹水危險，行車請勿涉水': '低窪溪邊有淹水風險，⟦C:行車勿涉水⟧',
      '目前有強風特報，戶外陣風強勁，騎車與開車請減速握穩，並留意路樹與掉落物': '陣風強勁，⟦C:騎車開車請減速⟧',
      '目前有高溫特報，戶外相當炎熱，外出請注意防曬並多補充水分': '戶外炎熱，⟦C:注意防曬、補充水分⟧',
      '目前有低溫特報，氣溫明顯偏低，外出請多加保暖衣物': '氣溫偏低，⟦C:請加衣保暖⟧',
      '目前有停水通知，請留意家中用水與儲水安排': '⟦C:請留意用水與儲水⟧',
      '目前有停電通知，請留意電器與照明安排': '⟦C:請留意電器與照明⟧'
    } -%}
    {%- set note_s = (adv_map.get(adv, '⟦C:外出請留意周遭安全⟧')) | replace('C:', col ~ ':') -%}
    {{- {
      "line": line_s,
      "note": "※~" ~ note_s,
      "voice": v_out,
      "col": col,
      "has_rain": ('雨' in adv or '傘' in adv),
      "has_wind": ('風' in adv)
    } | tojson -}}
  {%- endif -%}
{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   V4.2.0：地震預警、最新地震報告、氣象與災害告警 專屬現代化卡片排版
   與自動化管理面板（DISASTER_JS / EARTHQUAKE_JS）視覺風格一致：
   - 頂部標題列＋右側動態色膠囊標籤（強震／中強震／有感地震／緊急避難／紅橙黃色燈號／疏散警報）
   - 地震報告：2×2 圓角資訊格（規模、最大震度、發生時間、震央位置）
   - 地震預警：雙欄圓角資訊格（預估震度、預計抵達）＋系統處置框＋避難指引框
   - 氣象災防：自動解析紅／橙／黃色燈號獨立圓角色塊框（在地彩色標籤＋其他縣市收合）＋注意事項框
   - 全欄位啟用 wrap: true 與 flex: 1，適配手機與電腦絕不跑版或超出框格
   ────────────────────────────────────────────────────── #}
{# V4.2.2：自由文字的災害訊息（沒有「局部地區有…燈號」句型，例如土石流警戒、颱風豪雨特報、淹水警戒）：
   ①竹南（紅）、苗栗（藍）、新竹（綠）特別標出；②拆成「警戒種類＋時段＋地區」分組、額外地區行、安全提醒條列，不再是一整段字 #}
{% macro hl_spans(txt, wt='regular') -%}
{%- set ns = namespace(o=[]) -%}
{%- for g, o in (txt | regex_findall('(竹南|苗栗縣|苗栗市|苗栗|新竹縣|新竹市|新竹)|([^竹苗新]+|[竹苗新])')) -%}
  {%- if g -%}
    {%- set c = '#DC2626' if g.startswith('竹南') else ('#2F80ED' if g.startswith('苗栗') else '#16A34A') -%}
    {%- set ns.o = ns.o + [{"type": "span", "text": g, "color": c, "weight": "bold"}] -%}
  {%- elif o -%}
    {%- set ns.o = ns.o + [{"type": "span", "text": o, "color": "#111827", "weight": wt}] -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.o | tojson -}}
{%- endmacro %}
{% macro hl_html(txt) -%}
{%- set ns = namespace(o='') -%}
{%- for g, o in (txt | regex_findall('(竹南|苗栗縣|苗栗市|苗栗|新竹縣|新竹市|新竹)|([^竹苗新]+|[竹苗新])')) -%}
  {%- if g -%}
    {%- set c = '#DC2626' if g.startswith('竹南') else ('#2F80ED' if g.startswith('苗栗') else '#16A34A') -%}
    {%- set ns.o = ns.o ~ '<span style="color:' ~ c ~ '"><b>' ~ g ~ '</b></span>' -%}
  {%- elif o -%}
    {%- set ns.o = ns.o ~ o -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.o -}}
{%- endmacro %}
{% macro free_parse(txt) -%}
{%- set lines = (txt | string).split('\n') | map('trim') | reject('eq', '') | list -%}
{%- set main = lines[0] if lines | length > 0 else '' -%}
{%- set ns = namespace(groups=[], tips=[], lead='', extras=[], lt='') -%}
{%- for ln in lines[1:] -%}
  {%- set m = ln | regex_findall('^([^：:。，]{1,12})[：:]\\s*(.+?)。?$') -%}
  {%- if m | length > 0 -%}{%- set ns.extras = ns.extras + [{'k': m[0][0], 'v': m[0][1]}] -%}{%- endif -%}
{%- endfor -%}
{%- for sent in main.split('。') | map('trim') | reject('eq', '') -%}
  {%- for cl in sent.split('，') | map('trim') | reject('eq', '') -%}
    {%- set gm = cl | regex_findall('^(.*?)有((?:局部)?[^，]*?(?:豪雨|大雨|強風|陣風|低溫|高溫|雷雨|大浪))(?:發生的機率)?$') -%}
    {%- if gm | length > 0 -%}
      {%- set rp = gm[0][0] -%}
      {%- set hz = gm[0][1] -%}
      {%- set tm = rp | regex_findall('^([^宜臺台新桃基苗花南嘉雲彰高屏澎金連竹中]*)(.*)$') -%}
      {%- set tpart = (tm[0][0] | trim) if tm | length > 0 else '' -%}
      {%- set has_t = tpart != '' and (tpart | regex_search('日|晚|上午|下午|凌晨|清晨|今|明')) -%}
      {%- if has_t -%}{%- set ns.lt = tpart -%}{%- endif -%}
      {%- set rpart = tm[0][1] if has_t else rp -%}
      {%- set regs = (rpart | replace('及', '、')).split('、') | map('trim') | reject('eq', '') | list -%}
      {%- set g_ns = namespace(local=[], other=[]) -%}
      {%- for r in regs -%}
        {%- if r | regex_search('竹南|苗栗|新竹') -%}{%- set g_ns.local = g_ns.local + [r] -%}{%- else -%}{%- set g_ns.other = g_ns.other + [r] -%}{%- endif -%}
      {%- endfor -%}
      {%- if '超大豪雨' in hz -%}{%- set sv = ['#DC2626', '#FEF2F2', '#FCA5A5', '🔴'] -%}
      {%- elif '大豪雨' in hz -%}{%- set sv = ['#EA580C', '#FFF7ED', '#FDBA74', '🟠'] -%}
      {%- elif '豪雨' in hz -%}{%- set sv = ['#D97706', '#FFFBEB', '#FCD34D', '🟠'] -%}
      {%- else -%}{%- set sv = ['#CA8A04', '#FEFCE8', '#FDE047', '🟡'] -%}{%- endif -%}
      {%- set ns.groups = ns.groups + [{'time': ns.lt, 'hazard': hz, 'local': g_ns.local, 'other': g_ns.other, 'col': sv[0], 'bg': sv[1], 'bd': sv[2], 'dot': sv[3]}] -%}
    {%- elif ns.lead == '' and ns.groups | length == 0 -%}
      {%- set ns.lead = cl -%}
    {%- else -%}
      {%- set ns.tips = ns.tips + [cl] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{{- {'lead': ns.lead, 'groups': ns.groups, 'tips': ns.tips, 'extras': ns.extras} | tojson -}}
{%- endmacro %}

{# V4.3.10 充電通知專用：資訊格（小標＋大字值）與充電器溫度著色 #}
{% macro ch_tile(label, value, col='#111827', size='sm') -%}
{{ {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "contents": [{"type": "text", "text": label, "size": "xxs", "color": "#6B7280"}, {"type": "text", "text": value, "size": size, "weight": "bold", "color": col, "wrap": true}]} | tojson }}
{%- endmacro %}
{% macro ch_temp_col(v, warn, hot) -%}
{%- set n = (v | regex_findall('-?[0-9.]+') | first | default('', true)) | float(-999) -%}
{{- '#DC2626' if n >= hot else ('#D97706' if n >= warn else ('#16A34A' if n > -999 else '#6B7280')) -}}
{%- endmacro %}
{% macro ch_parse(lines) -%}
{%- set ns = namespace(d={}) -%}
{%- for l in lines[1:] -%}
  {%- set pr = (l | string).split('：', 1) -%}
  {%- if pr | length == 2 and (pr[1] | trim) != '' -%}{%- set ns.d = dict(ns.d, **{(pr[0] | trim): (pr[1] | trim)}) -%}{%- endif -%}
{%- endfor -%}
{{- ns.d | tojson -}}
{%- endmacro %}
{% macro ch_when(t) -%}
{{- (t | string) | regex_replace('^\\d{4}-(\\d{2})-(\\d{2}) (\\d{2}:\\d{2}).*$', '\\1/\\2 \\3') -}}
{%- endmacro %}

{% macro special_body(title, src, lines0, lv='general', b2='https://family.kteam.tw:8126/local/icons/b2/') -%}
{%- set lines = (lines0 | from_json([])) if lines0 is string else (lines0 | list) -%}
{%- set joined = lines | map('string') | join('\n') -%}
{%- set sig = (title | string) ~ ' ' ~ (src | string) ~ ' ' ~ joined -%}
{#- V4.2.2：卡片種類只看標題與來源（sig_h）和嚴格的訊息格式，不看內文裡剛好出現的字（每日更新紀錄的內文會提到地震預警、災害訊息、燈號，原本被誤認成地震預警卡片）；更新紀錄一律不套專用卡片 -#}
{%- set sig_h = (title | string) ~ ' ' ~ (src | string) -%}
{%- set skip = '更新紀錄' in sig_h -%}
{%- set ch_head = (lines[0] | string) if lines | length > 0 else '' -%}
{%- set ch_start = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('開始充電$')) -%}
{%- set ch_done = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('充電完成$')) -%}
{%- if (not skip) and (ch_start or ch_done) -%}
  {%- set kv = ch_parse(lines) | from_json({}) -%}
  {%- set veh = ch_head | regex_replace('\\s*(開始充電|充電完成)$', '') | trim -%}
  {%- set badge, b_col, box_bg, box_bd, val_col, ic = ('充電中', '#2F80ED', '#EFF6FF', '#BFDBFE', '#1D4ED8', 'ev_n') if ch_start else ('充電完成', '#30D158', '#F0FDF4', '#86EFAC', '#16A34A', 'ev_g') -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": ("開始充電" if ch_start else "充電完成"), "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set t_start = ch_when(kv.get('開始時間', kv.get('時間', '--'))) -%}
  {%- set t_end = ch_when(kv.get('結束時間', '--')) -%}
  {%- set vrow = {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('充電車輛', veh, '#111827', 'md') | from_json, dict(ch_tile('開始時間', t_start) | from_json, paddingStart='8px')]} -%}
  {%- if ch_start -%}
    {%- set main_rows = [vrow] -%}
  {%- else -%}
    {%- set main_rows = [
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('用電量', (kv.get('用電量', '--') | regex_replace('\\s*kWh.*$', '')) ~ ' kWh', val_col, 'xl') | from_json, dict(ch_tile('充電用時', kv.get('充電用時', '--') | replace('分鐘', '分'), '#111827', 'md') | from_json, paddingStart='8px')]},
      {"type": "separator", "color": box_bd},
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('充電車輛', veh, '#111827', 'md') | from_json, dict(ch_tile('開始 → 結束', t_start ~ ' → ' ~ t_end) | from_json, paddingStart='8px')]}
    ] -%}
  {%- endif -%}
  {%- set main_box = {"type": "box", "layout": "vertical", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "contents": main_rows} -%}
  {%- set hv = kv.get('手把溫度', kv.get('手把', '--')) -%}
  {%- set mv = kv.get('MCU 溫度', kv.get('MCU溫度', kv.get('MCU', '--'))) -%}
  {%- set pv = kv.get('PCB 溫度', kv.get('PCB溫度', kv.get('PCB', '--'))) -%}
  {%- set temp_box = {"type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "contents": [
      {"type": "text", "text": "充電器溫度", "size": "xxs", "weight": "bold", "color": "#6B7280"},
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [
        ch_tile('手把', hv, ch_temp_col(hv, 42, 50) | trim, 'sm') | from_json,
        ch_tile('MCU', mv, ch_temp_col(mv, 60, 75) | trim, 'sm') | from_json,
        ch_tile('PCB', pv, ch_temp_col(pv, 70, 85) | trim, 'sm') | from_json
      ]}]} -%}
  {{- [hdr_row, main_box, temp_box] | tojson -}}
{%- elif (not skip) and ('地震預警' in sig_h) -%}
  {%- set m_lv = joined | regex_findall('預估(?:地震|震度)[：:\\s]*([^，,\\n級]+)\\s*級') -%}
  {%- set m_sec = joined | regex_findall('([\\d]+|未知)\\s*秒後') -%}
  {%- set lv_raw = (m_lv[0] | trim) if m_lv | length > 0 else states('input_text.line_eew_remote_level') -%}
  {%- set sec_raw = (m_sec[0] | trim) if m_sec | length > 0 else states('input_text.line_eew_remote_seconds') -%}
  {%- set lv_s = lv_raw if (lv_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set sec_s = sec_raw if (sec_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set lv_num = (lv_s | regex_findall('\\d+') | first | default('0', true)) | int(0) -%}
  {%- set lv_disp = lv_s if ('級' in lv_s or '弱' in lv_s or '強' in lv_s or lv_s == '未知') else (lv_s ~ ' 級') -%}
  {%- set sec_disp = sec_s if ('秒' in sec_s or sec_s == '未知') else (sec_s ~ ' 秒後') -%}
  {%- if lv_num >= 4 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '緊急避難', '#FF453A', '#FEF2F2', '#FCA5A5', '#DC2626', 'quake_r' -%}
    {%- set act_ic, act_col, act_t, act_d = 'shield_r', '#DC2626', '已啟動緊急模式與全宅廣播', '預估震度達 4 級以上，系統自動開啟全室照明並關閉危險電源。' -%}
    {%- set guide = '請保持冷靜，立即就地趴下、掩護、穩住並抓住桌腳，保護頭頸部！' -%}
  {%- elif lv_num == 3 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '有感警戒', '#FF9F0A', '#FFF7ED', '#FDBA74', '#EA580C', 'quake_o' -%}
    {%- set act_ic, act_col, act_t, act_d = 'speaker_o', '#D97706', '已啟動全宅語音廣播提醒', '預估震度 3 級，本次啟動語音廣播提醒（未達 4 級緊急模式門檻）。' -%}
    {%- set guide = '請注意搖晃，立即就地趴下、掩護、穩住，保護頭頸部。' -%}
  {%- else -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '輕微有感', '#F59E0B', '#FEFCE8', '#FDE047', '#D97706', 'quake_o' -%}
    {%- set act_ic, act_col, act_t, act_d = 'announce_n', '#4B5563', '僅發送預警通知', '目前未達廣播門檻（3 級）與緊急模式門檻（4 級）。' -%}
    {%- set guide = '' -%}
  {%- endif -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ q_ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "地震預警速報", "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set grid_box = {
    "type": "box", "layout": "horizontal", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "alignItems": "center",
    "contents": [
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
       "contents": [
         {"type": "text", "text": "預估震度", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": lv_disp, "size": "3xl", "weight": "bold", "color": val_col, "wrap": true}
       ]},
      {"type": "separator", "color": box_bd},
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "paddingStart": "8px",
       "contents": [
         {"type": "text", "text": "預計抵達", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": sec_disp, "size": "3xl", "weight": "bold", "color": "#111827", "wrap": true}
       ]}
    ]} -%}
  {%- set act_box = {
    "type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "4px",
    "contents": [
      {"type": "box", "layout": "horizontal", "spacing": "6px", "alignItems": "center",
       "contents": [
         {"type": "image", "url": b2 ~ act_ic ~ ".png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
         {"type": "text", "text": act_t, "size": "xs", "weight": "bold", "color": act_col, "flex": 1, "wrap": true}
       ]},
      {"type": "text", "text": act_d, "size": "xxs", "color": "#4B5563", "wrap": true, "lineSpacing": "3px"}
    ]} -%}
  {%- set guide_box = ([{
    "type": "box", "layout": "horizontal", "backgroundColor": "#FEF2F2", "borderColor": "#FCA5A5", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "flex-start",
    "contents": [
      {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": guide, "size": "xs", "weight": "bold", "color": "#B91C1C", "flex": 1, "wrap": true, "lineSpacing": "3px"}
    ]}] if guide else []) -%}
  {%- set m_ep = joined | regex_findall('預估震央[：:]\\s*([^\\n]+)') -%}
  {%- set ep_box = ([{
    "type": "box", "layout": "horizontal", "backgroundColor": "#EFF6FF", "borderColor": "#BFDBFE", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "center",
    "contents": [
      {"type": "text", "text": "預估震央", "size": "xs", "color": "#6B7280", "flex": 0},
      {"type": "text", "text": (m_ep[0] | trim), "size": "sm", "weight": "bold", "color": "#1E3A8A", "flex": 1, "wrap": true}
    ]}] if m_ep | length > 0 else []) -%}
  {{- ([hdr_row, grid_box] + ep_box + [act_box] + guide_box) | tojson -}}
{%- elif (not skip) and ('緊急模式啟動' in (title | string) or '緊急模式仍在啟動' in (title | string)) -%}
  {#- V4.2.3：緊急模式專用卡片（05B）：狀態、觸發來源、請確認、還原方式四塊，取代原本 4 個泡泡的長文字 -#}
  {%- set m_src = joined | regex_findall('觸發來源[：:]\\s*([^\\n]+)') -%}
  {%- set src_t = (m_src[0] | trim) if m_src | length > 0 else '系統判定' -%}
  {%- set again = '仍在啟動' in (title | string) -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "22px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": ("緊急模式仍在啟動" if again else "緊急模式已啟動"), "weight": "bold", "size": "lg", "color": "#B91C1C", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": "#DC2626", "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": ("已超過 5 分鐘" if again else "緊急"), "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set grid_box = {
    "type": "box", "layout": "horizontal", "backgroundColor": "#FEF2F2", "borderColor": "#FCA5A5", "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "alignItems": "center",
    "contents": [
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
       "contents": [
         {"type": "text", "text": "照明", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": "全部開啟", "size": "xl", "weight": "bold", "color": "#DC2626"}
       ]},
      {"type": "separator", "color": "#FCA5A5"},
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "paddingStart": "8px",
       "contents": [
         {"type": "text", "text": "電源", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": "已關閉", "size": "xl", "weight": "bold", "color": "#111827"}
       ]}
    ]} -%}
  {%- set src_main = (src_t | regex_replace('[（(].*$', '') | trim) or src_t -%}
  {%- set src_sub = (src_t | regex_findall('[（(]([^）)]+)[）)]') | first | default('', true)) -%}
  {%- set src_row = {
    "type": "box", "layout": "vertical", "margin": "md", "spacing": "2px",
    "contents": [
      {"type": "text", "text": "觸發來源", "size": "xxs", "color": "#6B7280"},
      {"type": "text", "text": src_main, "size": "md", "weight": "bold", "color": "#111827", "wrap": true}
    ] + ([{"type": "text", "text": src_sub, "size": "xs", "color": "#6B7280", "wrap": true}] if src_sub else [])} -%}
  {%- set guide_box = {
    "type": "box", "layout": "horizontal", "backgroundColor": "#FEF3C7", "borderColor": "#FCD34D", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "12px", "margin": "md", "spacing": "10px", "alignItems": "center",
    "contents": [
      {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
       "contents": [
         {"type": "text", "text": "請確認現場狀況", "size": "md", "weight": "bold", "color": "#92400E"},
         {"type": "text", "text": "是真實的緊急情況，還是誤觸", "size": "xs", "color": "#B45309", "wrap": true}
       ]}
    ]} -%}
  {%- set rec_box = {
    "type": "box", "layout": "vertical", "backgroundColor": "#EFF6FF", "borderColor": "#BFDBFE", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "12px", "margin": "sm", "spacing": "8px",
    "contents": [
      {"type": "text", "text": "如何還原", "size": "xs", "weight": "bold", "color": "#1E3A8A"},
      {"type": "box", "layout": "vertical", "backgroundColor": "#FFFFFF", "borderColor": "#2563EB", "borderWidth": "2px", "cornerRadius": "8px", "paddingAll": "12px", "spacing": "6px",
       "contents": [
         {"type": "text", "text": "①  打開「家庭」App", "size": "sm", "color": "#1F2937"},
         {"type": "text", "text": "②  滑到最下方", "size": "sm", "color": "#1F2937"},
         {"type": "text", "text": "③  點「解除網關警報」", "size": "md", "weight": "bold", "color": "#1D4ED8"},
         {"type": "separator", "margin": "sm", "color": "#DBEAFE"},
         {"type": "text", "text": "還原到緊急模式前的狀態（2 小時內）", "size": "xs", "color": "#4B5563", "wrap": true}
       ]},
      {"type": "text", "text": "也可以在家庭 App 直接調整電源與照明，或執行離家模式", "size": "xs", "color": "#6B7280", "wrap": true, "lineSpacing": "3px"}
    ]} -%}
  {{- [hdr_row, grid_box, src_row, guide_box, rec_box] | tojson -}}
{%- elif (not skip) and (('地震報告' in sig_h) or ('01地震' in sig_h) or ('02地震' in sig_h) or (joined | regex_search('^\\s*(?:[^\\n]{0,40}中央氣象(?:局|署)訊息[：:]\\s*)?\\d{1,2}/\\d{1,2}\\s*\\d{1,2}:\\d{2}[^\\n]*發生規模'))) -%}
  {%- set eq_ns = namespace(s='') -%}
  {%- for l in lines -%}
    {%- set lt = (l | string) | trim -%}
    {%- if '發生規模' in lt -%}
      {%- set eq_ns.s = lt | regex_replace('^.*收到以下中央氣象(?:局|署)訊息[:：]\\s*', '') | trim -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set raw_eq = eq_ns.s if eq_ns.s else ((joined | trim) if (joined | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else (states('sensor.earthquake') | trim)) -%}
  {%- set s = raw_eq if raw_eq not in ['', 'unknown', 'unavailable', 'none', 'None'] else '' -%}
  {%- set mm = s | regex_findall('^(\\d{1,2}/\\d{1,2})\\s*(\\d{1,2}:\\d{2})\\s*(.*?)發生規模\\s*([\\d.]+)\\s*(?:有感|小區域)?地震[，,]?\\s*(.*?)。?$') -%}
  {%- set mag = (mm[0][3] | float(-1)) if mm | length > 0 else -1 -%}
  {%- if mag >= 6 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '強震', '#FF453A', '#FEF2F2', '#FCA5A5', '#DC2626', 'quake_r' -%}
  {%- elif mag >= 5 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '中強震', '#FF9F0A', '#FFF7ED', '#FDBA74', '#EA580C', 'quake_o' -%}
  {%- elif mag >= 4 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '有感地震', '#F59E0B', '#FEFCE8', '#FDE047', '#D97706', 'quake_o' -%}
  {%- elif mag >= 0 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '小區域地震', '#30D158', '#F0FDF4', '#86EFAC', '#16A34A', 'quake_g' -%}
  {%- else -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '地震速報', ('#FF453A' if lv == 'emergency' else '#FF9F0A'), '#F3F4F6', '#E5E7EB', '#DC2626', 'quake_r' -%}
  {%- endif -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ q_ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "最新地震報告", "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- if mm | length > 0 -%}
    {%- set m0 = mm[0] -%}
    {%- set intens_raw = m0[4] | regex_replace('^最大震度', '') | trim -%}
    {%- set im = intens_raw | regex_findall('^(.*?)(\\d+\\s*[弱強]?\\s*級?)$') -%}
    {%- set place = (im[0][0] | trim) if im | length > 0 else intens_raw -%}
    {%- set ilv = (im[0][1] | replace(' ', '')) if im | length > 0 else '' -%}
    {%- set ilv_disp = (ilv ~ ('級' if ilv and '級' not in ilv else '')) -%}
    {%- set intens_disp = ((place ~ ' ' if place else '') ~ ilv_disp) | trim -%}
    {%- set main_box = {
      "type": "box", "layout": "vertical", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md",
      "contents": [
        {"type": "box", "layout": "horizontal", "spacing": "md",
         "contents": [
           {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
            "contents": [
              {"type": "text", "text": "規模", "size": "xxs", "color": "#6B7280"},
              {"type": "text", "text": "M " ~ m0[3], "size": "xl", "weight": "bold", "color": val_col, "wrap": true}
            ]},
           {"type": "separator", "color": box_bd},
           {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "paddingStart": "8px",
            "contents": [
              {"type": "text", "text": "最大震度", "size": "xxs", "color": "#6B7280"},
              {"type": "text", "text": (intens_disp if intens_disp else "--"), "size": "md", "weight": "bold", "color": "#111827", "wrap": true}
            ]}
         ]},
        {"type": "separator", "color": box_bd},
        {"type": "box", "layout": "horizontal", "spacing": "md",
         "contents": [
           {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
            "contents": [
              {"type": "text", "text": "發生時間", "size": "xxs", "color": "#6B7280"},
              {"type": "text", "text": m0[0] ~ " " ~ m0[1], "size": "sm", "weight": "bold", "color": "#111827", "wrap": true}
            ]},
           {"type": "separator", "color": box_bd},
           {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "paddingStart": "8px",
            "contents": [
              {"type": "text", "text": "震央位置", "size": "xxs", "color": "#6B7280"},
              {"type": "text", "text": (m0[2] | trim if m0[2] | trim else "--"), "size": "sm", "weight": "bold", "color": "#111827", "wrap": true}
            ]}
         ]}
      ]} -%}
  {%- else -%}
    {%- set main_box = {
      "type": "box", "layout": "vertical", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md",
      "contents": [{"type": "text", "text": (s if s else "目前沒有地震速報資料。"), "size": "sm", "color": "#111827", "wrap": true, "lineSpacing": "4px"}]} -%}
  {%- endif -%}
  {%- set need_note = ('請保持冷靜' in joined) or (lv == 'emergency') or (mag >= 5) -%}
  {%- set note_box = ([{
    "type": "box", "layout": "horizontal", "backgroundColor": "#FEF2F2", "borderColor": "#FCA5A5", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "flex-start",
    "contents": [
      {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "發生地震，請保持冷靜，立即就地趴下、掩護、穩住並抓住桌腳，保護頭頸部。", "size": "xs", "weight": "bold", "color": "#B91C1C", "flex": 1, "wrap": true, "lineSpacing": "3px"}
    ]}] if need_note else []) -%}
  {{- ([hdr_row, main_box] + note_box) | tojson -}}
{%- elif (not skip) and (('天氣告知' in sig_h) or ('災防報告' in sig_h) or ('災害訊息' in sig_h) or ('疏散' in sig_h) or (joined | regex_search('局部地區有[^()（）\\n]*[(（](紅色|橙色|黃色)燈號[)）]'))) -%}
  {%- set d_ns = namespace(o=[]) -%}
  {%- for l in lines -%}
    {%- set cl = (l | string) | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
    {%- if cl != '' -%}{%- set d_ns.o = d_ns.o + [cl] -%}{%- endif -%}
  {%- endfor -%}
  {%- set raw_dis = (d_ns.o | join('\n')) if d_ns.o | length > 0 else (states('sensor.disaster') | trim) -%}
  {%- set s = raw_dis if raw_dis not in ['', 'unknown', 'unavailable', 'none', 'None'] else '' -%}
  {%- set parts = s.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^一、概述[：:]\\s*', '') | trim -%}
  {%- set s_note = (parts[1] | regex_replace('^[(（]警戒[)）]事項[：:\\s]*', '') | regex_replace('^事項[：:\\s]*', '') | trim) if parts | length > 1 else '' -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- set lamps = {
    '紅色': {'col': '#DC2626', 'pill': '#FF453A', 'bg': '#FEF2F2', 'bd': '#FCA5A5', 'dot': '🔴'},
    '橙色': {'col': '#EA580C', 'pill': '#FF9F0A', 'bg': '#FFF7ED', 'bd': '#FDBA74', 'dot': '🟠'},
    '黃色': {'col': '#CA8A04', 'pill': '#F59E0B', 'bg': '#FEFCE8', 'bd': '#FDE047', 'dot': '🟡'}
  } -%}
  {%- if '疏散' in sig or '撤離' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '緊急疏散避難警報', '疏散警報', '#FF453A', '#FEF2F2', '#FCA5A5', 'alarm_r' -%}
  {%- elif '海嘯' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '海嘯警報', '海嘯警報', '#FF453A', '#FEF2F2', '#FCA5A5', 'alarm_r' -%}
  {%- elif '土石流' in s or '堰塞' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '淹水災害警戒', '淹水警戒', '#FF453A', '#FEF2F2', '#FCA5A5', 'drop_o' -%}
  {%- elif '紅色' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '紅色燈號', '#FF453A', '#FEF2F2', '#FCA5A5', 'weather_r' -%}
  {%- elif '橙色' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '橙色燈號', '#FF9F0A', '#FFF7ED', '#FDBA74', 'weather_o' -%}
  {%- elif '黃色' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '黃色燈號', '#F59E0B', '#FEFCE8', '#FDE047', 'weather_o' -%}
  {%- elif '颱風' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '颱風警報', '#FF9F0A', '#FFF7ED', '#FDBA74', 'weather_o' -%}
  {%- elif '豪雨' in s or '大雨' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '豪雨特報', '#FF9F0A', '#FFF7ED', '#FDBA74', 'drop_o' -%}
  {%- elif '淹水' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '淹水災害警戒', '淹水警戒', '#FF9F0A', '#FFF7ED', '#FDBA74', 'drop_o' -%}
  {%- elif '洩洪' in s or '放水' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '水庫放水警戒', '水庫放水', '#FF9F0A', '#FFF7ED', '#FDBA74', 'drop_o' -%}
  {%- elif '停水' in s or '停電' in s -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '民生停供通知', '民生停供', '#FF9F0A', '#FFF7ED', '#FDBA74', 'tool_o' -%}
  {%- else -%}
    {%- set card_t, badge, b_col, box_bg, box_bd, w_ic = '氣象與災害告警', '災防通知', ('#FF453A' if lv == 'emergency' else '#FF9F0A'), ('#FEF2F2' if lv == 'emergency' else '#FFF7ED'), ('#FCA5A5' if lv == 'emergency' else '#FDBA74'), ('alarm_r' if lv == 'emergency' else 'weather_o') -%}
  {%- endif -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ w_ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": card_t, "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set b_ns = namespace(boxes=[hdr_row]) -%}
  {%- if items | length > 0 -%}
    {%- set lead = s_main.split('，')[0] | trim -%}
    {%- if lead -%}
      {%- set b_ns.boxes = b_ns.boxes + [{"type": "text", "text": lead, "size": "sm", "weight": "bold", "color": "#111827", "wrap": true, "margin": "sm", "lineSpacing": "3px"}] -%}
    {%- endif -%}
    {%- for reg, cond, lamp in items if (parse_alert_region(reg) | from_json).targets | length > 0 -%}
      {%- set lc = lamps.get(lamp, lamps['黃色']) -%}
      {%- set parsed = parse_alert_region(reg) | from_json -%}
      {%- set b_contents = [
        {"type": "text", "text": lc.dot ~ " " ~ lamp ~ "燈號", "size": "xs", "weight": "bold", "color": lc.col}
      ] + ([
        {"type": "text", "text": "⏱️ " ~ parsed.time, "size": "xxs", "color": "#6B7280", "wrap": true, "margin": "md"}
      ] if parsed.time else []) -%}
      {%- if parsed.targets | length > 0 -%}
        {%- set t_ns = namespace(tag_boxes=[]) -%}
        {%- for t in parsed.targets -%}
          {%- set t_ns.tag_boxes = t_ns.tag_boxes + [{
            "type": "box", "layout": "vertical", "backgroundColor": t.bg, "borderColor": t.bd, "borderWidth": "1px", "cornerRadius": "6px", "paddingTop": "2px", "paddingBottom": "2px", "paddingStart": "8px", "paddingEnd": "8px", "flex": 0,
            "contents": [{"type": "text", "text": t.name, "size": "xs", "weight": "bold", "color": t.col}]
          }] -%}
        {%- endfor -%}
        {%- set b_contents = b_contents + [
          {"type": "box", "layout": "horizontal", "spacing": "6px", "margin": "md", "contents": t_ns.tag_boxes},
          {"type": "text", "text": "有" ~ (cond | trim), "size": "xs", "color": "#111827", "wrap": true, "lineSpacing": "3px", "margin": "md"}
        ] -%}
        {%- if parsed.others | length > 0 -%}
          {%- set b_contents = b_contents + [
            {"type": "text", "text": "其他縣市：" ~ (parsed.others | join('、')), "size": "xxs", "color": "#9CA3AF", "wrap": true, "margin": "md"}
          ] -%}
        {%- endif -%}
      {%- else -%}
        {%- set b_contents = b_contents + [
          {"type": "text", "text": "有" ~ (cond | trim), "size": "xxs", "color": "#4B5563", "wrap": true, "margin": "md"},
          {"type": "text", "text": "涵蓋：" ~ (parsed.others | join('、')), "size": "xxs", "color": "#9CA3AF", "wrap": true, "margin": "md"}
        ] -%}
      {%- endif -%}
      {%- set b_ns.boxes = b_ns.boxes + [{
        "type": "box", "layout": "vertical", "backgroundColor": lc.bg, "borderColor": lc.bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "14px", "margin": "md", "spacing": "6px",
        "contents": b_contents}] -%}
    {%- endfor -%}
    {#- V4.2.2：燈號與降雨同時在一則訊息（颱風公報）時，降雨警戒的本地部分也要顯示 -#}
    {%- set pcol2 = {'竹南': ['#DC2626', '#FEE2E2', '#FCA5A5'], '苗栗': ['#2F80ED', '#EFF6FF', '#BFDBFE'], '新竹': ['#16A34A', '#F0FDF4', '#BBF7D0']} -%}
    {%- set fpl = free_parse(s_main) | from_json -%}
    {%- for gp in fpl.groups if gp.local | length > 0 -%}
      {%- if loop.first -%}
        {%- set b_ns.boxes = b_ns.boxes + [{"type": "text", "text": "降雨警戒", "size": "xxs", "weight": "bold", "color": "#6B7280", "margin": "lg"}] -%}
      {%- endif -%}
      {%- set rc = [{"type": "text", "text": gp.dot ~ " " ~ gp.hazard, "size": "xs", "weight": "bold", "color": gp.col, "wrap": true}] + ([{"type": "text", "text": "⏱️ " ~ gp.time, "size": "xxs", "color": "#6B7280", "wrap": true, "margin": "md"}] if gp.time else []) -%}
      {%- set rp_ns = namespace(b=[]) -%}
      {%- for r in gp.local -%}
        {%- set k = '竹南' if '竹南' in r else ('苗栗' if '苗栗' in r else '新竹') -%}
        {%- set rp_ns.b = rp_ns.b + [{"type": "box", "layout": "vertical", "backgroundColor": pcol2[k][1], "borderColor": pcol2[k][2], "borderWidth": "1px", "cornerRadius": "6px", "paddingTop": "2px", "paddingBottom": "2px", "paddingStart": "8px", "paddingEnd": "8px", "flex": 0, "contents": [{"type": "text", "text": r, "size": "xs", "weight": "bold", "color": pcol2[k][0]}]}] -%}
      {%- endfor -%}
      {%- set rc = rc + [{"type": "box", "layout": "horizontal", "spacing": "6px", "margin": "md", "contents": rp_ns.b}] -%}
      {%- set b_ns.boxes = b_ns.boxes + [{"type": "box", "layout": "vertical", "backgroundColor": gp.bg, "borderColor": gp.bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "14px", "margin": "md", "spacing": "6px", "contents": rc}] -%}
    {%- endfor -%}
  {%- else -%}
    {%- set pcol = {'竹南': ['#DC2626', '#FEE2E2', '#FCA5A5'], '苗栗': ['#2F80ED', '#EFF6FF', '#BFDBFE'], '新竹': ['#16A34A', '#F0FDF4', '#BBF7D0']} -%}
    {%- set loc = namespace(tags=[]) -%}
    {%- if '竹南' in s_main -%}{%- set loc.tags = loc.tags + [['竹南', '竹南']] -%}{%- endif -%}
    {%- if '苗栗' in s_main -%}{%- set loc.tags = loc.tags + [['苗栗縣', '苗栗']] -%}{%- endif -%}
    {%- if '新竹' in s_main -%}{%- set loc.tags = loc.tags + [['新竹縣市', '新竹']] -%}{%- endif -%}
    {%- if loc.tags | length > 0 -%}
      {%- set tg_ns = namespace(b=[{"type": "text", "text": "本地影響", "size": "xxs", "color": "#6B7280", "flex": 0}]) -%}
      {%- for t in loc.tags -%}
        {%- set tg_ns.b = tg_ns.b + [{"type": "box", "layout": "vertical", "backgroundColor": pcol[t[1]][1], "borderColor": pcol[t[1]][2], "borderWidth": "1px", "cornerRadius": "6px", "paddingTop": "2px", "paddingBottom": "2px", "paddingStart": "8px", "paddingEnd": "8px", "flex": 0, "contents": [{"type": "text", "text": t[0], "size": "xs", "weight": "bold", "color": pcol[t[1]][0]}]}] -%}
      {%- endfor -%}
      {%- set b_ns.boxes = b_ns.boxes + [{"type": "box", "layout": "horizontal", "spacing": "6px", "margin": "sm", "alignItems": "center", "contents": tg_ns.b}] -%}
    {%- else -%}
      {%- set b_ns.boxes = b_ns.boxes + [{"type": "text", "text": "本則訊息未提到竹南、苗栗、新竹", "size": "xxs", "color": "#9CA3AF", "margin": "sm", "wrap": true}] -%}
    {%- endif -%}
    {%- set fp = free_parse(s_main) | from_json -%}
    {%- if fp.groups | length > 0 -%}
      {%- if fp.lead -%}
        {%- set b_ns.boxes = b_ns.boxes + [{"type": "text", "text": fp.lead, "size": "sm", "weight": "bold", "color": "#111827", "wrap": true, "margin": "sm", "lineSpacing": "3px"}] -%}
      {%- endif -%}
      {%- for gp in fp.groups if gp.local | length > 0 -%}
        {%- set gc = [{"type": "text", "text": gp.dot ~ " " ~ gp.hazard, "size": "xs", "weight": "bold", "color": gp.col, "wrap": true}] + ([{"type": "text", "text": "⏱️ " ~ gp.time, "size": "xxs", "color": "#6B7280", "wrap": true, "margin": "xs"}] if gp.time else []) -%}
        {%- if gp.local | length > 0 -%}
          {%- set lp_ns = namespace(b=[]) -%}
          {%- for r in gp.local -%}
            {%- set k = '竹南' if '竹南' in r else ('苗栗' if '苗栗' in r else '新竹') -%}
            {%- set lp_ns.b = lp_ns.b + [{"type": "box", "layout": "vertical", "backgroundColor": pcol[k][1], "borderColor": pcol[k][2], "borderWidth": "1px", "cornerRadius": "6px", "paddingTop": "2px", "paddingBottom": "2px", "paddingStart": "8px", "paddingEnd": "8px", "flex": 0, "contents": [{"type": "text", "text": r, "size": "xs", "weight": "bold", "color": pcol[k][0]}]}] -%}
          {%- endfor -%}
          {%- set gc = gc + [{"type": "box", "layout": "horizontal", "spacing": "6px", "margin": "xs", "contents": lp_ns.b}] -%}
        {%- endif -%}
        {%- set b_ns.boxes = b_ns.boxes + [{"type": "box", "layout": "vertical", "backgroundColor": gp.bg, "borderColor": gp.bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "10px", "margin": "sm", "spacing": "4px", "contents": gc}] -%}
      {%- endfor -%}
      {%- set ex_cnt = namespace(n=0) -%}
      {%- for ex in fp.extras if ex.v | regex_search('竹南|苗栗|新竹') -%}{%- set ex_cnt.n = ex_cnt.n + 1 -%}{%- endfor -%}
      {%- if ex_cnt.n > 0 -%}
        {%- set ex_ns = namespace(b=[]) -%}
        {%- for ex in fp.extras if ex.v | regex_search('竹南|苗栗|新竹') -%}
          {%- set ex_ns.b = ex_ns.b + [{"type": "text", "size": "xs", "wrap": true, "lineSpacing": "3px", "contents": [{"type": "span", "text": ex.k ~ "　", "color": "#6B7280", "size": "xxs"}] + (hl_spans(ex.v, 'bold') | from_json([]))}] -%}
        {%- endfor -%}
        {%- set b_ns.boxes = b_ns.boxes + [{"type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "4px", "contents": ex_ns.b}] -%}
      {%- endif -%}
      {%- if fp.tips | length > 0 -%}
        {%- set tp_ns = namespace(b=[{"type": "text", "text": "安全提醒", "size": "xxs", "weight": "bold", "color": "#6B7280"}]) -%}
        {%- for tp in fp.tips -%}
          {%- set tp_ns.b = tp_ns.b + [{"type": "text", "text": "• " ~ tp, "size": "xs", "color": "#374151", "wrap": true, "lineSpacing": "3px"}] -%}
        {%- endfor -%}
        {%- set b_ns.boxes = b_ns.boxes + [{"type": "box", "layout": "vertical", "backgroundColor": "#F9FAFB", "borderColor": "#E5E7EB", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "3px", "contents": tp_ns.b}] -%}
      {%- endif -%}
    {%- else -%}
    {%- set p_ns = namespace(ps=[]) -%}
    {%- for p in s_main.split('\n') if p | trim != '' -%}
      {%- set p_ns.ps = p_ns.ps + [{"type": "text", "size": "xs", "wrap": true, "lineSpacing": "4px", "contents": (hl_spans(p | trim, ('bold' if p_ns.ps | length == 0 else 'regular')) | from_json([]))}] -%}
    {%- endfor -%}
    {%- if p_ns.ps | length == 0 -%}
      {%- set p_ns.ps = [{"type": "text", "text": "目前沒有任何災害防護告警訊息。", "size": "xs", "color": "#111827", "wrap": true}] -%}
    {%- endif -%}
    {%- set b_ns.boxes = b_ns.boxes + [{
      "type": "box", "layout": "vertical", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "sm",
      "contents": p_ns.ps}] -%}
    {%- endif -%}
  {%- endif -%}
  {%- if s_note -%}
    {%- set b_ns.boxes = b_ns.boxes + [{
      "type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "4px",
      "contents": [
        {"type": "text", "text": "注意（警戒）事項", "size": "xxs", "weight": "bold", "color": "#6B7280"},
        {"type": "text", "text": s_note, "size": "xxs", "color": "#4B5563", "wrap": true, "lineSpacing": "3px"}
      ]}] -%}
  {%- endif -%}
  {%- if '疏散' in sig or '撤離' in s -%}
    {%- set b_ns.boxes = b_ns.boxes + [{
      "type": "box", "layout": "horizontal", "backgroundColor": "#FEF2F2", "borderColor": "#FCA5A5", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "flex-start",
      "contents": [
        {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
        {"type": "text", "text": "已觸發緊急疏散警報，請立即留意政府廣播與周遭環境，迅速配合疏散避難！", "size": "xs", "weight": "bold", "color": "#B91C1C", "flex": 1, "wrap": true, "lineSpacing": "3px"}
      ]}] -%}
  {%- endif -%}
  {{- b_ns.boxes | tojson -}}
{%- endif -%}
{%- endmacro %}

{# HA 通知同步結構化排版（地震預警／最新地震報告／氣象與災害告警） #}
{% macro special_md(title, src, lines0, lv='general', base='/local/icons/b/') -%}
{%- set b2 = base | replace('/icons/b/', '/icons/b2/') -%}
{%- set lines = (lines0 | from_json([])) if lines0 is string else (lines0 | list) -%}
{%- set joined = lines | map('string') | join('\n') -%}
{%- set sig = (title | string) ~ ' ' ~ (src | string) ~ ' ' ~ joined -%}
{#- V4.2.2：卡片種類只看標題與來源（sig_h）和嚴格的訊息格式，不看內文裡剛好出現的字（每日更新紀錄的內文會提到地震預警、災害訊息、燈號，原本被誤認成地震預警卡片）；更新紀錄一律不套專用卡片 -#}
{%- set sig_h = (title | string) ~ ' ' ~ (src | string) -%}
{%- set skip = '更新紀錄' in sig_h -%}
{%- set ch_head = (lines[0] | string) if lines | length > 0 else '' -%}
{%- set ch_start = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('開始充電$')) -%}
{%- set ch_done = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('充電完成$')) -%}
{%- if (not skip) and (ch_start or ch_done) -%}
  {%- set kv = ch_parse(lines) | from_json({}) -%}
  {%- set veh = ch_head | regex_replace('\\s*(開始充電|充電完成)$', '') | trim -%}
  {%- set hv = kv.get('手把溫度', kv.get('手把', '--')) -%}
  {%- set mv = kv.get('MCU 溫度', kv.get('MCU溫度', kv.get('MCU', '--'))) -%}
  {%- set pv = kv.get('PCB 溫度', kv.get('PCB溫度', kv.get('PCB', '--'))) -%}
  {%- set col = '#2F80ED' if ch_start else '#16A34A' -%}
  {%- set parts = ['<img src="' ~ b2 ~ ('ev_n' if ch_start else 'ev_g') ~ '.png" width="20" height="20" style="vertical-align:middle"> **' ~ ('開始充電' if ch_start else '充電完成') ~ '**　<span style="color:' ~ col ~ '"><b>【' ~ ('充電中' if ch_start else '充電完成') ~ '】</b></span>'] -%}
  {%- if ch_start -%}
    {%- set parts = parts + ['充電車輛　**' ~ veh ~ '**<br>開始時間　**' ~ ch_when(kv.get('開始時間', kv.get('時間', '--'))) ~ '**'] -%}
  {%- else -%}
    {%- set parts = parts + ['用電量　<span style="color:' ~ col ~ '"><b>' ~ (kv.get('用電量', '--') | regex_replace('\\s*kWh.*$', '')) ~ ' kWh</b></span>　充電用時　**' ~ (kv.get('充電用時', '--') | replace('分鐘', '分')) ~ '**<br>充電車輛　**' ~ veh ~ '**<br>' ~ ch_when(kv.get('開始時間', '--')) ~ ' → ' ~ ch_when(kv.get('結束時間', '--'))] -%}
  {%- endif -%}
  {%- set parts = parts + ['<sub>充電器溫度　手把 ' ~ hv ~ '　MCU ' ~ mv ~ '　PCB ' ~ pv ~ '</sub>'] -%}
  {{- parts | join('\n\n') -}}
{%- elif (not skip) and ('地震預警' in sig_h) -%}
  {%- set m_lv = joined | regex_findall('預估(?:地震|震度)[：:\\s]*([^，,\\n級]+)\\s*級') -%}
  {%- set m_sec = joined | regex_findall('([\\d]+|未知)\\s*秒後') -%}
  {%- set lv_raw = (m_lv[0] | trim) if m_lv | length > 0 else states('input_text.line_eew_remote_level') -%}
  {%- set sec_raw = (m_sec[0] | trim) if m_sec | length > 0 else states('input_text.line_eew_remote_seconds') -%}
  {%- set lv_s = lv_raw if (lv_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set sec_s = sec_raw if (sec_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set lv_num = (lv_s | regex_findall('\\d+') | first | default('0', true)) | int(0) -%}
  {%- set lv_disp = lv_s if ('級' in lv_s or '弱' in lv_s or '強' in lv_s or lv_s == '未知') else (lv_s ~ ' 級') -%}
  {%- set sec_disp = sec_s if ('秒' in sec_s or sec_s == '未知') else (sec_s ~ ' 秒後') -%}
  {%- set col = '#DC2626' if lv_num >= 4 else ('#EA580C' if lv_num == 3 else '#D97706') -%}
  {%- set badge = '緊急避難' if lv_num >= 4 else ('有感警戒' if lv_num == 3 else '輕微有感') -%}
  {%- set act_t = '已啟動緊急模式與全宅廣播' if lv_num >= 4 else ('已啟動全宅語音廣播提醒' if lv_num == 3 else '僅發送預警通知（未達廣播與緊急模式門檻）') -%}
  {%- set out = [
    '<img src="' ~ b2 ~ ('quake_r' if lv_num >= 4 else 'quake_o') ~ '.png" width="20" height="20" style="vertical-align:middle"> **地震預警速報**　<span style="color:' ~ col ~ '"><b>【' ~ badge ~ '】</b></span>',
    '- <img src="' ~ b2 ~ 'quake_r.png" width="18" height="18" style="vertical-align:middle"> 預估震度&nbsp;&nbsp;<span style="color:' ~ col ~ '">**' ~ lv_disp ~ '**</span>',
    '- <img src="' ~ b2 ~ 'hourglass_o.png" width="18" height="18" style="vertical-align:middle"> 預計抵達&nbsp;&nbsp;**' ~ sec_disp ~ '**',
    '- 系統處置&nbsp;&nbsp;**' ~ act_t ~ '**'
  ] + (['- <img src="' ~ b2 ~ 'alarm_r.png" width="18" height="18" style="vertical-align:middle"> <span style="color:#DC2626">**請保持冷靜，立即就地趴下、掩護、穩住並抓住桌腳，保護頭頸部！**</span>'] if lv_num >= 3 else []) -%}
  {{- out | join('\n\n') -}}
{%- elif (not skip) and ('緊急模式啟動' in (title | string) or '緊急模式仍在啟動' in (title | string)) -%}
  {%- set m_src = joined | regex_findall('觸發來源[：:]\\s*([^\\n]+)') -%}
  {%- set src_t = (m_src[0] | trim) if m_src | length > 0 else '系統判定' -%}
  {%- set again = '仍在啟動' in (title | string) -%}
  {%- set out = [
    '<img src="' ~ b2 ~ 'alarm_r.png" width="20" height="20" style="vertical-align:middle"> **' ~ ('緊急模式仍在啟動' if again else '緊急模式已啟動') ~ '**',
    '- 照明&nbsp;&nbsp;**全部開啟**　電源&nbsp;&nbsp;**已關閉**',
    '- 觸發來源&nbsp;&nbsp;**' ~ src_t ~ '**',
    '- <span style="color:#B45309">**請確認現場是否為真實緊急情況**</span>',
    '- <span style="color:#1D4ED8">**還原：打開「家庭」App，滑到最下方，點「解除網關警報」**</span>（還原到緊急模式前的狀態，2 小時內）；或直接調整電源與照明、執行離家模式'
  ] -%}
  {{- out | join('\n') -}}
{%- elif (not skip) and (('地震報告' in sig_h) or ('01地震' in sig_h) or ('02地震' in sig_h) or (joined | regex_search('^\\s*(?:[^\\n]{0,40}中央氣象(?:局|署)訊息[：:]\\s*)?\\d{1,2}/\\d{1,2}\\s*\\d{1,2}:\\d{2}[^\\n]*發生規模'))) -%}
  {%- set eq_ns = namespace(s='') -%}
  {%- for l in lines -%}
    {%- set lt = (l | string) | trim -%}
    {%- if '發生規模' in lt -%}
      {%- set eq_ns.s = lt | regex_replace('^.*收到以下中央氣象(?:局|署)訊息[:：]\\s*', '') | trim -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set raw_eq = eq_ns.s if eq_ns.s else ((joined | trim) if (joined | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else (states('sensor.earthquake') | trim)) -%}
  {%- set s = raw_eq if raw_eq not in ['', 'unknown', 'unavailable', 'none', 'None'] else '' -%}
  {%- set mm = s | regex_findall('^(\\d{1,2}/\\d{1,2})\\s*(\\d{1,2}:\\d{2})\\s*(.*?)發生規模\\s*([\\d.]+)\\s*(?:有感|小區域)?地震[，,]?\\s*(.*?)。?$') -%}
  {%- if mm | length > 0 -%}
    {%- set m0 = mm[0] -%}
    {%- set mag = m0[3] | float(0) -%}
    {%- set badge = '強震' if mag >= 6 else ('中強震' if mag >= 5 else ('有感地震' if mag >= 4 else '小區域地震')) -%}
    {%- set col = '#DC2626' if mag >= 6 else ('#EA580C' if mag >= 5 else ('#D97706' if mag >= 4 else '#16A34A')) -%}
    {%- set intens_raw = m0[4] | regex_replace('^最大震度', '') | trim -%}
    {%- set out = [
      '<img src="' ~ b2 ~ ('quake_r' if mag >= 6 else ('quake_o' if mag >= 4 else 'quake_g')) ~ '.png" width="20" height="20" style="vertical-align:middle"> **最新地震報告**　<span style="color:' ~ col ~ '"><b>【' ~ badge ~ '】</b></span>',
      '- 規模&nbsp;&nbsp;<span style="color:' ~ col ~ '">**M ' ~ m0[3] ~ '**</span>',
      '- 最大震度&nbsp;&nbsp;**' ~ (intens_raw if intens_raw else '--') ~ '**',
      '- 發生時間&nbsp;&nbsp;**' ~ m0[0] ~ ' ' ~ m0[1] ~ '**',
      '- 震央位置&nbsp;&nbsp;**' ~ (m0[2] | trim) ~ '**'
    ] + (['- <img src="' ~ b2 ~ 'alarm_r.png" width="18" height="18" style="vertical-align:middle"> <span style="color:#DC2626">**發生地震，請保持冷靜，立即就地趴下、掩護、穩住並抓住桌腳，保護頭頸部。**</span>'] if (('請保持冷靜' in joined) or lv == 'emergency' or mag >= 5) else []) -%}
    {{- out | join('\n\n') -}}
  {%- endif -%}
{%- elif (not skip) and (('天氣告知' in sig_h) or ('災防報告' in sig_h) or ('災害訊息' in sig_h) or ('疏散' in sig_h) or (joined | regex_search('局部地區有[^()（）\\n]*[(（](紅色|橙色|黃色)燈號[)）]'))) -%}
  {%- set d_ns = namespace(o=[]) -%}
  {%- for l in lines -%}
    {%- set cl = (l | string) | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
    {%- if cl != '' -%}{%- set d_ns.o = d_ns.o + [cl] -%}{%- endif -%}
  {%- endfor -%}
  {%- set raw_dis = (d_ns.o | join('\n')) if d_ns.o | length > 0 else (states('sensor.disaster') | trim) -%}
  {%- set s = raw_dis if raw_dis not in ['', 'unknown', 'unavailable', 'none', 'None'] else '' -%}
  {%- set parts = s.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^一、概述[：:]\\s*', '') | trim -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- if items | length > 0 -%}
    {%- set lead = s_main.split('，')[0] | trim -%}
    {%- set l_ns = namespace(md=['<img src="' ~ b2 ~ 'weather_o.png" width="20" height="20" style="vertical-align:middle"> **氣象與災害告警**' ~ (' — ' ~ lead if lead else '')]) -%}
    {%- for reg, cond, lamp in items if (parse_alert_region(reg) | from_json).targets | length > 0 -%}
      {%- set col = '#DC2626' if lamp == '紅色' else ('#EA580C' if lamp == '橙色' else '#CA8A04') -%}
      {%- set dot = '🔴' if lamp == '紅色' else ('🟠' if lamp == '橙色' else '🟡') -%}
      {%- set parsed = parse_alert_region(reg) | from_json -%}
      {%- if parsed.targets | length > 0 -%}
        {%- set t_ns = namespace(spans=[]) -%}
        {%- for t in parsed.targets -%}
          {%- set t_ns.spans = t_ns.spans + ['<span style="color:' ~ t.col ~ '">**' ~ t.dot ~ ' ' ~ t.name ~ '**</span>'] -%}
        {%- endfor -%}
        {%- set l_ns.md = l_ns.md + ['- ' ~ dot ~ ' <span style="color:' ~ col ~ '">**' ~ lamp ~ '燈號**</span>' ~ ((' ⏱️ ' ~ parsed.time) if parsed.time else '') ~ '：' ~ (t_ns.spans | join(' ')) ~ '<br>有' ~ (cond | trim) ~ (('<br><sub style="color:#9CA3AF">其他：' ~ (parsed.others | join('、')) ~ '</sub>') if parsed.others | length > 0 else '')] -%}
      {%- else -%}
        {%- set l_ns.md = l_ns.md + ['- ' ~ dot ~ ' <span style="color:' ~ col ~ '">**' ~ lamp ~ '燈號**</span>（其他地區）：<sub style="color:#9CA3AF">' ~ (parsed.others | join('、')) ~ '</sub>'] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set fpl = free_parse(s_main) | from_json -%}
    {%- for gp in fpl.groups if gp.local | length > 0 -%}
      {%- set l_ns.md = l_ns.md + ['- ' ~ gp.dot ~ ' <span style="color:' ~ gp.col ~ '">**' ~ gp.hazard ~ '**</span>' ~ ((' ⏱️ ' ~ gp.time) if gp.time else '') ~ '<br>' ~ hl_html(gp.local | join('、'))] -%}
    {%- endfor -%}
    {{- l_ns.md | join('\n\n') -}}
  {%- elif s_main != '' -%}
    {%- set card_t = '緊急疏散避難警報' if ('疏散' in sig or '撤離' in s) else ('海嘯警報' if '海嘯' in s else ('淹水災害警戒' if ('土石流' in s or '堰塞' in s) else '氣象與災害告警')) -%}
    {%- set loc_md = [] -%}
    {%- if '竹南' in s_main -%}{%- set loc_md = loc_md + ['<span style="color:#DC2626"><b>🔴 竹南</b></span>'] -%}{%- endif -%}
    {%- if '苗栗' in s_main -%}{%- set loc_md = loc_md + ['<span style="color:#2F80ED"><b>🔵 苗栗縣</b></span>'] -%}{%- endif -%}
    {%- if '新竹' in s_main -%}{%- set loc_md = loc_md + ['<span style="color:#16A34A"><b>🟢 新竹縣市</b></span>'] -%}{%- endif -%}
    {%- set head = '<img src="' ~ b2 ~ 'weather_o.png" width="20" height="20" style="vertical-align:middle"> **' ~ card_t ~ '**' -%}
    {%- set loc_line = ('本地影響：' ~ (loc_md | join(' '))) if loc_md | length > 0 else '<sub style="color:#9CA3AF">本則訊息未提到竹南、苗栗、新竹</sub>' -%}
    {%- set fp = free_parse(s_main) | from_json -%}
    {%- set mp = namespace(p=[head, loc_line]) -%}
    {%- if fp.groups | length > 0 -%}
      {%- if fp.lead -%}{%- set mp.p = mp.p + ['**' ~ fp.lead ~ '**'] -%}{%- endif -%}
      {%- for gp in fp.groups if gp.local | length > 0 -%}
        {%- set mp.p = mp.p + ['- ' ~ gp.dot ~ ' <span style="color:' ~ gp.col ~ '">**' ~ gp.hazard ~ '**</span>' ~ ((' ⏱️ ' ~ gp.time) if gp.time else '') ~ ((('<br>' ~ hl_html(gp.local | join('、'))) if gp.local | length > 0 else '')) ] -%}
      {%- endfor -%}
      {%- for ex in fp.extras if ex.v | regex_search('竹南|苗栗|新竹') -%}{%- set mp.p = mp.p + ['<sub>' ~ ex.k ~ '　' ~ hl_html(ex.v) ~ '</sub>'] -%}{%- endfor -%}
      {%- if fp.tips | length > 0 -%}{%- set mp.p = mp.p + ['**安全提醒**<br>' ~ (fp.tips | map('regex_replace', '^', '• ') | join('<br>'))] -%}{%- endif -%}
    {%- else -%}
      {%- set mp.p = mp.p + [hl_html(s_main | replace('\n', '<br>'))] -%}
    {%- endif -%}
    {{- mp.p | join('\n\n') -}}
  {%- endif -%}
{%- endif -%}
{%- endmacro %}
