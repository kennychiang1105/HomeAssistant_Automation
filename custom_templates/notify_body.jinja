{# ──────────────────────────────────────────────────────
   通知內文排版 (V4.1.6)：LINE Flex 與 HA 通知共用同一份「行模型」，版面一致。
   - V4.3.15（2026-11-06）：第三批專屬卡片：二樓門鎖虛掩、鐵門連線不穩、05A 緊急模式（舊版）、伺服器維護預告、通知測試（資訊／一般／重要／緊急）、手動通知（依重要性上色）。
   - V4.3.14（2026-11-06）：版面不換行：充電完成改「用電量（大字＋小單位）／充電用時／車輛／開始／結束」各自一格；自動離家標題改短、細節放膠囊；門鎖款式獨立一行（原廠 / 原廠 → 原廠）；戶外狀況拆成天氣／最高溫／降雨機率／紫外線／空氣品質。
   - V4.3.13（2026-11-06）：第二批專屬卡片：五樓保全、離家保全、疑似入侵、門鎖電量分級／換電池、網關情境衝突、充電器異常、大門門鈴、電風扇連線異常、LINE Bot 額度、濾芯／耗材電量、空氣品質、一氧化碳、環境異常讀數、情境檢查、鐵門重試未關、地震詳情；自動離家補「網關未切到離家」與鐵門／門鎖英文狀態中文化；修正「仍未開始充電」被當成開始充電卡片。
   - V4.3.12（2026-11-06）：新增專屬卡片：自動離家（綠／紅）、鐵門未關（紅）、鐵門自動關門結果（提前關閉／已自動關閉／已取消）；共用零件 cd_hdr／cd_box／cd_row／cd_gray／cd_note／cd_pair。
   - V4.1.6：圖示只放在「小標題（冒號結尾）」「名稱：數值」與「警告」行（標題行不放，保持單行）；圖示顏色依重要度（紅=緊急、橘=警告、綠=正常完成、藍=一般），共 70 款（www/icons/b2/<名稱>_<n|g|o|r>.png）（警告、異常、未關、未上鎖、離線、不穩…），一般項目不放圖示以免干擾閱讀；
             「名稱：數值」拆成灰色小字名稱＋粗體數值（例如 客廳門鎖電量　76%）；一般句子用正常粗細。
   - V4.1.0（已被上一行取代）：每一個項目行都有圖示。
   - 「名稱：舊版 → 新版」與「名稱：V1.2.3」一律拆成兩行：名稱一行、版本獨立一行（舊版灰色、新版綠色粗體）。
   - 每個項目之間空一行（margin）；【小標題】獨立成行、藍色粗體；第一行是通知重點（粗體、較大）。
   用法：{% from 'notify_body.jinja' import flex_rows, md_lines %}
   圖示檔：/local/icons/b/<name>.png（96px）。新增圖示或關鍵字時修改本檔後執行 homeassistant.reload_custom_templates。
   ────────────────────────────────────────────────────── #}
{% macro pick(t) -%}
{%- if t | regex_search('門鈴') -%}doorbell
{%- elif t | regex_search('電量|電池|耗材|濾網') -%}battery
{%- elif t | regex_search('離家|外出|出門') -%}homeout
{%- elif t | regex_search('到家|回家|返家') -%}homein
{%- elif t | regex_search('解鎖|開鎖|已開鎖') -%}unlock
{%- elif t | regex_search('指紋|密碼|鑰匙|卡片') -%}key
{%- elif t | regex_search('門鎖|上鎖|已鎖|未鎖') -%}lock
{%- elif t | regex_search('鐵門|車庫') and t | regex_search('開啟|打開|未關|沒關|開著') -%}gateopen
{%- elif t | regex_search('鐵門|車庫') -%}gate
{%- elif t | regex_search('天數|日期|星期|今天|明天|本週|週報') -%}calendar
{%- elif t | regex_search('預估|倒數|分鐘|等待|秒後|逾時|剩餘') -%}hourglass
{%- elif t | regex_search('\d{1,2}:\d{2}|時間|時刻') -%}clock
{%- elif t | regex_search('溫度|°C|體感') -%}thermo
{%- elif t | regex_search('冷氣|空調|暖氣') -%}ac
{%- elif t | regex_search('濕度') -%}humid
{%- elif t | regex_search('降雨|豪雨|下雨|水位|洩洪|漏水') -%}drop
{%- elif t | regex_search('PM2|PM1|空氣|清淨機|CO2|二氧化碳|一氧化碳|揮發|VOC|甲醛|懸浮微粒') -%}air
{%- elif t | regex_search('風扇|風速') -%}fan
{%- elif t | regex_search('Tesla|充電|充電樁') -%}ev
{%- elif t | regex_search('電壓|電流|功率|用電|耗電|插座') -%}plug
{%- elif t | regex_search('車牌|車輛|汽車|車子') -%}car
{%- elif t | regex_search('影片|錄影') -%}video
{%- elif t | regex_search('攝影|影像|截圖|監視') -%}camera
{%- elif t | regex_search('地震|震度|規模') -%}quake
{%- elif t | regex_search('颱風|氣象|天氣|豪雨') -%}weather
{%- elif t | regex_search('紫外線|UV|日出|日落|白天|早安') -%}sun
{%- elif t | regex_search('晚安|夜間|深夜') -%}moon
{%- elif t | regex_search('熟睡|睡眠|睡') -%}bed
{%- elif t | regex_search('闖入|入侵') -%}shieldoff
{%- elif t | regex_search('警戒|布防|撤防') -%}shieldlock
{%- elif t | regex_search('保全|防區') -%}shield
{%- elif t | regex_search('警報') -%}alarm
{%- elif t | regex_search('路由|AP|Wi-Fi|WiFi') -%}router
{%- elif t | regex_search('伺服器|主機|NAS') -%}server
{%- elif t | regex_search('網路|網關|連線|離線|斷線') -%}network
{%- elif t | regex_search('麥克風') -%}mic
{%- elif t | regex_search('廣播|喇叭|語音|HomePod') -%}speaker
{%- elif t | regex_search('電視') -%}tv
{%- elif t | regex_search('燈') -%}bulb
{%- elif t | regex_search('感應|移動|偵測|動作') -%}motion
{%- elif t | regex_search('家人|人員|所有人|成員') -%}people
{%- elif t | regex_search('在家|有人|人物') -%}person
{%- elif t | regex_search('樓梯') -%}stairs
{%- elif t | regex_search('客廳') -%}sofa
{%- elif t | regex_search('臥室|房間') -%}bed
{%- elif t | regex_search('廁所|浴室') -%}toilet
{%- elif t | regex_search('廚房') -%}kitchen
{%- elif t | regex_search('大門|房門|門(?!檻)') -%}door
{%- elif t | regex_search('手機|平板|iPhone|iPad') -%}phone
{%- elif t | regex_search('位置|地點|座標') -%}pin
{%- elif t | regex_search('次數|數量|統計|計數') -%}counter
{%- elif t | regex_search('款式|型號|名稱|版本') -%}tag
{%- elif t | regex_search('更新') -%}update
{%- elif t | regex_search('重置|重啟|重新|重試') -%}refresh
{%- elif t | regex_search('關機|開機|電源') -%}power
{%- elif t | regex_search('公告|提醒|宣告') -%}announce
{%- elif t | regex_search('通知|訊息|LINE') -%}mail
{%- elif t | regex_search('Bot|對話') -%}chat
{%- elif t | regex_search('維修|維護|保養') -%}tool
{%- elif t | regex_search('設定|參數|模式|情境|系統') -%}gear
{%- elif t | regex_search('失敗|異常|錯誤') -%}bug
{%- elif t | regex_search('已完成|成功|正常') -%}check
{%- endif -%}
{%- endmacro %}

{# 重要度配色：r 紅（緊急）／o 橘（警告）／g 綠（正常完成）／n 藍（一般資訊） #}
{% macro tone(t) -%}
{%- if t | regex_search('緊急|入侵|闖入|警報|地震|火災|一氧化碳|嚴重') -%}r
{%- elif t | regex_search('注意|警告|異常|失敗|未完成|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠') -%}o
{%- elif t | regex_search('已完成|完成|完畢|成功|正常|已關閉|已上鎖|皆已|已恢復|已啟動|已執行|已開啟|已提前|已關') -%}g
{%- else -%}n
{%- endif -%}
{%- endmacro %}

{# V4.1.6：過長的句子在「，」靠近中間處斷行（LINE 自動換行會留下孤字，例如「請注／意。」）#}
{% macro balance(t, lim) -%}
{%- if (t | length) <= lim or '，' not in t -%}{{ t }}
{%- else -%}
  {%- set parts = t.split('，') -%}
  {%- set ns = namespace(lines=[], cur='') -%}
  {%- for p in parts -%}
    {%- set piece = p ~ ('，' if not loop.last else '') -%}
    {%- if ns.cur != '' and ((ns.cur | length) + (piece | length)) > lim -%}
      {%- set ns.lines = ns.lines + [ns.cur] -%}{%- set ns.cur = piece -%}
    {%- else -%}
      {%- set ns.cur = ns.cur ~ piece -%}
    {%- endif -%}
  {%- endfor -%}
  {{- (ns.lines + [ns.cur]) | join('\n') -}}
{%- endif -%}
{%- endmacro %}

{# V4.1.6：行內顏色標記 ⟦g:文字⟧（綠）⟦o:…⟧（黃）⟦r:…⟧（紅）⟦n:…⟧（灰）→ LINE span 清單（JSON） #}
{% macro mspans(txt, dflt='#111827') -%}
{%- set cmap = {'g': '#16A34A', 'o': '#D97706', 'r': '#DC2626', 'n': '#9CA3AF'} -%}
{%- set ns = namespace(o=[]) -%}
{%- for c, t1, t2 in (txt | regex_findall('⟦([rogn]):([^⟧]*)⟧|([^⟦]+)')) -%}
  {%- if c and t1 -%}{%- set ns.o = ns.o + [{"type": "span", "text": t1, "color": cmap[c], "weight": "bold"}] -%}
  {%- elif t2 -%}{%- set ns.o = ns.o + [{"type": "span", "text": t2, "color": dflt}] -%}{%- endif -%}
{%- endfor -%}
{{- ns.o | tojson -}}
{%- endmacro %}
{# 同一套標記 → HA 通知（HTML） #}
{% macro mhtml(txt) -%}
{{- txt | regex_replace('⟦g:([^⟧]*)⟧', '<span style="color:#16A34A"><b>\\1</b></span>') | regex_replace('⟦o:([^⟧]*)⟧', '<span style="color:#D97706"><b>\\1</b></span>')
       | regex_replace('⟦r:([^⟧]*)⟧', '<span style="color:#DC2626"><b>\\1</b></span>') | regex_replace('⟦n:([^⟧]*)⟧', '<span style="color:#9CA3AF">\\1</span>') -}}
{%- endmacro %}

{# V4.1.6：空氣品質讀數的燈號（綠 g／黃 o／紅 r），回傳 ⟦g⟧ 這種行尾標記；標記會被排版吃掉、並把該行數值與圖示染成對應顏色 #}
{% macro env_tag(kind, v) -%}
{%- set x = v | float(0) -%}
{%- if kind == 'co2' -%}{{ '⟦g⟧' if x < 1000 else ('⟦o⟧' if x < 2000 else '⟦r⟧') }}
{%- elif kind == 'pm' -%}{{ '⟦g⟧' if x <= 15 else ('⟦o⟧' if x <= 35 else '⟦r⟧') }}
{%- elif kind == 'pm10' -%}{{ '⟦g⟧' if x <= 54 else ('⟦o⟧' if x <= 125 else '⟦r⟧') }}
{%- elif kind == 'pm1' -%}{{ '⟦g⟧' if x <= 15 else ('⟦o⟧' if x <= 35 else '⟦r⟧') }}
{%- elif kind == 'tvoc' -%}{{ '⟦g⟧' if x <= 220 else ('⟦o⟧' if x <= 600 else '⟦r⟧') }}
{%- elif kind == 'co' -%}{{ '⟦g⟧' if x < 9 else ('⟦o⟧' if x < 35 else '⟦r⟧') }}
{%- elif kind == 'ch2o' -%}{{ '⟦g⟧' if x <= 0.05 else ('⟦o⟧' if x <= 0.08 else '⟦r⟧') }}
{%- elif kind == 'temp' -%}{{ '⟦g⟧' if (15 <= x <= 30) else ('⟦o⟧' if (10 <= x < 15 or 30 < x < 40) else '⟦r⟧') }}
{%- elif kind == 'hum' -%}{{ '⟦g⟧' if (40 <= x <= 60) else ('⟦o⟧' if (30 <= x < 40 or 60 < x <= 70) else '⟦r⟧') }}
{%- endif -%}
{%- endmacro %}

{# V4.1.6：句尾的「請注意」拆出來，後面加注意圖示。回傳 JSON [前段, 請注意] ；沒有就回 ["",""] #}
{% macro ca_split(t) -%}
{%- set m = t | regex_findall('^(.*?)\\s*(請注意[。.]?)$') -%}
{%- if m | length > 0 and (m[0][0] == '' or m[0][0][-1:] in ['，', ',']) -%}{{ [m[0][0], m[0][1]] | tojson }}{%- else -%}["", ""]{%- endif -%}
{%- endmacro %}

{# V4.1.6：需要注意的行才放圖示 #}
{% macro is_warn(t) -%}
{%- if t | regex_search('注意|警告|異常|失敗|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠|‼|❗|入侵|闖入|緊急') -%}1{%- endif -%}
{%- endmacro %}

{# 去掉行首的項目符號與 emoji（圖示取代它們） #}
{% macro noemoji(t) -%}
{{- (t | trim) | regex_replace('[🌀-🫿☀-➿⬀-⯿️‼❗❓]\uFE0F?', '') | regex_replace('^[，,、\s]+', '') | regex_replace('[，,、]+(?=。|$)', '') | regex_replace('\s{2,}', ' ') | trim -}}
{%- endmacro %}
{% macro untag(t) -%}
{{- (t | trim) | regex_replace('^[\[【][^\]】]{1,8}[\]】]\s*(?=\S)', '') -}}
{%- endmacro %}
{% macro clean(t) -%}
{{- noemoji(untag((t | trim) | regex_replace('^[\s•·\-\*]+', ''))) -}}
{%- endmacro %}
{% macro bullet(t) -%}
{{- noemoji(untag((t | trim) | regex_replace('^[•·\-\*]+\s*', ''))) -}}
{%- endmacro %}

{# 前處理：①每句（以「。」結尾）自成一行；②版本行拆成「名稱」＋「@@V@@舊@@新」兩行；網址行不拆 #}
{% macro prep(lines) -%}
{%- set arrow_re = '^(.+?)[：:]\s*(.*?\d.*?)\s*(?:→|->|➜)\s*(.+?)\s*$' -%}
{%- set one_re = '^(.+?)[：:]\s*((?:[Vv]\d|\d+\.\d+\.\d+|\d+(?:\.\d+)?\s*[（(]上次).*)$' -%}
{%- set ver_hint = '[Vv]\d|\d+\.\d+\.\d+|[Bb]eta' -%}
{%- set ns = namespace(out=[]) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.out = ns.out + [''] -%}
  {%- elif t | regex_search('https?://') -%}
    {%- set ns.out = ns.out + [t] -%}
  {%- elif t | regex_search('→|->|➜') and t | regex_search(ver_hint) and (t | regex_findall(arrow_re) | length) > 0 -%}
    {%- set m = (t | regex_findall(arrow_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@' ~ (m[1] | trim) ~ '@@' ~ (m[2] | trim)] -%}
  {%- elif (t | regex_findall(one_re) | length) > 0 and not (t | regex_search('。')) -%}
    {%- set m = (t | regex_findall(one_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@@@' ~ (m[1] | trim)] -%}
  {%- else -%}
    {%- for part in (t | regex_replace('。\s*', '。\n')).split('\n') -%}
      {%- if part | trim != '' -%}{%- set ns.out = ns.out + [part | trim] -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# 行模型：JSON 清單，每個元素 {k: hdr|sec|ent|ver, t, icon, old, new, gap} #}
{% macro model(lines0) -%}
{%- set lines = prep(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], first=true, sect='', gap=false, insec=false, base='n', hi=0) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.gap = true -%}
  {%- elif ns.first -%}
    {%- set hb = bullet(t) -%}
    {%- set ns.base = tone(hb) | trim -%}
    {%- set hc = ca_split(hb) | from_json(['', '']) -%}
    {%- set hcat = 'bell' if (hb | regex_search('通知$|通知。$')) else (pick(hb) | trim) -%}
    {%- set hbal = (hb | replace('，', '，\n')) if (hb.count('，') >= 2 and not hb.endswith('，')) else balance(hb, 15 - (2 if hc[1] else 0)) -%}
    {%- set hn = (hbal.split('\n') | map('length') | max) + (2 if hc[1] else 0) -%}
    {%- set ns.out = ns.out + [{'k': 'hdr', 't': hb, 'tb': hbal, 'ca': hc[1], 'pre': '', 'cain': false, 'icon': (hcat if hcat else 'announce'), 'tone': tone(hb) | trim, 'hsz': ([16, (246 / ([hn, 1] | max)) | int] | min)}] -%}
    {%- set ns.first = false -%}
  {%- elif t.startswith('@@V@@') -%}
    {%- set p = t[5:].split('@@') -%}
    {%- set ns.out = ns.out + [{'k': 'ver', 'old': p[0], 'new': p[1] if p | length > 1 else ''}] -%}
  {%- elif t.startswith('※') -%}
    {%- set flat = t.startswith('※※') -%}
    {#- V4.2.0 新格式：除了不縮排的圖例說明（※※），所有 ※ 備註／提醒都是小字、縮排對齊上一列圖示、上方有橫線；舊的 ※~ 寫法仍相容 -#}
    {%- set small = not flat -%}
    {%- set ns.out = ns.out + [{'k': 'note', 't': (t[2:] if (flat or t.startswith('※~')) else t[1:]) | trim, 'sub': ns.insec and not flat, 'flat': flat, 'small': small, 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- elif t | regex_search('^[【\[].+[】\]]$') -%}
    {%- set ns.sect = t -%}
    {%- set ns.out = ns.out + [{'k': 'sec', 't': t}] -%}
    {%- set ns.gap = false -%}
  {%- else -%}
    {%- set tgm = t | regex_findall('⟦([rog])⟧\\s*$') -%}
    {%- set tg = tgm[0] if tgm | length > 0 else '' -%}
    {%- set c = clean(t) | regex_replace('\\s*⟦[rog]⟧\\s*$', '') | trim -%}
    {%- set body = c if c else t -%}
    {%- set warn = is_warn(t) | trim == '1' -%}
    {#- V4.1.6：沒有冒號但是「名稱 數值」的舊式行（例如「開始時間 2026-10-15 23:59」「目前狀態 charging」）也當成名稱／數值行 -#}
    {%- set lv1 = (body | regex_findall('^([^：:。，,\s]{1,12})[：:]\s*(.+)$')) if not (body | regex_search('https?://')) else [] -%}
    {%- set lv2 = (body | regex_findall('^([^\s：:。，,]{0,6}(?:時間|溫度|狀態|車輛|用時|用電量|電量|天數|數量|名稱|型號|款式|位置|模式|情境|金額|次數|版本|狀況|濕度|濃度|數值|剩餘|容量|功率|電壓|電流))\s+([^。，,]{1,40})$')) if (lv1 | length == 0 and not (body | regex_search('https?://'))) else [] -%}
    {%- set lv = lv1 if lv1 | length > 0 else lv2 -%}
    {%- set is_sec = body | regex_search('^[^。]{1,16}[：:]$') -%}
    {#- V4.1.6：圖示只給「小標題行（以冒號結尾）」「名稱：數值」與「警告」行；一般句子不放圖示；顏色依重要度 -#}
    {%- set cat = pick(body) | trim -%}
    {%- set icon = (cat if cat else 'alarm') if warn else ((cat if cat else 'list') if is_sec else ((cat if cat else 'tag') if lv | length > 0 else '')) -%}
    {%- if ns.gap and not is_sec -%}{%- set ns.insec = false -%}{%- endif -%}
    {%- set sub = ns.insec and not is_sec and not warn -%}
    {%- if is_sec -%}{%- set ns.insec = true -%}{%- endif -%}
    {%- set ec = (ca_split(body) | from_json(['', ''])) if (lv | length == 0) else ['', ''] -%}
    {%- set lim = (20 if sub else 15) - (2 if ec[1] else 0) -%}
    {#- V4.1.6：同一則圖示顏色以標題為主；挑最多 2 個重點「名稱：數值」行（用電量、電量、預估、用時、狀態…）換成對比色 -#}
    {%- set own = tg if tg else (tone(body) | trim) -%}
    {%- set hl = (lv | length > 0) and tg == '' and (own not in ['r', 'o']) and ns.hi < 3 and (lv[0][0] | regex_search('開始時間|結束時間|用電量|電量|預估|剩餘|用時|已開啟|狀態|情境|模式|金額|次數')) -%}
    {%- if hl -%}{%- set ns.hi = ns.hi + 1 -%}{%- endif -%}
    {%- set acc = {'n': ['g', 'p', 'g'], 'g': ['n', 'p', 'n'], 'o': ['n', 'p', 'n'], 'r': ['n', 'p', 'n']}[ns.base if ns.base in ['n', 'g', 'o', 'r'] else 'n'] -%}
    {%- set etone = tg if tg else own if own in ['r', 'o'] else (acc[ns.hi - 1] if hl else ns.base) -%}
    {%- set ns.out = ns.out + [{'k': 'ent', 't': body, 'tb': (body if (lv | length > 0) else balance(body, lim)), 'ca': ec[1], 'pre': balance(ec[0], lim), 'cain': (ec[1] != '' and (body | length) <= lim), 'sub': sub, 'icon': icon, 'tone': etone, 'ttone': own, 'vt': tg, 'sec': is_sec, 'lab': (lv[0][0] if lv | length > 0 else ''), 'val': (lv[0][1] if lv | length > 0 else ''), 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# LINE Flex：回傳 JSON 字串（清單） #}
{# V4.2.0：每個小段落（小標題行／【段落】）上方加一條橫線；提醒小字（※~）上方加一條短橫線（連續的提醒只在第一行上方加） #}
{% macro flex_rows(lines0, base, max_icons=5, hsep=false) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], last_small=false) -%}
{%- set b2 = base | replace('/icons/b/', '/icons/b2/') -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set himg = {"type": "image", "url": b2 ~ it.icon ~ "_" ~ it.tone ~ ".png?v=1", "size": "24px", "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
    {%- if it.ca -%}
      {%- set htxt = {"type": "text", "size": (it.hsz ~ "px"), "weight": "bold", "wrap": true, "flex": 1, "lineSpacing": "4px", "color": "#111827", "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": "⚠︎", "color": "#F2994A"}]} -%}
    {%- else -%}
      {%- set htxt = {"type": "text", "text": it.tb, "size": (it.hsz ~ "px"), "weight": "bold", "wrap": true, "flex": 1, "lineSpacing": "4px", "color": "#111827"} -%}
    {%- endif -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "4px", "alignItems": "flex-start", "contents": [himg, htxt]}] -%}
    {%- if hsep -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
  {%- elif it.k == 'note' -%}
    {%- if it.gap and not it.flat and (ns.out | length > 0) -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- elif it.small and not ns.last_small -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "md", "paddingStart": "28px", "contents": [{"type": "separator", "color": "#E5E7EB"}]}] -%}
    {%- endif -%}
    {%- set lg = (it.t | regex_findall('綠色\\s*(\\S+?)\\s+黃色\\s*(\\S+?)\\s+紅色\\s*(\\S+)')) if it.flat else [] -%}
    {%- if lg | length > 0 -%}
      {#- V4.2.0：顏色示意條：圓點顏色與卡片裡的綠／橘／紅一致，字小一點 -#}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": "lg", "paddingAll": "8px", "paddingStart": "12px", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "spacing": "lg", "alignItems": "center", "contents": [
        {"type": "text", "text": "顏色示意", "size": "xxs", "color": "#9CA3AF", "flex": 0},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#16A34A", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][0], "color": "#6B7280"}]},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#D97706", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][1], "color": "#6B7280"}]},
        {"type": "text", "size": "xxs", "flex": 0, "contents": [{"type": "span", "text": "●", "color": "#DC2626", "size": "xs"}, {"type": "span", "text": " " ~ lg[0][2], "color": "#6B7280"}]}]}] -%}
    {%- else -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": ('xl' if it.gap else 'xs'), "paddingStart": ('0px' if it.flat else ('28px' if it.small else ('48px' if it.sub else '28px'))), "contents": [{"type": "text", "size": ("xxs" if it.small else "xs"), "wrap": true, "flex": 1, "color": "#9CA3AF", "contents": (mspans(it.t, '#9CA3AF') | from_json([]))}]}] -%}
    {%- endif -%}
  {%- elif it.k == 'sec' -%}
    {%- if ns.out | length > 0 -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
    {%- set ns.out = ns.out + [{"type": "text", "text": it.t, "size": "sm", "weight": "bold", "wrap": true, "margin": ("lg" if ns.out | length > 1 else "xxl"), "color": "#2F80ED"}] -%}
  {%- elif it.k == 'ent' -%}
    {%- set sepd = (it.sec or it.gap) and (ns.out | length > 0) -%}
    {%- if sepd -%}
      {%- set ns.out = ns.out + [{"type": "separator", "margin": "lg", "color": "#E5E7EB"}] -%}
    {%- endif -%}
    {%- set col = ({"r": "#B91C1C", "o": "#B45309"}[it.ttone] if it.ttone in ["r", "o"] else ("#111827" if it.sec else "#374151")) -%}
    {%- set sz = "xs" if it.sub else "sm" -%}
    {%- if it.lab and '⟦' in it.val -%}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": [{"type": "span", "text": it.lab ~ "  ", "color": "#6B7280", "size": "xs"}] + (mspans(it.val, '#111827') | from_json([]))} -%}
    {%- elif it.lab -%}
      {%- set txt = {"type": "text", "size": "sm", "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": [{"type": "span", "text": it.lab ~ "  ", "color": "#6B7280", "size": "xs"}, {"type": "span", "text": it.val, "weight": "bold", "size": sz, "color": ({"r": "#DC2626", "o": "#D97706", "g": "#16A34A"}[it.vt] if it.vt else ({"r": "#B91C1C", "o": "#B45309"}[it.ttone] if it.ttone in ["r", "o"] else "#111827"))}]} -%}
    {%- elif '⟦' in it.tb -%}
      {#- V4.2.0：一般句子（沒有圖示）也支援 ⟦o:重點⟧ 顏色標記，其餘一般色 -#}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": (mspans(it.tb, '#111827') | from_json([]))} -%}
    {%- elif it.ca -%}
      {#- 句尾「請注意」：注意符號（無圓圈）接在同一段文字最後，換行時跟著文字走 -#}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if it.icon else "regular"), "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": "⚠︎", "color": "#F2994A", "weight": "bold"}]} -%}
    {%- else -%}
      {%- set txt = {"type": "text", "text": it.tb, "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if (it.icon and not it.lab) else "regular")} -%}
    {%- endif -%}
    {%- set mg = 'md' if sepd else ('xl' if it.gap else ('sm' if it.sub else 'md')) -%}
    {%- set pad = '48px' if it.sub else '28px' -%}
    {%- set ipad = '28px' if it.sub else '2px' -%}
    {%- if it.icon -%}
      {%- set iimg = {"type": "image", "url": b2 ~ it.icon ~ "_" ~ it.tone ~ ".png?v=1", "size": ('14px' if it.sub else '20px'), "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "6px", "alignItems": "flex-start", "margin": mg, "paddingStart": ipad, "contents": [iimg, txt]}] -%}
    {%- else -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": mg, "paddingStart": pad, "contents": [txt]}] -%}
    {%- endif -%}
  {%- else -%}
    {%- set spans = ([{"type": "span", "text": it.old, "color": "#9CA3AF"}, {"type": "span", "text": "   →   ", "color": "#9CA3AF"}] if it.old else []) + [{"type": "span", "text": it.new, "weight": "bold", "color": ("#16A34A" if it.old else "#4B5563")}] -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "xs", "paddingStart": "48px", "contents": [{"type": "text", "size": "xs", "wrap": true, "contents": spans}]}] -%}
  {%- endif -%}
  {%- set ns.last_small = (it.small | default(false)) if it.k == 'note' else false -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# HA 通知（Markdown）：與 LINE 同一份行模型；每個項目之間空一行，版本接在名稱下一行 #}
{% macro md_lines(lines0, base, url='', max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(md=[]) -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set ns.md = ns.md + ['<img src="' ~ (base | replace('/icons/b/', '/icons/b2/')) ~ it.icon ~ '_' ~ it.tone ~ '.png" width="20" height="20" style="vertical-align:middle"> **' ~ body ~ '**' ~ ('<span style="color:#F2994A">⚠︎</span>' if it.ca else '')] -%}
  {%- elif it.k == 'note' -%}
    {%- set ns.md = ns.md + [('  ' if (it.sub and not it.flat) else '') ~ '<sub style="color:#9CA3AF">' ~ mhtml(it.t) ~ '</sub>'] -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.md = ns.md + ['**' ~ it.t ~ '**'] -%}
  {%- elif it.k == 'ent' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set pre = ('<img src="' ~ (base | replace('/icons/b/', '/icons/b2/')) ~ it.icon ~ '_' ~ it.tone ~ '.png" width="18" height="18" style="vertical-align:middle"> ') if it.icon else '' -%}
    {%- set ind = '  ' if it.sub else '' -%}
    {%- set caimg = '<span style="color:#F2994A">⚠︎</span>' if it.ca else '' -%}
    {%- if it.lab and not url -%}
      {%- set vcol = {'r': '#DC2626', 'o': '#D97706', 'g': '#16A34A'}[it.vt] if it.vt else '' -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ it.lab ~ '&nbsp;&nbsp;' ~ (mhtml(it.val) if '⟦' in it.val else (('<span style="color:' ~ vcol ~ '">**' ~ it.val ~ '**</span>') if vcol else ('**' ~ it.val ~ '**')))] -%}
    {%- else -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ body ~ caimg] -%}
    {%- endif -%}
  {%- else -%}
    {%- set v = ('<code>' ~ it.old ~ '</code> → <b><code>' ~ it.new ~ '</code></b>') if it.old else ('<code>' ~ it.new ~ '</code>') -%}
    {%- if ns.md | length > 0 -%}
      {%- set ns.md = ns.md[:-1] + [ns.md[-1] ~ '<br>' ~ v] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.md | join('\n\n') -}}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   災防地區解析輔助：拆分時段、重點三區標籤（竹南紅、苗栗藍、新竹綠）、其他縣市收合
   ────────────────────────────────────────────────────── #}
{% macro parse_alert_region(reg) -%}
  {%- set r0 = reg | regex_replace('[(（][^)）]*[)）]', '') | regex_replace('局部地區$', '') | trim -%}
  {%- set parts = r0.split('、') -%}
  {%- set res_ns = namespace(time_prefix='', targets=[], others=[]) -%}
  {%- for p in parts -%}
    {%- set item = p | trim -%}
    {%- set m_time = item | regex_findall('^(.*(?:上午|下午|晚上|中午|晨|夜))\\s*(.*)$') -%}
    {%- if m_time | length > 0 -%}
      {%- if res_ns.time_prefix == '' -%}
        {%- set res_ns.time_prefix = m_time[0][0] | trim -%}
      {%- endif -%}
      {%- set item = m_time[0][1] | trim -%}
    {%- endif -%}
    {%- if item != '' -%}
      {%- if '竹南' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'zhunan', 'col': '#DC2626', 'bg': '#FEE2E2', 'bd': '#FCA5A5', 'dot': '🔴'}] -%}
      {%- elif '苗栗' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'miaoli', 'col': '#2F80ED', 'bg': '#EFF6FF', 'bd': '#BFDBFE', 'dot': '🔵'}] -%}
      {%- elif '新竹' in item -%}
        {%- set res_ns.targets = res_ns.targets + [{'name': item, 'type': 'hsinchu', 'col': '#16A34A', 'bg': '#F0FDF4', 'bd': '#BBF7D0', 'dot': '🟢'}] -%}
      {%- else -%}
        {%- set res_ns.others = res_ns.others + [item] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {{- {'time': res_ns.time_prefix, 'targets': res_ns.targets, 'others': res_ns.others} | tojson -}}
{%- endmacro %}

{# V4.2.3（SOP-21）：依廣播內容判斷音效類別：只有「疏散／撤離」警告＝evac（CWBEEW，與地震預警同為最緊急的提示音）；
   其餘（颱風、豪雨、燈號、海嘯、土石流…一般災害廣播）回傳 dflt（空字串＝依等級用普通提示音） #}
{% macro broadcast_kind(msg, dflt='') -%}
{%- if (msg | string) | regex_search('疏散|撤離') -%}evac{%- else -%}{{ dflt }}{%- endif -%}
{%- endmacro %}

{# V4.2.2：HA 狀態上限 255 字元。REST 感測器 sensor.disaster_raw 的內文超過就會被改成 unknown（2026-10-23 颱風訊息太長，一直報錯、訊息進不來）。
   超長時濃縮成「只含竹南／苗栗／新竹」的版本（格式與原文相同，下游解析不用改）；255 字內原樣回傳。 #}
{% macro disaster_digest(msg) -%}
{%- set s = (msg | string) | trim -%}
{%- if s | length <= 255 -%}{{- s -}}
{%- else -%}
  {%- set s0 = s | regex_replace('^一、概述[：:]\\s*', '') -%}
  {%- set ns = namespace(segs=[], out='') -%}
  {%- set lead_m = s0 | regex_findall('((?:第[0-9]+號)?颱風及其外圍環流影響)') -%}
  {%- set lead = (lead_m[0] if lead_m | length > 0 else (s0.split('，')[0] | trim)) -%}
  {%- set items = s0 | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- for reg, cond, lamp in items -%}
    {%- set p = parse_alert_region(reg) | from_json -%}
    {%- if p.targets | length > 0 -%}
      {%- set ns.segs = ns.segs + [(p.time if ns.segs | length == 0 else '') ~ (p.targets | map(attribute='name') | join('、')) ~ '局部地區有' ~ (cond | trim) ~ '(' ~ lamp ~ '燈號)'] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if ns.segs | length > 0 -%}
    {%- set rain = namespace(l=[]) -%}
    {%- for gp in (free_parse(s0) | from_json).groups if gp.local | length > 0 -%}
      {%- set rain.l = rain.l + [(gp.time if rain.l | length == 0 else '') ~ (gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- set ns.out = lead ~ '，' ~ (ns.segs | join('，')) ~ (('，' ~ (rain.l | join('，'))) if rain.l | length > 0 else '') ~ '，請嚴加防範。' -%}
    {%- if ns.out | length > 255 -%}
      {%- set ns.out = lead ~ '，' ~ (ns.segs | join('，')) ~ '，請嚴加防範。' -%}
    {%- endif -%}
  {%- else -%}
    {%- set fp = free_parse(s0) | from_json -%}
    {%- for gp in fp.groups if gp.local | length > 0 -%}
      {%- set ns.segs = ns.segs + [(gp.time if ns.segs | length == 0 else '') ~ (gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if ns.segs | length > 0 -%}
      {%- set ns.out = ((fp.lead ~ '，') if fp.lead else '') ~ (ns.segs | join('，')) -%}
      {%- for tp in fp.tips -%}
        {%- if (ns.out ~ '，' ~ tp) | length <= 250 -%}{%- set ns.out = ns.out ~ '，' ~ tp -%}{%- endif -%}
      {%- endfor -%}
      {%- set ns.out = ns.out ~ '。' -%}
    {%- endif -%}
  {%- endif -%}
  {%- if ns.out == '' or ns.out | length > 255 -%}
    {%- set cut = s0[:250] -%}
    {%- set k = [cut.rfind('，'), cut.rfind('。')] | max -%}
    {{- (cut[:k + 1] if k > 40 else cut) -}}
  {%- else -%}{{- ns.out -}}{%- endif -%}
{%- endif -%}
{%- endmacro %}

{# V4.2.2：災害訊息「在地內容簽章」：只留下影響竹南／苗栗／新竹的燈號、地區與條件，不看其他縣市與時段文字（NCDR 常常只改其他縣市就再發一版，不該重複通知） #}
{% macro disaster_sig(msg) -%}
{%- set s0 = (msg | string) | trim -%}
{%- set items = s0 | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
{%- set ns = namespace(sig=[]) -%}
{%- for reg, cond, lamp in items -%}
  {%- set p = parse_alert_region(reg) | from_json -%}
  {%- if p.targets | length > 0 -%}
    {%- set ns.sig = ns.sig + [lamp ~ ':' ~ (p.targets | map(attribute='name') | sort | join('/')) ~ ':' ~ (cond | trim)] -%}
  {%- endif -%}
{%- endfor -%}
{%- set fps = namespace(o=[]) -%}
{%- for gp in (free_parse(s0) | from_json).groups if gp.local | length > 0 -%}
  {%- set fps.o = fps.o + [gp.hazard ~ ':' ~ (gp.local | sort | join('/'))] -%}
{%- endfor -%}
{%- if ns.sig | length > 0 or fps.o | length > 0 -%}{{ ((ns.sig + fps.o) | sort | join('|'))[:240] }}{%- else -%}{{ (s0 | regex_replace('\\s+', ''))[:240] }}{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   語音專用：只念苗栗（含竹南）、新竹縣市，保證完整句結尾、絕不硬切斷句
   ────────────────────────────────────────────────────── #}
{% macro disaster_voice(msg) -%}
{%- if msg not in ['', 'unknown', 'unavailable', 'none', 'None', none] -%}
  {%- set s0 = (msg | string) | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
  {%- set parts = s0.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^[一1]、(?:概述)?[:：\\s]*', '') | trim -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- if items | length > 0 -%}
    {%- set b_ns = namespace(blocks=[]) -%}
    {%- for reg, cond, lamp in items -%}
      {%- set h_ns = namespace(hits=[]) -%}
      {%- if '竹南' in reg -%}{%- set h_ns.hits = h_ns.hits + ['竹南'] -%}{%- endif -%}
      {%- if '苗栗' in reg -%}
        {%- if '苗栗縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗縣'] -%}
        {%- elif '苗栗市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗市'] -%}
        {%- elif '竹南' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗'] -%}{%- endif -%}
      {%- endif -%}
      {%- if '新竹市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹市'] -%}{%- endif -%}
      {%- if '新竹縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹縣'] -%}
      {%- elif '新竹' in reg and '新竹市' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹'] -%}{%- endif -%}
      {%- if h_ns.hits | length > 0 -%}
        {%- set b_ns.blocks = b_ns.blocks + [h_ns.hits | join('、') ~ '局部地區為' ~ lamp ~ '燈號，有' ~ (cond | trim)] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set fvl = free_parse(s_main) | from_json -%}
    {%- set rn = namespace(b=[]) -%}
    {%- for gp in fvl.groups if gp.local | length > 0 -%}
      {%- set rn.b = rn.b + [(gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if b_ns.blocks | length > 0 or rn.b | length > 0 -%}
      {{- '氣象署發布：' ~ ((b_ns.blocks + rn.b) | join('；')) ~ '。' -}}
    {%- endif -%}
  {%- else -%}
    {%- set fv = free_parse(s_main) | from_json -%}
    {%- set lg = namespace(b=[], t='') -%}
    {%- for gp in fv.groups if gp.local | length > 0 -%}
      {%- if lg.t == '' and gp.time -%}{%- set lg.t = gp.time -%}{%- endif -%}
      {%- set lg.b = lg.b + [(gp.local | join('、')) ~ '有' ~ gp.hazard] -%}
    {%- endfor -%}
    {%- if lg.b | length > 0 -%}
      {%- set vo = namespace(t='氣象署發布：' ~ ((fv.lead ~ '，') if fv.lead else '') ~ ((lg.t ~ '，') if lg.t else '') ~ (lg.b | join('；'))) -%}
      {%- for tp in fv.tips -%}
        {%- if (vo.t ~ '，' ~ tp) | length <= 130 -%}{%- set vo.t = vo.t ~ '，' ~ tp -%}{%- endif -%}
      {%- endfor -%}
      {{- vo.t ~ '。' -}}
    {%- else -%}
    {%- set s_clean = s_main | replace('\r', '') -%}
    {%- set raw_sents = (s_clean | replace('。', '。\n') | replace('；', '；\n')).split('\n') -%}
    {%- set m_ns = namespace(sents=[]) -%}
    {%- for sent in raw_sents -%}
      {%- set st = sent | regex_replace('^[一二三四五六七八九十\\d]+[、.：:]\\s*', '') | regex_replace('[。；;]+$', '') | trim -%}
      {%- if st != '' and (('竹南' in st) or ('苗栗' in st) or ('新竹' in st)) -%}
        {%- set m_ns.sents = m_ns.sents + [st] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if m_ns.sents | length > 0 -%}
      {%- set o_ns = namespace(out='') -%}
      {%- for st in m_ns.sents -%}
        {%- set cand = (o_ns.out ~ ('，' if o_ns.out != '' else '') ~ st) -%}
        {%- if cand | length <= 130 or o_ns.out == '' -%}
          {%- set o_ns.out = cand -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if o_ns.out != '' -%}
        {{- o_ns.out ~ ('。' if not o_ns.out.endswith(('。', '！', '!')) else '') -}}
      {%- endif -%}
    {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   離家戶外摘要專用：解析近 36 小時內影響苗栗／竹南／新竹的災害（颱風、海嘯、豪雨、強風燈號、淹水等）
   回傳 JSON：{"line": 通知項目行, "note": 通知提醒行, "voice": 廣播白話提醒句, "col": "r"|"o"|""}
   ────────────────────────────────────────────────────── #}
{% macro disaster_hint(msg, updated_ts=0) -%}
{%- set ts = updated_ts | float(0) -%}
{%- set fresh = (ts <= 0) or ((now().timestamp() - ts) <= 36 * 3600) -%}
{%- set s_raw = (msg | string) | trim if msg not in ['', 'unknown', 'unavailable', 'none', 'None', none] else '' -%}
{%- set skip = (s_raw == '') or not fresh or (s_raw | regex_search('解除|已無警戒|降至|已降至|演練|演習|模擬')) or ((s_raw | regex_search('地震')) and not (s_raw | regex_search('海嘯'))) -%}
{%- if skip -%}
  {{- {"line": "", "note": "", "voice": "", "col": "", "has_rain": false, "has_wind": false} | tojson -}}
{%- else -%}
  {%- set s0 = s_raw | regex_replace('^(?:天氣告知系統)?收到以下政府災害訊息[:：]?\\s*', '') | regex_replace('^政府發布(?:緊急)?疏散避難警報[:：]?\\s*', '') | regex_replace('^.*Disaster Prevention Report.*$', '') | regex_replace('^.*Evacuation Alarm.*$', '') | trim -%}
  {%- set parts = s0.split('二、注意') -%}
  {%- set s_main = parts[0] | regex_replace('^[一1]、(?:概述)?[:：\\s]*', '') | trim -%}
  {%- set items = s_main | regex_findall('([^，。\\n]*?局部地區)有([^()（）\\n]*?)[(（](紅色|橙色|黃色)燈號[)）]') -%}
  {%- set ns = namespace(short=[], v_items=[], lamps=[], sents=[], by={}, hzs=[]) -%}
  {%- if items | length > 0 -%}
    {%- for reg, cond, lamp in items -%}
      {%- set h_ns = namespace(hits=[]) -%}
      {%- if '竹南' in reg -%}{%- set h_ns.hits = h_ns.hits + ['竹南'] -%}{%- endif -%}
      {%- if '苗栗' in reg -%}
        {%- if '苗栗縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗縣'] -%}
        {%- elif '苗栗市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗市'] -%}
        {%- elif '竹南' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['苗栗'] -%}{%- endif -%}
      {%- endif -%}
      {%- if '新竹市' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹市'] -%}{%- endif -%}
      {%- if '新竹縣' in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹縣'] -%}
      {%- elif '新竹' in reg and '新竹市' not in reg -%}{%- set h_ns.hits = h_ns.hits + ['新竹'] -%}{%- endif -%}
      {%- if h_ns.hits | length > 0 -%}
        {%- set area = h_ns.hits | join('、') -%}
        {%- set ns.lamps = ns.lamps + [lamp] -%}
        {%- set mw = cond | regex_findall('陣風(\\d+)級') -%}
        {%- if '陣風' in cond or '平均風' in cond -%}
          {%- set hz = '強風' ~ (('・陣風' ~ mw[0] ~ '級以上') if mw | length > 0 else '') -%}
          {%- set vhz = '強風燈號' -%}
        {%- elif '超大豪雨' in cond -%}{%- set hz, vhz = '超大豪雨', '超大豪雨燈號' -%}
        {%- elif '大豪雨' in cond -%}{%- set hz, vhz = '大豪雨', '大豪雨燈號' -%}
        {%- elif '豪雨' in cond -%}{%- set hz, vhz = '豪雨', '豪雨燈號' -%}
        {%- elif '大雨' in cond -%}{%- set hz, vhz = '大雨', '大雨燈號' -%}
        {%- elif '38度' in cond or '36度' in cond or '高溫' in cond -%}{%- set hz, vhz = '高溫', '高溫燈號' -%}
        {%- elif '10度' in cond or '6度' in cond or '低溫' in cond -%}{%- set hz, vhz = '低溫', '低溫燈號' -%}
        {%- else -%}{%- set hz, vhz = (cond | trim), (lamp ~ '燈號') -%}{%- endif -%}
        {%- set ns.short = ns.short + [area ~ lamp ~ '燈號（' ~ hz ~ '）'] -%}
        {%- set ns.by = dict(ns.by, **{lamp: ((ns.by.get(lamp, []) + [area]) | unique | list)}) -%}
        {%- set hz_s = hz.split('・')[0] -%}
        {%- if hz_s not in ns.hzs -%}{%- set ns.hzs = ns.hzs + [hz_s] -%}{%- endif -%}
        {%- set ns.v_items = ns.v_items + [area ~ '為' ~ lamp ~ vhz] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- set s_clean = s_main | replace('\r', '') -%}
    {%- set raw_sents = (s_clean | replace('。', '。\n') | replace('；', '；\n')).split('\n') -%}
    {%- for sent in raw_sents -%}
      {%- set st = sent | regex_replace('^[一二三四五六七八九十\\d]+[、.：:]\\s*', '') | regex_replace('[。；;]+$', '') | trim -%}
      {%- if st != '' and (('竹南' in st) or ('苗栗' in st) or ('新竹' in st) or (st | regex_search('國家級警報|空襲|飛彈'))) -%}
        {%- set ns.sents = ns.sents + [st] -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if (ns.short | length == 0) and (ns.sents | length == 0) -%}
    {{- {"line": "", "note": "", "voice": "", "col": "", "has_rain": false, "has_wind": false} | tojson -}}
  {%- else -%}
    {%- if '颱風' in s_main and '東北風' in s_main -%}{%- set cause = '東北風偏強及颱風外圍環流影響' -%}
    {%- elif '颱風外圍環流' in s_main or '外圍環流' in s_main -%}{%- set cause = '颱風外圍環流影響' -%}
    {%- elif '颱風警報' in s_main -%}{%- set cause = '颱風警報發布中' -%}
    {%- elif '颱風' in s_main -%}{%- set cause = '受颱風影響' -%}
    {%- elif '東北風' in s_main or '東北季風' in s_main -%}{%- set cause = '東北季風偏強' -%}
    {%- elif '西南氣流' in s_main or '西南風' in s_main -%}{%- set cause = '西南氣流影響' -%}
    {%- elif '鋒面' in s_main -%}{%- set cause = '受鋒面影響' -%}
    {%- else -%}{%- set cause = '' -%}{%- endif -%}
    {%- set is_red = ('紅色' in ns.lamps) or (s_main | regex_search('海嘯|疏散|撤離|土石流|堰塞|超大豪雨|大豪雨|颱風警報|國家級警報|空襲|飛彈|一級淹水')) -%}
    {%- set col = 'r' if is_red else 'o' -%}
    {%- if '海嘯' in s_main -%}
      {%- set adv = '目前有海嘯警報，沿海與河口可能有危險巨浪，請立即遠離海邊往高處避難' -%}
    {%- elif s_main | regex_search('疏散|撤離|土石流|堰塞') -%}
      {%- set adv = '目前有疏散與土石流警戒，山區與溪邊有危險，請配合指示遠離危險區域' -%}
    {%- elif '颱風警報' in s_main -%}
      {%- set adv = '目前有颱風警報，可能帶來強陣風與豪大雨，外出有危險請多加小心並攜帶雨具' -%}
    {%- elif '颱風' in s_main and (s_main | regex_search('陣風|平均風|強風')) -%}
      {%- set adv = '受颱風外圍環流影響，可能下雨且有強陣風，外出請帶傘並小心騎車與行車安全' -%}
    {%- elif '颱風' in s_main -%}
      {%- set adv = '受颱風影響，天氣不穩定可能下雨或刮強風，外出請帶傘並注意安全' -%}
    {%- elif s_main | regex_search('超大豪雨|大豪雨|豪雨') -%}
      {%- set adv = '目前有豪雨警戒，可能下大雨導致道路積水與視線不佳，請帶雨具並避開低窪路段' -%}
    {%- elif '大雨' in s_main -%}
      {%- set adv = '目前有大雨特報，可能會下大雨，外出請記得帶傘並注意行車視線' -%}
    {%- elif s_main | regex_search('淹水|洩洪|放水|溢流') -%}
      {%- set adv = '目前有淹水或水庫放水警戒，低窪處與溪邊可能有積淹水危險，行車請勿涉水' -%}
    {%- elif s_main | regex_search('陣風|平均風|強風') -%}
      {%- set adv = '目前有強風特報，戶外陣風強勁，騎車與開車請減速握穩，並留意路樹與掉落物' -%}
    {%- elif s_main | regex_search('高溫|36度|38度') -%}
      {%- set adv = '目前有高溫特報，戶外相當炎熱，外出請注意防曬並多補充水分' -%}
    {%- elif s_main | regex_search('低溫|寒流|10度|6度') -%}
      {%- set adv = '目前有低溫特報，氣溫明顯偏低，外出請多加保暖衣物' -%}
    {%- elif s_main | regex_search('停水|暫停供水') -%}
      {%- set adv = '目前有停水通知，請留意家中用水與儲水安排' -%}
    {%- elif '停電' in s_main -%}
      {%- set adv = '目前有停電通知，請留意電器與照明安排' -%}
    {%- else -%}
      {%- set adv = '目前有在地災害告警，外出請多加留意周遭環境安全' -%}
    {%- endif -%}
    {%- if ns.short | length > 0 -%}
      {%- set line_body = (cause ~ '，' if cause else '') ~ (ns.short | join('、')) -%}
      {%- set adv_tail = adv | regex_replace('^受[^，]+影響，', '') | regex_replace('^目前[^，]+，', '') -%}
      {%- set v_out = '災害提醒：' ~ (cause ~ '，' if cause else '') ~ (ns.v_items | join('，')) ~ '，' ~ adv_tail ~ '。' -%}
    {%- else -%}
      {%- set sum_txt = (ns.sents[:2] | join('，')) | regex_replace('[。；;]+', '，') | regex_replace('，$', '') -%}
      {%- set sum_voice = sum_txt | regex_replace('，[^，。]*請[^，。]*$', '') -%}
      {%- set line_body = sum_txt[:80] -%}
      {%- set v_out = '災害提醒：' ~ (sum_voice if sum_voice else sum_txt)[:90] ~ '，' ~ (adv | regex_replace('^目前[^，]+，', '') | regex_replace('^受[^，]+影響，', '')) ~ '。' -%}
    {%- endif -%}
    {#- 通知用短版：原因＋災種為一般色，只有紅／橙色燈號的地區標色；黃色燈號與其他文字一般色 -#}
    {%- if ns.short | length > 0 -%}
      {%- set c_s = '颱風警報' if '颱風警報' in s_main else ('颱風外圍' if '颱風' in s_main else ('東北風' if ('東北風' in s_main or '東北季風' in s_main) else ('西南氣流' if ('西南氣流' in s_main or '西南風' in s_main) else ('鋒面' if '鋒面' in s_main else '')))) -%}
      {%- set hz_t = ns.hzs | join('・') -%}
      {%- set head_t = ((c_s ~ '・') if (c_s and c_s not in hz_t) else '') ~ hz_t -%}
      {#- V4.2.0：獨立一個小段落「氣象告警：」，每個重點一行（原因、各色燈號的地區），縮排顯示；只有紅／橙色燈號的地區標色 -#}
      {%- set pt = namespace(o=['', '氣象告警：']) -%}
      {%- if head_t -%}{%- set pt.o = pt.o + ['原因：' ~ head_t] -%}{%- endif -%}
      {%- for lp in ['紅色', '橙色', '黃色'] -%}
        {%- if ns.by.get(lp) -%}
          {%- set areas = ns.by[lp] | join('、') -%}
          {%- if lp == '黃色' -%}
            {%- set pt.o = pt.o + [lp ~ '燈號：' ~ areas] -%}
          {%- else -%}
            {%- set lc = 'r' if lp == '紅色' else 'o' -%}
            {%- set pt.o = pt.o + [lp ~ '燈號：⟦' ~ lc ~ ':' ~ areas ~ '⟧⟦' ~ lc ~ '⟧'] -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set line_s = pt.o | join('\n') -%}
    {%- else -%}
      {%- set line_s = '\n氣象告警：\n※ ⟦' ~ col ~ ':' ~ line_body[:40] ~ '⟧' -%}
    {%- endif -%}
    {%- set adv_map = {
      '目前有海嘯警報，沿海與河口可能有危險巨浪，請立即遠離海邊往高處避難': '沿海可能有巨浪，⟦C:請立即遠離海邊往高處避難⟧',
      '目前有疏散與土石流警戒，山區與溪邊有危險，請配合指示遠離危險區域': '山區溪邊有危險，⟦C:請配合指示遠離危險區域⟧',
      '目前有颱風警報，可能帶來強陣風與豪大雨，外出有危險請多加小心並攜帶雨具': '可能有強陣風與豪大雨，⟦C:外出請小心並帶雨具⟧',
      '受颱風外圍環流影響，可能下雨且有強陣風，外出請帶傘並小心騎車與行車安全': '可能下雨、有強陣風，外出請⟦C:帶傘、小心行車⟧',
      '受颱風影響，天氣不穩定可能下雨或刮強風，外出請帶傘並注意安全': '天氣不穩，外出請⟦C:帶傘、注意安全⟧',
      '目前有豪雨警戒，可能下大雨導致道路積水與視線不佳，請帶雨具並避開低窪路段': '可能下大雨積水，請⟦C:帶雨具、避開低窪⟧',
      '目前有大雨特報，可能會下大雨，外出請記得帶傘並注意行車視線': '可能下大雨，外出請⟦C:帶傘⟧',
      '目前有淹水或水庫放水警戒，低窪處與溪邊可能有積淹水危險，行車請勿涉水': '低窪溪邊有淹水風險，⟦C:行車勿涉水⟧',
      '目前有強風特報，戶外陣風強勁，騎車與開車請減速握穩，並留意路樹與掉落物': '陣風強勁，⟦C:騎車開車請減速⟧',
      '目前有高溫特報，戶外相當炎熱，外出請注意防曬並多補充水分': '戶外炎熱，⟦C:注意防曬、補充水分⟧',
      '目前有低溫特報，氣溫明顯偏低，外出請多加保暖衣物': '氣溫偏低，⟦C:請加衣保暖⟧',
      '目前有停水通知，請留意家中用水與儲水安排': '⟦C:請留意用水與儲水⟧',
      '目前有停電通知，請留意電器與照明安排': '⟦C:請留意電器與照明⟧'
    } -%}
    {%- set note_s = (adv_map.get(adv, '⟦C:外出請留意周遭安全⟧')) | replace('C:', col ~ ':') -%}
    {{- {
      "line": line_s,
      "note": "※~" ~ note_s,
      "voice": v_out,
      "col": col,
      "has_rain": ('雨' in adv or '傘' in adv),
      "has_wind": ('風' in adv)
    } | tojson -}}
  {%- endif -%}
{%- endif -%}
{%- endmacro %}

{# ──────────────────────────────────────────────────────
   V4.2.0：地震預警、最新地震報告、氣象與災害告警 專屬現代化卡片排版
   與自動化管理面板（DISASTER_JS / EARTHQUAKE_JS）視覺風格一致：
   - 頂部標題列＋右側動態色膠囊標籤（強震／中強震／有感地震／緊急避難／紅橙黃色燈號／疏散警報）
   - 地震報告：2×2 圓角資訊格（規模、最大震度、發生時間、震央位置）
   - 地震預警：雙欄圓角資訊格（預估震度、預計抵達）＋系統處置框＋避難指引框
   - 氣象災防：自動解析紅／橙／黃色燈號獨立圓角色塊框（在地彩色標籤＋其他縣市收合）＋注意事項框
   - 全欄位啟用 wrap: true 與 flex: 1，適配手機與電腦絕不跑版或超出框格
   ────────────────────────────────────────────────────── #}
{# V4.2.2：自由文字的災害訊息（沒有「局部地區有…燈號」句型，例如土石流警戒、颱風豪雨特報、淹水警戒）：
   ①竹南（紅）、苗栗（藍）、新竹（綠）特別標出；②拆成「警戒種類＋時段＋地區」分組、額外地區行、安全提醒條列，不再是一整段字 #}
{% macro hl_spans(txt, wt='regular') -%}
{%- set ns = namespace(o=[]) -%}
{%- for g, o in (txt | regex_findall('(竹南|苗栗縣|苗栗市|苗栗|新竹縣|新竹市|新竹)|([^竹苗新]+|[竹苗新])')) -%}
  {%- if g -%}
    {%- set c = '#DC2626' if g.startswith('竹南') else ('#2F80ED' if g.startswith('苗栗') else '#16A34A') -%}
    {%- set ns.o = ns.o + [{"type": "span", "text": g, "color": c, "weight": "bold"}] -%}
  {%- elif o -%}
    {%- set ns.o = ns.o + [{"type": "span", "text": o, "color": "#111827", "weight": wt}] -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.o | tojson -}}
{%- endmacro %}
{% macro hl_html(txt) -%}
{%- set ns = namespace(o='') -%}
{%- for g, o in (txt | regex_findall('(竹南|苗栗縣|苗栗市|苗栗|新竹縣|新竹市|新竹)|([^竹苗新]+|[竹苗新])')) -%}
  {%- if g -%}
    {%- set c = '#DC2626' if g.startswith('竹南') else ('#2F80ED' if g.startswith('苗栗') else '#16A34A') -%}
    {%- set ns.o = ns.o ~ '<span style="color:' ~ c ~ '"><b>' ~ g ~ '</b></span>' -%}
  {%- elif o -%}
    {%- set ns.o = ns.o ~ o -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.o -}}
{%- endmacro %}
{% macro free_parse(txt) -%}
{%- set lines = (txt | string).split('\n') | map('trim') | reject('eq', '') | list -%}
{%- set main = lines[0] if lines | length > 0 else '' -%}
{%- set ns = namespace(groups=[], tips=[], lead='', extras=[], lt='') -%}
{%- for ln in lines[1:] -%}
  {%- set m = ln | regex_findall('^([^：:。，]{1,12})[：:]\\s*(.+?)。?$') -%}
  {%- if m | length > 0 -%}{%- set ns.extras = ns.extras + [{'k': m[0][0], 'v': m[0][1]}] -%}{%- endif -%}
{%- endfor -%}
{%- for sent in main.split('。') | map('trim') | reject('eq', '') -%}
  {%- for cl in sent.split('，') | map('trim') | reject('eq', '') -%}
    {%- set gm = cl | regex_findall('^(.*?)有((?:局部)?[^，]*?(?:豪雨|大雨|強風|陣風|低溫|高溫|雷雨|大浪))(?:發生的機率)?$') -%}
    {%- if gm | length > 0 -%}
      {%- set rp = gm[0][0] -%}
      {%- set hz = gm[0][1] -%}
      {%- set tm = rp | regex_findall('^([^宜臺台新桃基苗花南嘉雲彰高屏澎金連竹中]*)(.*)$') -%}
      {%- set tpart = (tm[0][0] | trim) if tm | length > 0 else '' -%}
      {%- set has_t = tpart != '' and (tpart | regex_search('日|晚|上午|下午|凌晨|清晨|今|明')) -%}
      {%- if has_t -%}{%- set ns.lt = tpart -%}{%- endif -%}
      {%- set rpart = tm[0][1] if has_t else rp -%}
      {%- set regs = (rpart | replace('及', '、')).split('、') | map('trim') | reject('eq', '') | list -%}
      {%- set g_ns = namespace(local=[], other=[]) -%}
      {%- for r in regs -%}
        {%- if r | regex_search('竹南|苗栗|新竹') -%}{%- set g_ns.local = g_ns.local + [r] -%}{%- else -%}{%- set g_ns.other = g_ns.other + [r] -%}{%- endif -%}
      {%- endfor -%}
      {%- if '超大豪雨' in hz -%}{%- set sv = ['#DC2626', '#FEF2F2', '#FCA5A5', '🔴'] -%}
      {%- elif '大豪雨' in hz -%}{%- set sv = ['#EA580C', '#FFF7ED', '#FDBA74', '🟠'] -%}
      {%- elif '豪雨' in hz -%}{%- set sv = ['#D97706', '#FFFBEB', '#FCD34D', '🟠'] -%}
      {%- else -%}{%- set sv = ['#CA8A04', '#FEFCE8', '#FDE047', '🟡'] -%}{%- endif -%}
      {%- set ns.groups = ns.groups + [{'time': ns.lt, 'hazard': hz, 'local': g_ns.local, 'other': g_ns.other, 'col': sv[0], 'bg': sv[1], 'bd': sv[2], 'dot': sv[3]}] -%}
    {%- elif ns.lead == '' and ns.groups | length == 0 -%}
      {%- set ns.lead = cl -%}
    {%- else -%}
      {%- set ns.tips = ns.tips + [cl] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{{- {'lead': ns.lead, 'groups': ns.groups, 'tips': ns.tips, 'extras': ns.extras} | tojson -}}
{%- endmacro %}

{# V4.3.10 充電通知專用：資訊格（小標＋大字值）與充電器溫度著色 #}
{% macro ch_tile(label, value, col='#111827', size='sm') -%}
{{ {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "contents": [{"type": "text", "text": label, "size": "xxs", "color": "#6B7280"}, {"type": "text", "text": value, "size": size, "weight": "bold", "color": col, "wrap": true}]} | tojson }}
{%- endmacro %}
{% macro ch_temp_col(v, warn, hot) -%}
{%- set n = (v | regex_findall('-?[0-9.]+') | first | default('', true)) | float(-999) -%}
{{- '#DC2626' if n >= hot else ('#D97706' if n >= warn else ('#16A34A' if n > -999 else '#6B7280')) -}}
{%- endmacro %}
{% macro ch_parse(lines) -%}
{%- set ns = namespace(d={}) -%}
{%- for l in lines[1:] -%}
  {%- set pr = (l | string).split('：', 1) -%}
  {%- if pr | length == 2 and (pr[1] | trim) != '' -%}{%- set ns.d = dict(ns.d, **{(pr[0] | trim): (pr[1] | trim)}) -%}{%- endif -%}
{%- endfor -%}
{{- ns.d | tojson -}}
{%- endmacro %}
{% macro ch_when(t) -%}
{{- (t | string) | regex_replace('^\\d{4}-(\\d{2})-(\\d{2}) (\\d{2}:\\d{2}).*$', '\\1/\\2 \\3') -}}
{%- endmacro %}

{# V4.3.12：現代化卡片共用零件（自動離家、鐵門未關、鐵門自動關門結果…）：標題列＋色膠囊、彩色資訊框、灰底小框、勾選列、備註 #}
{% macro cd_hdr(ic, title, badge, bcol, b2) -%}
{{ {"type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px", "contents": [
  {"type": "image", "url": b2 ~ ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
  {"type": "text", "text": title, "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
  {"type": "box", "layout": "vertical", "backgroundColor": bcol, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
   "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}]} | tojson }}
{%- endmacro %}
{% macro cd_box(rows, bg, bd, mg='md') -%}
{{ {"type": "box", "layout": "vertical", "backgroundColor": bg, "borderColor": bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": mg, "spacing": "md", "contents": rows} | tojson }}
{%- endmacro %}
{% macro cd_row(ic, text, b2, col='#374151', sz='sm', bold=false) -%}
{{ {"type": "box", "layout": "horizontal", "spacing": "8px", "alignItems": "center", "contents": [
  {"type": "image", "url": b2 ~ ic ~ ".png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
  {"type": "text", "text": text, "size": sz, "color": col, "wrap": true, "flex": 1, "weight": ("bold" if bold else "regular")}]} | tojson }}
{%- endmacro %}
{% macro cd_gray(title, rows, mg='sm') -%}
{{ {"type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": mg, "spacing": "8px", "contents": ([{"type": "text", "text": title, "size": "xxs", "weight": "bold", "color": "#6B7280", "wrap": true}] + rows)} | tojson }}
{%- endmacro %}
{% macro cd_note(text, mg='md') -%}
{{ {"type": "text", "text": text, "size": "xxs", "color": "#9CA3AF", "wrap": true, "margin": mg, "lineSpacing": "3px"} | tojson }}
{%- endmacro %}
{% macro cd_pair(a, b) -%}
{{ {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [a, dict(b, paddingStart='8px')]} | tojson }}
{%- endmacro %}
{# 行內顏色標記 ⟦g:…⟧ 的第一個顏色／去掉標記後的文字 #}
{% macro mk_col(v) -%}
{%- set m = (v | string) | regex_findall('⟦([rogn]):') -%}
{{- ({'r': '#DC2626', 'o': '#D97706', 'g': '#16A34A', 'n': '#6B7280'}[m[0]]) if m | length > 0 else '#111827' -}}
{%- endmacro %}
{% macro mk_txt(v) -%}
{{- (v | string) | regex_replace('⟦[rogn]:([^⟧]*)⟧', '\\1') | trim -}}
{%- endmacro %}
{# 名稱：數值 的列表（元素 {s: 段落, k: 名稱, v: 數值}）取值／依段落篩選 #}
{% macro ro_get(rows, key) -%}
{%- for r in rows -%}{%- if r.k == key -%}{{ r.v }}{%- endif -%}{%- endfor -%}
{%- endmacro %}
{% macro ro_sec(rows, pat) -%}
{%- set ns = namespace(o=[]) -%}{%- for r in rows -%}{%- if r.s | regex_search(pat) -%}{%- set ns.o = ns.o + [r] -%}{%- endif -%}{%- endfor -%}{{- ns.o | tojson -}}
{%- endmacro %}

{# V4.3.13：第二批卡片零件：兩欄資訊格、提示條、名稱：數值解析、狀態中文化 #}
{% macro cd_grid(pairs, col='#111827', size='sm') -%}
{%- set ns = namespace(o=[], cur=[]) -%}
{%- for p in pairs -%}
  {%- set tl = ch_tile(p[0], p[1], (p[2] if (p | length > 2 and p[2]) else col), size) | from_json -%}
  {%- if ns.cur | length == 0 -%}{%- set ns.cur = [tl] -%}
  {%- else -%}{%- set ns.o = ns.o + [{"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ns.cur[0], dict(tl, paddingStart='8px')]}] -%}{%- set ns.cur = [] -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.cur | length > 0 -%}{%- set ns.o = ns.o + [ns.cur[0]] -%}{%- endif -%}
{{- ns.o | tojson -}}
{%- endmacro %}
{% macro cd_call(ic, text, b2, col='#374151', bg='#F3F4F6') -%}
{{ {"type": "box", "layout": "horizontal", "backgroundColor": bg, "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "8px", "alignItems": "center", "contents": [
  {"type": "image", "url": b2 ~ ic ~ ".png?v=1", "size": "18px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
  {"type": "text", "text": text, "size": "xs", "weight": "bold", "color": col, "wrap": true, "flex": 1}]} | tojson }}
{%- endmacro %}
{% macro kv_of(lines) -%}
{%- set ns = namespace(d={}) -%}
{%- for l in lines -%}
  {%- set c = clean(l | string) | trim -%}
  {%- set m = c | regex_findall('^([^：:。，]{1,14})[：:]\\s*(.+)$') -%}
  {%- if m | length > 0 and (m[0][0] | trim) not in ns.d -%}{%- set ns.d = dict(ns.d, **{(m[0][0] | trim): (m[0][1] | trim)}) -%}{%- endif -%}
{%- endfor -%}
{{- ns.d | tojson -}}
{%- endmacro %}
{% macro st_zh(v) -%}
{%- set s = (v | string) | trim -%}
{{- {'charging': '充電中', 'connected': '已連接', 'plugged': '已插槍', 'disconnected': '未連接', 'unplugged': '未插槍', 'error': '異常', 'fault': '故障',
     'complete': '充電完成', 'completed': '充電完成', 'charging_completed': '充電完成', 'finished': '充電完成', 'idle': '待機', 'standby': '待機',
     'ready': '待機', 'waiting': '等待中', 'paused': '暫停', 'unavailable': '無法連線', 'unknown': '未知'}.get(s | lower, s if s else '--') -}}
{%- endmacro %}
{% macro tag_col(c) -%}
{{- {'g': '#16A34A', 'o': '#D97706', 'r': '#DC2626'}.get(c, '#111827') -}}
{%- endmacro %}

{% macro special_body(title, src, lines0, lv='general', b2='https://family.kteam.tw:8126/local/icons/b2/') -%}
{%- set lines = (lines0 | from_json([])) if lines0 is string else (lines0 | list) -%}
{%- set joined = lines | map('string') | join('\n') -%}
{%- set sig = (title | string) ~ ' ' ~ (src | string) ~ ' ' ~ joined -%}
{#- V4.2.2：卡片種類只看標題與來源（sig_h）和嚴格的訊息格式，不看內文裡剛好出現的字（每日更新紀錄的內文會提到地震預警、災害訊息、燈號，原本被誤認成地震預警卡片）；更新紀錄一律不套專用卡片 -#}
{%- set sig_h = (title | string) ~ ' ' ~ (src | string) -%}
{%- set skip = '更新紀錄' in sig_h -%}
{%- set ch_head = (lines[0] | string) if lines | length > 0 else '' -%}
{%- set ch_start = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('開始充電$')) and not (ch_head | regex_search('未開始充電')) -%}
{%- set ch_done = ('107Tesla' in sig_h or '充電器' in sig_h) and (ch_head | regex_search('充電完成$')) -%}
{%- if (not skip) and (ch_start or ch_done) -%}
  {%- set kv = ch_parse(lines) | from_json({}) -%}
  {%- set veh = ch_head | regex_replace('\\s*(開始充電|充電完成)$', '') | trim -%}
  {%- set badge, b_col, box_bg, box_bd, val_col, ic = ('充電中', '#2F80ED', '#EFF6FF', '#BFDBFE', '#1D4ED8', 'ev_n') if ch_start else ('充電完成', '#30D158', '#F0FDF4', '#86EFAC', '#16A34A', 'ev_g') -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": ("開始充電" if ch_start else "充電完成"), "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set t_start = ch_when(kv.get('開始時間', kv.get('時間', '--'))) -%}
  {%- set t_end = ch_when(kv.get('結束時間', '--')) -%}
  {%- set vrow = {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('充電車輛', veh, '#111827', 'md') | from_json, dict(ch_tile('開始時間', t_start) | from_json, paddingStart='8px')]} -%}
  {%- if ch_start -%}
    {%- set main_rows = [vrow] -%}
  {%- else -%}
    {%- set kwh = (kv.get('用電量', '--') | regex_replace('\\s*kWh.*$', '')) -%}
    {%- set kwh_tile = {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "contents": [
          {"type": "text", "text": "用電量", "size": "xxs", "color": "#6B7280"},
          {"type": "text", "wrap": false, "contents": [{"type": "span", "text": kwh, "size": "xxl", "weight": "bold", "color": val_col}, {"type": "span", "text": " kWh", "size": "sm", "weight": "bold", "color": val_col}]}]} -%}
    {%- set d1 = t_start[:5] -%}{%- set h1 = t_start[-5:] -%}{%- set d2 = t_end[:5] -%}{%- set h2 = t_end[-5:] -%}
    {%- set main_rows = [
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [kwh_tile, dict(ch_tile('充電用時', kv.get('充電用時', '--') | replace('分鐘', '分'), '#111827', 'md') | from_json, paddingStart='8px')]},
      {"type": "separator", "color": box_bd},
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('充電車輛', veh, '#111827', 'sm') | from_json, dict(ch_tile('開始 ' ~ d1, h1, '#111827', 'sm') | from_json, paddingStart='8px'), dict(ch_tile('結束 ' ~ d2, h2, '#111827', 'sm') | from_json, paddingStart='8px')]}
    ] -%}
  {%- endif -%}
  {%- set main_box = {"type": "box", "layout": "vertical", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "contents": main_rows} -%}
  {%- set hv = kv.get('手把溫度', kv.get('手把', '--')) -%}
  {%- set mv = kv.get('MCU 溫度', kv.get('MCU溫度', kv.get('MCU', '--'))) -%}
  {%- set pv = kv.get('PCB 溫度', kv.get('PCB溫度', kv.get('PCB', '--'))) -%}
  {%- set temp_box = {"type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "contents": [
      {"type": "text", "text": "充電器溫度", "size": "xxs", "weight": "bold", "color": "#6B7280"},
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [
        ch_tile('手把', hv, ch_temp_col(hv, 42, 50) | trim, 'sm') | from_json,
        ch_tile('MCU', mv, ch_temp_col(mv, 60, 75) | trim, 'sm') | from_json,
        ch_tile('PCB', pv, ch_temp_col(pv, 70, 85) | trim, 'sm') | from_json
      ]}]} -%}
  {{- [hdr_row, main_box, temp_box] | tojson -}}
{%- elif (not skip) and ('電視無回應' in sig_h) -%}
  {#- V4.2.4：電視無回應卡片（橘色注意）：已做的處置、目前狀態、後續提醒、請你確認的事 -#}
  {%- set hdr_row = {"type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px", "contents": [
      {"type": "image", "url": b2 ~ "tv_o.png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "電視無回應", "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": "#EA580C", "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": "請注意", "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}]} -%}
  {%- set main_box = {"type": "box", "layout": "vertical", "backgroundColor": "#FFF7ED", "borderColor": "#FED7AA", "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "contents": [
      {"type": "box", "layout": "horizontal", "spacing": "md", "contents": [ch_tile('已執行', '紅外線喚醒', '#111827', 'md') | from_json, dict(ch_tile('目前狀態', '仍連不上網路', '#C2410C', 'md') | from_json, paddingStart='8px')]},
      {"type": "separator", "color": "#FED7AA"},
      ch_tile('後續', '不再重送（避免把電視關掉）', '#111827', 'sm') | from_json]} -%}
  {%- set act_box = {"type": "box", "layout": "horizontal", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "8px", "alignItems": "center", "contents": [
      {"type": "image", "url": b2 ~ "check_n.png?v=1", "size": "18px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "請確認紅外線開關情境與電視電源", "size": "xs", "weight": "bold", "color": "#374151", "wrap": true, "flex": 1}]} -%}
  {{- [hdr_row, main_box, act_box] | tojson -}}
{%- elif (not skip) and (('自動離家' in sig_h) or ('100B' in sig_h)) and (joined | regex_search('已離家|判定離家')) -%}
  {#- V4.3.12：自動離家卡片：綠＝已離家一切就緒；紅＝已離家但門鎖／鐵門有未鎖未關。下方依序是門鎖電量、戶外狀況、氣象告警小框 -#}
  {%- set ns = namespace(sec='', top=[], scene='', rows=[], tips=[]) -%}
  {%- for l0 in lines -%}
    {%- set t0 = (l0 | string) | trim -%}
    {%- if t0 == '' -%}
    {%- elif t0.startswith('※') -%}
      {%- set ns.tips = ns.tips + [t0[1:] | trim | regex_replace('^~\\s*', '')] -%}
    {%- else -%}
      {%- set l = clean(t0) | trim -%}
      {%- set hd = l | regex_findall('^([^：:。，]{1,12})[：:]$') -%}
      {%- set kv = l | regex_findall('^([^：:。，；]{1,14})[：:]\\s*(.+)$') -%}
      {%- if l == '' -%}
      {%- elif hd | length > 0 -%}{%- set ns.sec = hd[0] -%}
      {%- elif kv | length > 0 and ns.sec != '' -%}{%- set ns.rows = ns.rows + [{'s': ns.sec, 'k': kv[0][0], 'v': kv[0][1]}] -%}
      {%- elif kv | length > 0 and kv[0][0] == '目前情境' -%}{%- set ns.scene = kv[0][1] -%}
      {%- elif ns.sec != '' -%}{%- set ns.rows = ns.rows + [{'s': ns.sec, 'k': '', 'v': l}] -%}
      {%- else -%}{%- set ns.top = ns.top + [l] -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set batt = ro_sec(ns.rows, '電量') | from_json([]) -%}
  {%- set outd = ro_sec(ns.rows, '戶外') | from_json([]) -%}
  {%- set warn = ro_sec(ns.rows, '氣象') | from_json([]) -%}
  {%- set gwfail = (joined | regex_search('網關未成功設定')) -%}
  {%- set unsafe = (joined | regex_search('未上鎖或未關')) or gwfail -%}
  {%- if gwfail -%}
    {%- set hd_ic, hd_t, hd_badge, hd_col, bx_bg, bx_bd, vc = 'alarm_r', '網關未切離家', '請確認', '#DC2626', '#FEF2F2', '#FCA5A5', '#DC2626' -%}
  {%- elif unsafe -%}
    {%- set hd_ic, hd_t, hd_badge, hd_col, bx_bg, bx_bd, vc = 'alarm_r', '已離家', '有未鎖／未關', '#DC2626', '#FEF2F2', '#FCA5A5', '#DC2626' -%}
  {%- else -%}
    {%- set hd_ic, hd_t, hd_badge, hd_col, bx_bg, bx_bd, vc = 'homeout_g', '所有人已離家', '離家模式', '#30D158', '#F0FDF4', '#86EFAC', '#15803D' -%}
  {%- endif -%}
  {%- set scene_v = ns.scene if ns.scene != '' else '離家情境' -%}
  {%- set it = namespace(r=[]) -%}
  {%- for l in (ns.top if gwfail else ns.top[1:]) -%}
    {%- set gm = l | regex_findall('^車庫鐵門[：:]\\s*([a-z_]+)[、，,]\\s*二樓門鎖同步開關[：:]\\s*([a-z_]+)') -%}
    {%- if gm | length > 0 -%}
      {%- set gs = {'closed': '已關閉', 'open': '開著', 'opening': '開啟中', 'closing': '關閉中'}.get(gm[0][0], gm[0][0]) -%}
      {%- set ls = {'off': '已上鎖', 'on': '未上鎖'}.get(gm[0][1], gm[0][1]) -%}
      {%- set it.r = it.r + [cd_row(('check_g' if gm[0][0] == 'closed' else 'alarm_o'), '車庫鐵門：' ~ gs, b2, '#374151', 'sm') | from_json,
                             cd_row(('check_g' if gm[0][1] == 'off' else 'alarm_o'), '二樓門鎖：' ~ ls, b2, '#374151', 'sm') | from_json] -%}
    {%- else -%}
    {%- for p in (l | replace('。', '') | regex_replace('^但\\s*', '') | regex_replace('[，,]$', '')).split('；') if ((p | trim) != '' and not ((p | trim) | regex_search('^已啟動離家模式$'))) -%}
      {%- set bad = unsafe and not (p | trim).startswith('本次已') and not (p | trim).startswith('已判定') -%}
      {%- set it.r = it.r + [cd_row(('alarm_r' if bad else 'check_g'), ((p | trim) | replace('二樓門鎖同步開關', '二樓門鎖')), b2, ('#B91C1C' if bad else '#374151'), 'sm', bad) | from_json] -%}
    {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set tiles = cd_pair(ch_tile('目前情境', scene_v, vc, 'md') | from_json, ch_tile('離家模式', ('網關未設定' if gwfail else ('尚未完成' if unsafe else '已啟動')), vc, 'md') | from_json) | from_json -%}
  {%- set main_box = cd_box([tiles] + ([{"type": "separator", "color": bx_bd}] if it.r | length > 0 else []) + it.r, bx_bg, bx_bd) | from_json -%}
  {%- set out = namespace(c=[cd_hdr(hd_ic, hd_t, hd_badge, hd_col, b2) | from_json, main_box]) -%}
  {#- 門鎖電量：最多三格；第一格（電量 %）依高低上色 -#}
  {%- if batt | length > 0 -%}
    {%- set bp = namespace(p=[], m='') -%}
    {%- for r in batt if r.k != '' -%}
      {%- if '款式' in r.k -%}{%- set bp.m = r.v -%}
      {%- else -%}
        {%- set n = (r.v | regex_findall('[0-9]+') | first | default('', true)) | int(-1) -%}
        {%- set col = ('#DC2626' if (0 <= n < 20) else ('#D97706' if (0 <= n < 50) else '#16A34A')) if ('電量' in r.k and '%' in r.v) else '#111827' -%}
        {%- set lab = '電量' if ('電量' in r.k) else ('預估可用' if r.k == '預估天數' else r.k) -%}
        {%- set bp.p = bp.p + [[lab, r.v, col]] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set mp = bp.m.split('/') | map('trim') | list -%}
    {%- set mtxt = '' if bp.m == '' else ((mp[0] ~ '（上次 ' ~ mp[1] ~ '）') if (mp | length > 1 and mp[0] != mp[1]) else mp[0]) -%}
    {%- set brows = cd_grid(bp.p, '#111827', 'sm') | from_json -%}
    {%- if mtxt != '' -%}{%- set brows = brows + [ch_tile('電池款式', mtxt, '#111827', 'sm') | from_json] -%}{%- endif -%}
    {%- if brows | length > 0 -%}{%- set out.c = out.c + [cd_gray('客廳門鎖', brows) | from_json] -%}{%- endif -%}
  {%- endif -%}
  {#- 戶外狀況：天氣／降雨機率／紫外線／空氣品質（顏色沿用原訊息標記） -#}
  {%- if outd | length > 0 -%}
    {%- set wv = ro_get(outd, '天氣') | trim -%}
    {%- set rain = wv | regex_findall('降雨機率\\s*([0-9]+%)') -%}
    {%- set wt = mk_txt(wv | regex_replace('[、，,]?\\s*降雨機率.*$', '')) -%}
    {%- set wmax = wt | regex_findall('(最高|最低)\\s*([0-9.]+\\s*°?\\s*C?)') -%}
    {%- set wmain = wt | regex_replace('\\s*[（(，,]\\s*(?:最高|最低)[^）)]*[）)]?', '') | trim -%}
    {%- set uv = ro_get(outd, '紫外線') | trim -%}
    {%- set aq = ro_get(outd, '空氣品質') | trim -%}
    {%- set op = namespace(p=[]) -%}
    {%- if wv != '' -%}{%- set op.p = op.p + [['天氣', wmain, mk_col(wv) | trim]] -%}{%- endif -%}
    {%- if wmax | length > 0 -%}{%- set op.p = op.p + [[wmax[0][0] ~ '溫', (wmax[0][1] | trim) ~ ('' if ('C' in wmax[0][1]) else '°C')]] -%}{%- endif -%}
    {%- if rain | length > 0 -%}{%- set op.p = op.p + [['降雨機率', rain[0]]] -%}{%- endif -%}
    {%- if uv != '' -%}{%- set op.p = op.p + [['紫外線', mk_txt(uv), mk_col(uv) | trim]] -%}{%- endif -%}
    {%- if aq != '' -%}{%- set op.p = op.p + [['空氣品質', mk_txt(aq), mk_col(aq) | trim]] -%}{%- endif -%}
    {%- if op.p | length > 0 -%}
      {%- set out.c = out.c + [cd_gray('戶外狀況', cd_grid(op.p, '#111827', 'sm') | from_json) | from_json] -%}
    {%- endif -%}
  {%- endif -%}
  {#- 氣象告警：燈號顏色＋竹南（紅）／苗栗（藍）／新竹（綠）標示；※ 提醒放在框內 -#}
  {%- if warn | length > 0 -%}
    {%- set wr = namespace(r=[], hot='#CA8A04', bg='#FFFBEB', bd='#FDE68A') -%}
    {%- for r in warn -%}
      {%- if r.k == '' -%}
        {%- set wr.r = wr.r + [{"type": "text", "text": r.v, "size": "xs", "wrap": true, "color": "#92400E"}] -%}
      {%- elif '燈號' in r.k -%}
        {%- set lc = '#DC2626' if '紅' in r.k else ('#EA580C' if '橙' in r.k else '#CA8A04') -%}
        {%- if '紅' in r.k -%}{%- set wr.hot = '#DC2626' -%}{%- set wr.bg = '#FEF2F2' -%}{%- set wr.bd = '#FCA5A5' -%}{%- elif '橙' in r.k and wr.hot != '#DC2626' -%}{%- set wr.hot = '#EA580C' -%}{%- set wr.bg = '#FFF7ED' -%}{%- set wr.bd = '#FDBA74' -%}{%- endif -%}
        {%- set wr.r = wr.r + [{"type": "box", "layout": "vertical", "spacing": "2px", "contents": [
              {"type": "text", "text": r.k, "size": "xxs", "weight": "bold", "color": lc},
              {"type": "text", "size": "sm", "wrap": true, "contents": (hl_spans(r.v, 'bold') | from_json([]))}]}] -%}
      {%- else -%}
        {%- set wr.r = wr.r + [ch_tile(r.k, r.v, '#111827', 'sm') | from_json] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- for tp in ns.tips -%}
      {%- set wr.r = wr.r + [{"type": "text", "size": "xs", "wrap": true, "color": "#92400E", "contents": (mspans(tp, '#92400E') | from_json([]))}] -%}
    {%- endfor -%}
    {%- set whead = {"type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px", "contents": [
          {"type": "image", "url": b2 ~ "weather_o.png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
          {"type": "text", "text": "氣象告警", "size": "xs", "weight": "bold", "color": "#92400E", "flex": 1}]} -%}
    {%- set out.c = out.c + [cd_box([whead] + wr.r, wr.bg, wr.bd, 'sm') | from_json] -%}
  {%- endif -%}
  {{- out.c | tojson -}}
{%- elif (not skip) and (joined | regex_search('鐵門已開啟超過')) -%}
  {#- V4.3.12：鐵門開著超過 N 分鐘（緊急）：紅色狀態框＋「接下來自動關門觀察」條件清單 -#}
  {%- set mn = (joined | regex_findall('超過\\s*(\\d+)\\s*分鐘') | first | default('10', true)) -%}
  {%- set tmm = joined | regex_findall('時間[：:]\\s*\\d{4}-(\\d{2})-(\\d{2})\\s+(\\d{2}:\\d{2})') -%}
  {%- set when = (tmm[0][0] ~ '/' ~ tmm[0][1] ~ ' ' ~ tmm[0][2]) if tmm | length > 0 else now().strftime('%m/%d %H:%M') -%}
  {%- set g = namespace(on=false, conds=[], win='2', note='') -%}
  {%- for l0 in lines -%}
    {%- set t0 = (l0 | string) | trim -%}
    {%- if t0 == '' -%}{%- set g.on = false -%}
    {%- elif t0.startswith('※') -%}{%- set g.on = false -%}{%- set g.note = t0[1:] | trim | regex_replace('^~\\s*', '') -%}
    {%- elif t0 | regex_search('^自動關門條件') -%}
      {%- set g.on = true -%}
      {%- set w = t0 | regex_findall('(\\d+)\\s*分鐘') -%}
      {%- if w | length > 0 -%}{%- set g.win = w[0] -%}{%- endif -%}
    {%- elif g.on -%}{%- set g.conds = g.conds + [clean(t0) | trim] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- set conds = g.conds if g.conds | length > 0 else ['無人車移動', '車庫主燈狀態未改變'] -%}
  {%- set tiles = cd_pair(ch_tile('提醒時間', when, '#111827', 'md') | from_json, ch_tile('目前狀態', '鐵門開啟中', '#DC2626', 'md') | from_json) | from_json -%}
  {%- set crow = namespace(r=[]) -%}
  {%- for c in conds -%}{%- set crow.r = crow.r + [cd_row('check_n', c, b2, '#374151', 'sm', true) | from_json] -%}{%- endfor -%}
  {%- set plan = cd_gray('接下來 ' ~ g.win ~ ' 分鐘觀察，符合下列條件就自動關門', crow.r) | from_json -%}
  {{- ([cd_hdr('gateopen_r', '鐵門未關', '已開逾 ' ~ mn ~ ' 分鐘', '#DC2626', b2) | from_json, cd_box([tiles], '#FEF2F2', '#FCA5A5') | from_json, plan] + ([cd_note(g.note) | from_json] if g.note != '' else [])) | tojson -}}
{%- elif (not skip) and (sig_h | regex_search('智慧保全通知|104-3')) and (joined | regex_search('鐵門自動關閉|提前關閉|自動關門')) -%}
  {#- V4.3.12：鐵門自動關門結果：提前關閉／已自動關門（綠）、取消本次自動關門（橘）-#}
  {%- set early = joined | regex_search('提前關閉') -%}
  {%- set cancel = (not early) and (joined | regex_search('取消')) -%}
  {%- set rs = joined | regex_findall('原因[：:]\\s*([^\\n。]+)') -%}
  {%- set reason = (rs[0] | trim) if rs | length > 0 else '' -%}
  {%- if cancel -%}
    {%- set nt = namespace(r=[]) -%}
    {%- for l0 in lines[1:] -%}
      {%- set l = clean(l0 | string) | regex_replace('^[ℹ⛔✅🤖🚪️\\s]+', '') | trim -%}
      {%- if l != '' and not (l | regex_search('^原因')) -%}{%- set nt.r = nt.r + [cd_row('info_n', l, b2, '#4B5563', 'xs') | from_json] -%}{%- endif -%}
    {%- endfor -%}
    {%- set main_box = cd_box([ch_tile('取消原因', (reason if reason != '' else '無法確認淨空'), '#C2410C', 'md') | from_json], '#FFF7ED', '#FED7AA') | from_json -%}
    {{- ([cd_hdr('gateopen_o', '已取消自動關門', '鐵門仍開著', '#EA580C', b2) | from_json, main_box] + ([cd_gray('說明', nt.r) | from_json] if nt.r | length > 0 else [])) | tojson -}}
  {%- elif early -%}
    {%- set tiles = cd_pair(ch_tile('結果', '已關閉', '#16A34A', 'md') | from_json, ch_tile('自動關門', '不執行', '#111827', 'md') | from_json) | from_json -%}
    {{- [cd_hdr('gate_g', '鐵門已關閉', '提前關閉', '#30D158', b2) | from_json, cd_box([tiles, cd_row('check_g', '觀察期內已先被關上', b2, '#374151', 'xs') | from_json], '#F0FDF4', '#86EFAC') | from_json] | tojson -}}
  {%- else -%}
    {%- set tiles = cd_pair(ch_tile('結果', '已關閉', '#16A34A', 'md') | from_json, ch_tile('方式', '系統自動關門', '#111827', 'md') | from_json) | from_json -%}
    {%- set crow = [cd_row('check_g', '觀察期內無人車移動', b2, '#374151', 'sm') | from_json, cd_row('check_g', '車庫主燈狀態未變化', b2, '#374151', 'sm') | from_json, cd_row('check_g', '車庫 AP 判定無人', b2, '#374151', 'sm') | from_json] -%}
    {{- [cd_hdr('gate_g', '鐵門已自動關閉', '自動關門', '#30D158', b2) | from_json, cd_box([tiles], '#F0FDF4', '#86EFAC') | from_json, cd_gray('關門前確認', crow) | from_json] | tojson -}}
  {%- endif -%}
{%- elif (not skip) and ('五樓保全' in sig_h or '五樓保全' in joined) and (joined | regex_search('闖入|有人員進入|已離開|無動靜')) -%}
  {#- V4.3.13：五樓保全：手動防守遭闖入（紅）／無人在家盯防有人進入（橘）／自動解除（綠） -#}
  {%- set mn = (joined | regex_findall('(\\d+)\\s*分鐘') | first | default('2', true)) -%}
  {%- if joined | regex_search('闖入') -%}
    {%- set bx = cd_grid([['防守模式', '手動強防禦'], ['判定方式', '跨線時間鏈']], '#111827', 'md') | from_json -%}
    {{- [cd_hdr('shieldoff_r', '五樓房間防區遭闖入', '手動防守中', '#DC2626', b2) | from_json,
         cd_box(bx + [{"type": "separator", "color": "#FCA5A5"}, cd_row('alarm_r', '已播放警報與語音警告', b2, '#B91C1C', 'sm', true) | from_json], '#FEF2F2', '#FCA5A5') | from_json,
         cd_call('camera_n', '請盡快確認五樓狀況；稍後補傳五樓攝影機短片', b2) | from_json] | tojson -}}
  {%- elif joined | regex_search('有人員進入') -%}
    {%- set bx = cd_grid([['防守模式', '自動盯防（無人在家）'], ['判定方式', '跨線時間鏈']], '#111827', 'md') | from_json -%}
    {{- [cd_hdr('shield_o', '五樓房間防區有人進入', '請確認', '#EA580C', b2) | from_json,
         cd_box(bx + [{"type": "separator", "color": "#FED7AA"}, cd_row('info_n', '只用跨線時間鏈判定，已避開一般感應器誤報', b2, '#4B5563', 'xs') | from_json], '#FFF7ED', '#FED7AA') | from_json,
         cd_call('camera_n', '稍後補傳五樓攝影機短片', b2) | from_json] | tojson -}}
  {%- else -%}
    {%- set bx = cd_grid([['解除原因', '防區 ' ~ mn ~ ' 分鐘無動靜'], ['目前狀態', '重新盯防中', '#15803D']], '#111827', 'md') | from_json -%}
    {{- [cd_hdr('shieldlock_g', '五樓警報已自動解除', '回復盯防', '#30D158', b2) | from_json,
         cd_box(bx + [{"type": "separator", "color": "#86EFAC"}, cd_row('check_g', '疑似人員已離開，警報已停止', b2, '#374151', 'sm') | from_json], '#F0FDF4', '#86EFAC') | from_json] | tojson -}}
  {%- endif -%}
{%- elif (not skip) and (joined | regex_search('地震預警系統作動')) -%}
  {#- V4.3.13：離家保全轉發的地震預警（管理者）：預估震度／抵達秒數，大於 4 級啟動緊急模式 -#}
  {%- set m = joined | regex_findall('預估地震\\s*([^\\s，,級]+)\\s*級[，,]\\s*([^\\s秒]+)\\s*秒') -%}
  {%- set lvq = m[0][0] if m | length > 0 else '未知' -%}
  {%- set sq = m[0][1] if m | length > 0 else '未知' -%}
  {%- set bx = cd_grid([['預估震度', lvq ~ ' 級', '#DC2626'], ['預計抵達', sq ~ ' 秒後']], '#111827', 'xl') | from_json -%}
  {{- [cd_hdr('quake_r', '地震預警系統作動', '緊急模式', '#DC2626', b2) | from_json,
       cd_box(bx + [{"type": "separator", "color": "#FCA5A5"}, cd_row('alarm_r', '預估大於 4 級，將啟動緊急模式因應', b2, '#B91C1C', 'sm', true) | from_json], '#FEF2F2', '#FCA5A5') | from_json] | tojson -}}
{%- elif (not skip) and ('離家保全' in sig_h) and (joined | regex_search('離家情境中')) -%}
  {#- V4.3.13：離家保全：鐵門開著（橘）／二樓門鎖被打開（紅）／兩者都開（紅） -#}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- set both = joined | regex_search('鐵門與.*門鎖') -%}
  {%- set lock = (not both) and (joined | regex_search('二樓門鎖')) -%}
  {%- if both -%}{%- set ic, ttl, bdg, what = 'alarm_r', '離家中鐵門與門鎖都開著', '緊急', '鐵門＋二樓門鎖' -%}
  {%- elif lock -%}{%- set ic, ttl, bdg, what = 'unlock_r', '離家中二樓門鎖被打開', '緊急', '二樓門鎖' -%}
  {%- else -%}{%- set ic, ttl, bdg, what = 'gateopen_o', '離家中鐵門開著', '請確認', '車庫鐵門' -%}{%- endif -%}
  {%- set red = both or lock -%}
  {%- set act = (joined | regex_findall('(請[^\\n。]+)') | first | default('請盡速確認現場狀況', true)) -%}
  {%- set bx = cd_grid([['異常項目', what, ('#DC2626' if red else '#C2410C')], ['目前情境', kv.get('目前情境', '--')]], '#111827', 'md') | from_json -%}
  {{- [cd_hdr(ic, ttl, bdg, ('#DC2626' if red else '#EA580C'), b2) | from_json,
       cd_box(bx, ('#FEF2F2' if red else '#FFF7ED'), ('#FCA5A5' if red else '#FED7AA')) | from_json,
       cd_call(('alarm_r' if red else 'announce_o'), act, b2, ('#B91C1C' if red else '#9A3412')) | from_json] | tojson -}}
{%- elif (not skip) and ('疑似入侵' in sig_h) and (joined | regex_search('入侵|測試通知')) -%}
  {#- V4.3.13：離家中疑似入侵：偵測時間、警報倒數、觸發感應器；家人回來的取消方式 -#}
  {%- set test = ('測試' in sig_h) or (joined | regex_search('這是測試通知')) -%}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- set tm = ch_when(kv.get('時間', '--')) | trim -%}
  {%- set cdn = joined | regex_findall('倒數[：:]\\s*⟦r:(\\d+)\\s*秒⟧') -%}
  {%- set bx = cd_grid([['偵測時間', tm], ['警報倒數', ((cdn[0] ~ ' 秒') if cdn | length > 0 else ('測試，不響警報' if test else '--')), '#DC2626']], '#111827', 'md') | from_json -%}
  {%- set rows = bx + [{"type": "separator", "color": "#FCA5A5"}, ch_tile('觸發的感應器', kv.get('觸發的感應器', '--'), '#111827', 'sm') | from_json] -%}
  {%- if cdn | length > 0 -%}
    {%- set rows = rows + [cd_row('alarm_r', cdn[0] ~ ' 秒後家裡仍沒有人，就會觸發網關警報', b2, '#B91C1C', 'xs', true) | from_json] -%}
  {%- endif -%}
  {{- ([cd_hdr('shieldoff_r', '疑似入侵', ('測試' if test else '離家中'), ('#6B7280' if test else '#DC2626'), b2) | from_json,
        cd_box(rows, '#FEF2F2', '#FCA5A5') | from_json,
        cd_call('homein_g', '家人回來了？到「家庭」App 點「早安」或「到家」情境就會取消，不會響警報', b2, '#15803D', '#F0FDF4') | from_json]
       + ([cd_note('這是測試通知，不會響警報。') | from_json] if test else [])) | tojson -}}
{%- elif (not skip) and (lines | length > 0) and ((clean(lines[0] | string) | trim) | regex_search('^門鎖電量(完全沒電|低於|\\s*35%)')) -%}
  {#- V4.3.13：客廳門鎖電量分級（0%／<5%／<15%／≤35%）：大字電量＋預估天數＋建議 -#}
  {%- set hd = clean(lines[0] | string) | trim -%}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- if hd | regex_search('^門鎖電量完全沒電') -%}{%- set ic, ttl, bdg, c1, bg, bd, dflt = 'battery_r', '門鎖完全沒電', '0%', '#DC2626', '#FEF2F2', '#FCA5A5', '0%' -%}
  {%- elif hd | regex_search('低於\\s*5%') -%}{%- set ic, ttl, bdg, c1, bg, bd, dflt = 'battery_r', '門鎖電量極低', '低於 5%', '#DC2626', '#FEF2F2', '#FCA5A5', '低於 5%' -%}
  {%- elif hd | regex_search('低於\\s*15%') -%}{%- set ic, ttl, bdg, c1, bg, bd, dflt = 'battery_o', '門鎖電量偏低', '低於 15%', '#EA580C', '#FFF7ED', '#FED7AA', '低於 15%' -%}
  {%- else -%}{%- set ic, ttl, bdg, c1, bg, bd, dflt = 'battery_o', '門鎖電量提醒', '35% 以下', '#CA8A04', '#FEFCE8', '#FDE047', '35% 以下' -%}{%- endif -%}
  {%- set adv = namespace(r=[]) -%}
  {%- for p in (hd | regex_replace('^[^，]*[，！!]?', '') | replace('！', '。')).split('。') if (p | trim) != '' and (p | trim) != '，' -%}
    {%- set adv.r = adv.r + [p | trim | regex_replace('^[，,]', '')] -%}
  {%- endfor -%}
  {%- for l in lines[1:] -%}
    {%- set c = clean(l | string) | trim -%}
    {%- if c == '' or '摘要' in c -%}{%- break -%}{%- endif -%}
    {%- set adv.r = adv.r + [c | regex_replace('。$', '')] -%}
  {%- endfor -%}
  {%- set bx = cd_grid([['目前電量', kv.get('客廳門鎖電量', dflt), c1], ['預估可用', kv.get('預估天數', '--')]], '#111827', 'lg') | from_json -%}
  {%- set ar = namespace(r=[]) -%}
  {%- for a in adv.r if a != '' -%}{%- set ar.r = ar.r + [cd_row(('alarm_r' if c1 == '#DC2626' else 'alarm_o'), a, b2, '#374151', 'sm') | from_json] -%}{%- endfor -%}
  {{- ([cd_hdr(ic, ttl, bdg, c1, b2) | from_json, cd_box(bx + ([{"type": "separator", "color": bd}] if ar.r | length > 0 else []) + ar.r, bg, bd) | from_json]
       + ([cd_gray('電池款式（當前／上次）', [{"type": "text", "text": kv.get('當前/上次款式'), "size": "sm", "weight": "bold", "color": "#111827", "wrap": true}]) | from_json] if kv.get('當前/上次款式') else [])) | tojson -}}
{%- elif (not skip) and (joined | regex_search('門鎖電量已由低回升')) -%}
  {#- V4.3.13：門鎖換電池完成（自動校正） -#}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- set bx = cd_grid([['新電池款式', kv.get('新電池款式', '--')], ['校正後日耗電率', kv.get('校正後日耗電率', '--')]], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('battery_g', '門鎖已換新電池', '已校正', '#30D158', b2) | from_json,
       cd_box(bx + [{"type": "separator", "color": "#86EFAC"}, cd_row('check_g', '電量回升到 80% 以上，視為已換電池', b2, '#374151', 'sm') | from_json, cd_row('check_g', '已更新校正款式與日耗電率，通知等級已重置', b2, '#374151', 'sm') | from_json], '#F0FDF4', '#86EFAC') | from_json] | tojson -}}
{%- elif (not skip) and (joined | regex_search('多個情境同時開啟')) -%}
  {#- V4.3.13：網關情境衝突（多個情境同時開啟）→ 已由在家情境接管 -#}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {{- [cd_hdr('shield_r', '網關情境衝突', '已自動處理', '#DC2626', b2) | from_json,
       cd_box([ch_tile('同時開啟的情境', kv.get('目前狀態', '--'), '#B91C1C', 'md') | from_json, {"type": "separator", "color": "#FCA5A5"},
               cd_row('check_g', '已改由「在家」情境接管', b2, '#374151', 'sm') | from_json, cd_row('check_g', '網關已同步回到在家警戒', b2, '#374151', 'sm') | from_json], '#FEF2F2', '#FCA5A5') | from_json] | tojson -}}
{%- elif (not skip) and (('Tesla' in sig_h) or ('充電器' in sig_h)) and (joined | regex_search('未開始充電|狀態異常|沒有在充電|充電通知測試')) -%}
  {#- V4.3.13：充電器異常類（仍未開始充電、充電器異常、插槍沒在充電、測試） -#}
  {%- set hd = clean(lines[0] | string) | trim -%}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- set test = '測試' in hd -%}
  {%- set err = '異常' in hd -%}
  {%- set cc = '#6B7280' if test else ('#DC2626' if err else '#EA580C') -%}
  {%- set bg, bd = ('#F3F4F6', '#E5E7EB') if test else (('#FEF2F2', '#FCA5A5') if err else ('#FFF7ED', '#FED7AA')) -%}
  {%- set st = st_zh(kv.get('目前狀態', '')) | trim -%}
  {%- set tm = ch_when(kv.get('通知時間', kv.get('測試時間', '--'))) | trim -%}
  {%- set pairs = [['目前狀態', st, ('#111827' if test else cc)], ['通知時間', tm]] -%}
  {%- if kv.get('充電器回報') -%}{%- set pairs = pairs + [['充電器回報', kv.get('充電器回報')]] -%}{%- endif -%}
  {%- if kv.get('充電車輛') -%}{%- set pairs = pairs + [['充電車輛', kv.get('充電車輛')]] -%}{%- endif -%}
  {%- set hv = kv.get('手把溫度', '') -%}{%- set mv = kv.get('MCU溫度', kv.get('MCU 溫度', '')) -%}{%- set pv = kv.get('PCB溫度', kv.get('PCB 溫度', '')) -%}
  {%- set rows = cd_grid(pairs, '#111827', 'md') | from_json -%}
  {%- set ex = namespace(r=[]) -%}
  {%- if kv.get('說明') -%}{%- set ex.r = ex.r + [cd_row('info_n', kv.get('說明'), b2, '#374151', 'sm') | from_json] -%}{%- endif -%}
  {%- if kv.get('可能原因') -%}{%- set ex.r = ex.r + [cd_row('info_n', '可能原因：' ~ kv.get('可能原因'), b2, '#374151', 'sm') | from_json] -%}{%- endif -%}
  {%- set out2 = [cd_hdr(('ev_n' if test else ('ev_r' if err else 'ev_o')), hd | regex_replace('^說明[：:].*$', ''), ('測試' if test else ('異常' if err else '請檢查')), cc, b2) | from_json,
                  cd_box(rows + ([{"type": "separator", "color": bd}] if ex.r | length > 0 else []) + ex.r, bg, bd) | from_json] -%}
  {%- if hv or mv or pv -%}
    {%- set out2 = out2 + [cd_gray('充電器溫度', [{"type": "box", "layout": "horizontal", "spacing": "md", "contents": [
          ch_tile('手把', (hv if hv else '--'), ch_temp_col(hv, 42, 50) | trim, 'sm') | from_json,
          ch_tile('MCU', (mv if mv else '--'), ch_temp_col(mv, 60, 75) | trim, 'sm') | from_json,
          ch_tile('PCB', (pv if pv else '--'), ch_temp_col(pv, 70, 85) | trim, 'sm') | from_json]}]) | from_json] -%}
  {%- endif -%}
  {{- out2 | tojson -}}
{%- elif (not skip) and (('門鈴' in sig_h) or (joined | regex_search('按門鈴'))) -%}
  {#- V4.3.13：大門門鈴：按鈴時間、家中人數（0 人標紅）；照片在卡片上方 -#}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- set tr = kv.get('觸發時間', '') -%}
  {%- set tt = (tr | regex_findall('(\\d{2}:\\d{2}:\\d{2})') | first | default(tr if tr else '--', true)) -%}
  {%- set n = (kv.get('目前家中成員數量', '') | regex_findall('\\d+') | first | default('', true)) -%}
  {%- set ntxt = ('家中無人' if n == '0' else (n ~ ' 人')) if n != '' else '--' -%}
  {%- set bx = cd_grid([['按鈴時間', tt], ['家中人數', ntxt, ('#DC2626' if n == '0' else '#111827')]], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('doorbell_o', '大門有人按門鈴', '請應門', '#EA580C', b2) | from_json, cd_box(bx, '#FFF7ED', '#FED7AA') | from_json,
       cd_call('camera_n', '請確認大門攝影機或應門', b2) | from_json] | tojson -}}
{%- elif (not skip) and (joined | regex_search('電風扇電源連線異常')) -%}
  {#- V4.3.13：客廳電風扇電源／連線異常 -#}
  {%- set bx = cd_grid([['裝置', '客廳電風扇'], ['狀態', '電源連線異常', '#C2410C']], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('fan_o', '客廳電風扇連線異常', '請確認', '#EA580C', b2) | from_json, cd_box(bx, '#FFF7ED', '#FED7AA') | from_json,
       cd_call('plug_n', '請確認電源與連線狀態', b2) | from_json] | tojson -}}
{%- elif (not skip) and (('LINE Bot' in sig_h) or ('Bot0' in sig_h) or ('所有 Bot' in sig_h)) and (joined | regex_search('Bot')) -%}
  {#- V4.3.13：LINE Bot 額度：自動切換／偏低／用盡 -#}
  {%- set sw = joined | regex_findall('Bot(\\d+)\\s*已達切換門檻，已自動改用\\s*Bot(\\d+)') -%}
  {%- set low = joined | regex_findall('Bot(\\d+)\\s*剩餘\\s*(\\d+)\\s*/\\s*(\\d+)\\s*次（已用\\s*(\\d+)）') -%}
  {%- if sw | length > 0 -%}
    {%- set bx = cd_grid([['原本使用', 'Bot' ~ sw[0][0]], ['改用', 'Bot' ~ sw[0][1] ~ ('（緊急）' if sw[0][1] == '0' else ''), '#2563EB']], '#111827', 'md') | from_json -%}
    {{- [cd_hdr('chat_o', 'LINE Bot 已自動切換', '額度門檻', '#EA580C', b2) | from_json, cd_box(bx, '#FFF7ED', '#FED7AA') | from_json] | tojson -}}
  {%- elif low | length > 0 -%}
    {%- set bx = cd_grid([['剩餘額度', low[0][1] ~ ' / ' ~ low[0][2], '#D97706'], ['已使用', low[0][3] ~ ' 次']], '#111827', 'md') | from_json -%}
    {{- [cd_hdr('chat_o', 'Bot' ~ low[0][0] ~ ' 額度偏低', '剩 ' ~ low[0][1] ~ ' 次', '#EA580C', b2) | from_json, cd_box(bx, '#FFF7ED', '#FED7AA') | from_json,
         cd_call('key_n', '請預備更換 Token', b2) | from_json] | tojson -}}
  {%- else -%}
    {%- set hd = clean(lines[0] | string) | trim -%}
    {%- set parts = hd.split('，') -%}
    {%- set callt = (parts[-1] | regex_replace('。$', '')) if (parts | length > 1 and parts[-1] | regex_search('^請')) else '' -%}
    {%- set body = (parts[:-1] | join('，')) if callt else (hd | regex_replace('。$', '')) -%}
    {{- ([cd_hdr('chat_r', ((title | string) if (title | string | trim) != '' else 'LINE Bot 額度用盡'), '已用盡', '#DC2626', b2) | from_json,
          cd_box([cd_row('alarm_r', body, b2, '#B91C1C', 'sm', true) | from_json], '#FEF2F2', '#FCA5A5') | from_json]
         + ([cd_call('key_r', callt, b2, '#B91C1C') | from_json] if callt else [])) | tojson -}}
  {%- endif -%}
{%- elif (not skip) and ('濾芯' in sig_h) and (joined | regex_search('濾芯壽命剩')) -%}
  {#- V4.3.13：空氣清淨機濾芯需更換 -#}
  {%- set m = joined | regex_findall('壽命剩\\s*(\\d+)%（已使用\\s*([0-9.]+)\\s*小時）') -%}
  {%- set lf = (m[0][0] ~ '%') if m | length > 0 else '--' -%}
  {%- set us = (m[0][1] ~ ' 小時') if m | length > 0 else '--' -%}
  {%- set bx = cd_grid([['濾芯壽命', lf, '#C2410C'], ['已使用', us]], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('air_o', '空氣清淨機濾芯需更換', '剩 ' ~ lf, '#EA580C', b2) | from_json,
       cd_box(bx + [{"type": "separator", "color": "#FED7AA"}, cd_row('tool_o', '請更換濾芯', b2, '#374151', 'sm', true) | from_json], '#FFF7ED', '#FED7AA') | from_json,
       cd_note('此提醒只通知一次；換好後壽命回升會自動重置。') | from_json] | tojson -}}
{%- elif (not skip) and (sig_h | regex_search('裝置電量緊急|請更換電池|準備電池備品')) -%}
  {#- V4.3.13：耗材電量分級（緊急／請更換／準備備品） -#}
  {%- set hd = clean(lines[0] | string) | trim -%}
  {%- set m = hd | regex_findall('^(.+?)\\s*電量\\s*(\\d+)\\s*%') -%}
  {%- set nm = m[0][0] if m | length > 0 else '裝置' -%}
  {%- set v = (m[0][1] ~ '%') if m | length > 0 else '--' -%}
  {%- set kv = kv_of(lines) | from_json({}) -%}
  {%- if '緊急' in sig_h -%}{%- set ic, bdg, cc, bg, bd = 'battery_r', '電量緊急', '#DC2626', '#FEF2F2', '#FCA5A5' -%}
  {%- elif '請更換' in sig_h -%}{%- set ic, bdg, cc, bg, bd = 'battery_o', '請更換電池', '#EA580C', '#FFF7ED', '#FED7AA' -%}
  {%- else -%}{%- set ic, bdg, cc, bg, bd = 'battery_o', '準備備品', '#CA8A04', '#FEFCE8', '#FDE047' -%}{%- endif -%}
  {%- set age = joined | regex_findall('（資料\\s*(\\d+)\\s*天前）') -%}
  {%- set adv = (joined | regex_findall('((?:請|電量偏低)[^。\\n（]*)') | first | default('', true)) -%}
  {%- set bx = cd_grid([['目前電量', v, cc], ['預估還能用', kv.get('預估還能用', '--')]], '#111827', 'lg') | from_json -%}
  {{- ([cd_hdr(ic, nm, bdg, cc, b2) | from_json, cd_box(bx + ([{"type": "separator", "color": bd}, cd_row(('alarm_r' if cc == '#DC2626' else 'alarm_o'), adv, b2, '#374151', 'sm', true) | from_json] if adv else []), bg, bd) | from_json]
       + ([cd_note('電量資料為 ' ~ age[0] ~ ' 天前的最後讀數') | from_json] if age | length > 0 else [])) | tojson -}}
{%- elif (not skip) and (sig_h | regex_search('空氣品質嚴重變差|空氣品質非常差')) -%}
  {#- V4.3.13：空氣清淨機整合：空氣品質嚴重變差／非常差 -#}
  {%- set pm = joined | regex_findall('PM2\\.5\\s*(\\d+)') | first | default('', true) -%}
  {%- set very = '非常差' in sig_h -%}
  {%- set tg = (env_tag('pm', pm) | trim)[1:2] if pm != '' else 'o' -%}
  {%- set tip = namespace(t='') -%}
  {%- for l in lines[1:] -%}{%- set c = clean(l | string) | trim -%}{%- if c != '' and tip.t == '' -%}{%- set tip.t = c | regex_replace('。$', '') -%}{%- endif -%}{%- endfor -%}
  {%- set bx = cd_grid([['PM2.5', (pm ~ ' μg/m³') if pm else '--', tag_col(tg) | trim], ['空氣清淨機', ('已加強運作' if very else '已自動運作'), '#16A34A']], '#111827', 'md') | from_json -%}
  {{- ([cd_hdr(('air_r' if very else 'air_o'), ('空氣品質非常差' if very else '空氣品質變差'), 'PM2.5 ' ~ (pm if pm else '--'), ('#DC2626' if very else '#EA580C'), b2) | from_json,
        cd_box(bx, ('#FEF2F2' if very else '#FFF7ED'), ('#FCA5A5' if very else '#FED7AA')) | from_json]
       + ([cd_call('air_n', tip.t, b2) | from_json] if tip.t else [])) | tojson -}}
{%- elif (not skip) and ('一氧化碳危險' in sig_h) and ('緊急模式' in sig_h) -%}
  {#- V4.3.13：一氧化碳危險 → 已啟動緊急模式 -#}
  {%- set al = joined | regex_findall('一氧化碳危險（([^）]+)）') | first | default('一氧化碳感測器', true) -%}
  {%- set bx = cd_grid([['偵測來源', al], ['系統處置', '已啟動緊急模式', '#DC2626']], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('alarm_r', '一氧化碳危險', '緊急模式', '#DC2626', b2) | from_json, cd_box(bx, '#FEF2F2', '#FCA5A5') | from_json,
       cd_call('alarm_r', '請立即確認現場，離開並開窗通風', b2, '#B91C1C', '#FEF2F2') | from_json] | tojson -}}
{%- elif (not skip) and ('06環境異常' in sig_h) -%}
  {#- V4.3.13：環境異常（廚房感測器、戶外空氣、失聯）：重點句＋各段讀數兩欄格（紅黃綠沿用原標記） -#}
  {%- set e = namespace(sec='', lead=[], secs=[], cur=[], notes=[]) -%}
  {%- for l0 in lines -%}
    {%- set t0 = (l0 | string) | trim -%}
    {%- if t0 == '' -%}
    {%- elif t0.startswith('※') -%}{%- set e.notes = e.notes + [t0[1:] | trim | regex_replace('^~\\s*', '')] -%}
    {%- elif t0 | regex_search('^[^：:。，]{1,8}[：:]$') -%}
      {%- if e.sec != '' and e.cur | length > 0 -%}{%- set e.secs = e.secs + [{'t': e.sec, 'r': e.cur}] -%}{%- endif -%}
      {%- set e.sec = t0[:-1] -%}{%- set e.cur = [] -%}
    {%- elif e.sec != '' -%}
      {%- set m = t0 | regex_findall('^([^：:]{1,12})[：:]\\s*(.+?)\\s*(?:⟦([rog])⟧)?\\s*$') -%}
      {%- if t0.startswith('超過門檻') and e.cur | length > 0 -%}
        {%- set e.cur = e.cur[:-1] + [dict(e.cur[-1], th=(t0 | replace('超過門檻', '') | trim))] -%}
      {%- elif m | length > 0 -%}{%- set e.cur = e.cur + [{'k': m[0][0], 'v': m[0][1], 'c': m[0][2], 'th': ''}] -%}
      {%- else -%}{%- set e.cur = e.cur + [{'k': '', 'v': t0, 'c': '', 'th': ''}] -%}
      {%- endif -%}
    {%- else -%}{%- set e.lead = e.lead + [t0] -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if e.sec != '' and e.cur | length > 0 -%}{%- set e.secs = e.secs + [{'t': e.sec, 'r': e.cur}] -%}{%- endif -%}
  {%- set tl = title | string -%}
  {%- set ic = 'alarm' if '一氧化碳' in tl else ('thermo' if '溫度' in tl else ('humid' if '濕度' in tl else ('network' if (joined | regex_search('失聯')) else 'air'))) -%}
  {%- set tn = 'r' if lv == 'emergency' else 'o' -%}
  {%- set cc, bg, bd = ('#DC2626', '#FEF2F2', '#FCA5A5') if tn == 'r' else ('#EA580C', '#FFF7ED', '#FED7AA') -%}
  {%- set bdg = '失聯' if (joined | regex_search('失聯')) else {'emergency': '危險', 'important': '警示'}.get(lv, '注意') -%}
  {%- set lr = namespace(r=[]) -%}
  {%- for s in e.lead -%}{%- for p in s.split('。') if (p | trim) != '' -%}
    {%- set lr.r = lr.r + [{"type": "text", "size": "sm", "wrap": true, "color": "#111827", "weight": ("bold" if lr.r | length == 0 else "regular"), "contents": (mspans((p | trim) ~ '。', '#111827') | from_json([]))}] -%}
  {%- endfor -%}{%- endfor -%}
  {%- set out3 = namespace(c=[cd_hdr(ic ~ '_' ~ tn, tl, bdg, cc, b2) | from_json]) -%}
  {%- if lr.r | length > 0 -%}{%- set out3.c = out3.c + [cd_box(lr.r, bg, bd) | from_json] -%}{%- endif -%}
  {%- for s in e.secs -%}
    {%- set pr = namespace(p=[], t=[]) -%}
    {%- for r in s.r -%}
      {%- if r.k != '' -%}{%- set pr.p = pr.p + [[r.k ~ (('（門檻 ' ~ r.th ~ '）') if r.th else ''), r.v, tag_col(r.c) | trim]] -%}
      {%- else -%}{%- set pr.t = pr.t + [{"type": "text", "text": r.v, "size": "xs", "wrap": true, "color": "#374151"}] -%}{%- endif -%}
    {%- endfor -%}
    {%- set out3.c = out3.c + [cd_gray(s.t, (cd_grid(pr.p, '#111827', 'sm') | from_json) + pr.t) | from_json] -%}
  {%- endfor -%}
  {%- for n in e.notes -%}{%- set out3.c = out3.c + [cd_note(n | regex_replace('⟦[rogn]:([^⟧]*)⟧', '\\1')) | from_json] -%}{%- endfor -%}
  {{- out3.c | tojson -}}
{%- elif (not skip) and ('情境檢查' in sig_h) and (joined | regex_search('仍未到位')) -%}
  {#- V4.3.13：情境補救後仍未到位的裝置清單 -#}
  {%- set hd = clean(lines[0] | string) | trim -%}
  {%- set sc = hd | regex_findall('^(.+?)情境') | first | default('', true) -%}
  {%- set it = namespace(r=[]) -%}
  {%- for l in lines[1:] -%}
    {%- for p in (clean(l | string) | trim).split('、') if (p | trim) != '' -%}
      {%- set it.r = it.r + [cd_row('alarm_o', p | trim, b2, '#374151', 'sm') | from_json] -%}
    {%- endfor -%}
  {%- endfor -%}
  {{- [cd_hdr('gear_o', (sc ~ '情境未完全到位'), '請留意', '#EA580C', b2) | from_json,
       cd_box([{"type": "text", "text": "已自動補救，仍未到位：", "size": "xxs", "weight": "bold", "color": "#9A3412"}] + (it.r if it.r | length > 0 else [cd_row('alarm_o', '（沒有列出裝置）', b2, '#374151', 'sm') | from_json]), '#FFF7ED', '#FED7AA') | from_json] | tojson -}}
{%- elif (not skip) and ('鐵門開超過' in sig_h) and (joined | regex_search('不會再自動關門|不符合自動關門條件')) -%}
  {#- V4.3.13：鐵門重試關門 2 小時仍未關（交給人工） -#}
  {%- set n = joined | regex_findall('已重試\\s*(\\d+)\\s*次') | first | default('--', true) -%}
  {%- set hr = joined | regex_findall('約\\s*(\\d+)\\s*小時') | first | default('2', true) -%}
  {%- set why = joined | regex_findall('條件（([^）]+)）') | first | default('', true) -%}
  {%- set bx = cd_grid([['已重試關門', n ~ ' 次'], ['結果', '仍不符合條件', '#C2410C']], '#111827', 'md') | from_json -%}
  {{- ([cd_hdr('gateopen_o', '鐵門仍開著', '已開逾 ' ~ hr ~ ' 小時', '#EA580C', b2) | from_json,
        cd_box(bx + ([{"type": "separator", "color": "#FED7AA"}, ch_tile('沒關的原因', why, '#111827', 'sm') | from_json] if why else []), '#FFF7ED', '#FED7AA') | from_json,
        cd_call('person_n', '系統不會再自動關門，請自己關門', b2) | from_json,
        cd_note('若是刻意開著工作，忽略即可。') | from_json]) | tojson -}}
{%- elif (not skip) and ('地震詳情' in sig_h) -%}
  {#- V4.3.13：地震詳情（氣象署報告）：規模、最大震度、深度、時間、震央、各縣市震度（竹南紅／苗栗藍／新竹綠） -#}
  {%- set test = '【測試】' in joined -%}
  {%- set tm = joined | regex_findall('發生時間\\s*([^）)\\n]+)') | first | default('--', true) -%}
  {%- set mg = joined | regex_findall('規模[：:]\\s*([0-9.]+)') | first | default('--', true) -%}
  {%- set dp = joined | regex_findall('深度[：:]\\s*([0-9.]+)') | first | default('--', true) -%}
  {%- set mx = joined | regex_findall('最大震度[：:]\\s*([^\\n]+)') | first | default('--', true) | trim -%}
  {%- set ep = joined | regex_findall('震央[：:]\\s*([^（(\\n]+)') | first | default('--', true) | trim -%}
  {%- set ar = joined | regex_findall('各縣市震度[：:]\\s*([^\\n]+)') | first | default('', true) -%}
  {%- set mi = (mx | regex_findall('\\d+') | first | default('0', true)) | int(0) -%}
  {%- set cc, bg, bd, ic = ('#DC2626', '#FEF2F2', '#FCA5A5', 'quake_r') if mi >= 4 else (('#EA580C', '#FFF7ED', '#FED7AA', 'quake_o') if mi == 3 else ('#2563EB', '#EFF6FF', '#BFDBFE', 'quake_n')) -%}
  {%- set bx = cd_grid([['規模', mg, cc], ['最大震度', mx, cc], ['深度', dp ~ ' 公里'], ['發生時間', ch_when(tm) | trim]], '#111827', 'md') | from_json -%}
  {%- set out4 = [cd_hdr(ic, '地震報告', ('測試' if test else ('最大 ' ~ mx)), ('#6B7280' if test else cc), b2) | from_json,
                  cd_box(bx + [{"type": "separator", "color": bd}, ch_tile('震央', ep, '#111827', 'sm') | from_json], bg, bd) | from_json] -%}
  {%- if ar -%}
    {%- set out4 = out4 + [cd_gray('各縣市震度', [{"type": "text", "size": "sm", "wrap": true, "lineSpacing": "4px", "contents": (hl_spans(ar, 'regular') | from_json([]))}]) | from_json] -%}
  {%- endif -%}
  {{- out4 | tojson -}}
{%- elif (not skip) and (joined | regex_search('二樓大門沒有完全關閉|二樓大門未完全關閉|虛掩狀態')) -%}
  {#- V4.3.15：二樓門鎖虛掩警告（重要）：門沒有完全關好 -#}
  {%- set bx = cd_grid([['門', '二樓大門'], ['狀態', '虛掩（沒有完全關好）', '#C2410C']], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('door_o', '二樓大門虛掩', '請注意', '#EA580C', b2) | from_json,
       cd_box(bx, '#FFF7ED', '#FED7AA') | from_json,
       cd_call('lock_o', '請到門口確認，把門關好並上鎖', b2, '#9A3412') | from_json] | tojson -}}
{%- elif (not skip) and (joined | regex_search('鐵門連線狀態不穩')) -%}
  {#- V4.3.15：鐵門連線狀態不穩（一般） -#}
  {%- set bx = cd_grid([['裝置', '車庫鐵門'], ['狀態', '連線不穩', '#C2410C']], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('network_o', '鐵門連線不穩', '請注意', '#EA580C', b2) | from_json,
       cd_box(bx, '#FFF7ED', '#FED7AA') | from_json,
       cd_call('gate_n', '請以鐵門現場實際狀況為準', b2) | from_json] | tojson -}}
{%- elif (not skip) and (joined | regex_search('緊急模式已被啟動')) -%}
  {#- V4.3.15：05A 緊急模式（舊版通知）：所有照明開啟、電源關閉 -#}
  {{- [cd_hdr('alarm_r', '緊急模式已啟動', '緊急', '#DC2626', b2) | from_json,
       cd_box([cd_row('check_g', '所有照明已開啟', b2, '#374151', 'sm', true) | from_json, cd_row('check_g', '電源已關閉', b2, '#374151', 'sm', true) | from_json], '#FEF2F2', '#FCA5A5') | from_json,
       cd_call('alarm_r', '請保持冷靜，確認家人安全', b2, '#B91C1C', '#FEF2F2') | from_json] | tojson -}}
{%- elif (not skip) and (joined | regex_search('將在五分鐘後進行維護更新')) -%}
  {#- V4.3.15：伺服器及網路系統維護更新預告 -#}
  {%- set bx = cd_grid([['開始時間', '5 分鐘後', '#C2410C'], ['預計影響', '約 15～20 分鐘']], '#111827', 'md') | from_json -%}
  {{- [cd_hdr('server_o', '系統即將維護更新', '5 分鐘後', '#EA580C', b2) | from_json,
       cd_box(bx + [{"type": "separator", "color": "#FED7AA"}, cd_row('network_o', '伺服器及網路系統連線不穩或斷線', b2, '#374151', 'sm') | from_json], '#FFF7ED', '#FED7AA') | from_json] | tojson -}}
{%- elif (not skip) and (('通知測試' in sig_h) and (joined | regex_search('測試通知'))) -%}
  {#- V4.3.15：通知測試（資訊／一般／重要／緊急）：各級顏色、列出測試項目 -#}
  {%- set cc, bg, bd, lb = {'info': ('#6B7280', '#F3F4F6', '#E5E7EB', '資訊'), 'general': ('#2563EB', '#EFF6FF', '#BFDBFE', '一般'), 'important': ('#EA580C', '#FFF7ED', '#FED7AA', '重要'), 'emergency': ('#DC2626', '#FEF2F2', '#FCA5A5', '緊急')}.get(lv, ('#2563EB', '#EFF6FF', '#BFDBFE', '一般')) -%}
  {%- set tr = namespace(r=[]) -%}
  {%- for l in lines[1:] -%}
    {%- set c = clean(l | string) | trim -%}
    {%- if c != '' -%}{%- set tr.r = tr.r + [cd_row('check_n', (c | regex_replace('^項目[一二三四五六七八九十]+[：:]\\s*', '')), b2, '#374151', 'sm') | from_json] -%}{%- endif -%}
  {%- endfor -%}
  {{- [cd_hdr('bell_' ~ ({'info': 'n', 'general': 'n', 'important': 'o', 'emergency': 'r'}.get(lv, 'n')), lb ~ '級通知測試', '測試', cc, b2) | from_json, cd_box(tr.r if tr.r | length > 0 else [cd_row('check_n', '通知測試', b2, '#374151', 'sm') | from_json], bg, bd) | from_json] | tojson -}}
{%- elif (not skip) and (('系統通知訊息' in sig_h) or ('手動通知' in sig_h)) -%}
  {#- V4.3.15：手動通知（自動化管理面板輸入的文字）：依重要性上色，每行一段，不換行破版 -#}
  {%- set cc, bg, bd, lb, ic = {'general': ('#2563EB', '#EFF6FF', '#BFDBFE', '一般', 'announce_n'), 'important': ('#EA580C', '#FFF7ED', '#FED7AA', '重要', 'announce_o'), 'emergency': ('#DC2626', '#FEF2F2', '#FCA5A5', '緊急', 'alarm_r')}.get(lv, ('#2563EB', '#EFF6FF', '#BFDBFE', '一般', 'announce_n')) -%}
  {%- set mr = namespace(r=[]) -%}
  {%- for l in lines -%}
    {%- set c = (l | string) | trim -%}
    {%- if c != '' -%}{%- set mr.r = mr.r + [{"type": "text", "text": c, "size": "sm", "wrap": true, "color": "#111827", "lineSpacing": "4px", "weight": ("bold" if mr.r | length == 0 else "regular")}] -%}{%- endif -%}
  {%- endfor -%}
  {{- [cd_hdr(ic, '系統通知', '手動・' ~ lb, cc, b2) | from_json, cd_box(mr.r if mr.r | length > 0 else [{"type": "text", "text": "（沒有內容）", "size": "sm", "color": "#6B7280"}], bg, bd) | from_json] | tojson -}}
{%- elif (not skip) and ('地震預警' in sig_h) -%}
  {%- set m_lv = joined | regex_findall('預估(?:地震|震度)[：:\\s]*([^，,\\n級]+)\\s*級') -%}
  {%- set m_sec = joined | regex_findall('([\\d]+|未知)\\s*秒後') -%}
  {%- set lv_raw = (m_lv[0] | trim) if m_lv | length > 0 else states('input_text.line_eew_remote_level') -%}
  {%- set sec_raw = (m_sec[0] | trim) if m_sec | length > 0 else states('input_text.line_eew_remote_seconds') -%}
  {%- set lv_s = lv_raw if (lv_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set sec_s = sec_raw if (sec_raw | trim) not in ['', 'unknown', 'unavailable', 'none', 'None'] else '未知' -%}
  {%- set lv_num = (lv_s | regex_findall('\\d+') | first | default('0', true)) | int(0) -%}
  {%- set lv_disp = lv_s if ('級' in lv_s or '弱' in lv_s or '強' in lv_s or lv_s == '未知') else (lv_s ~ ' 級') -%}
  {%- set sec_disp = sec_s if ('秒' in sec_s or sec_s == '未知') else (sec_s ~ ' 秒後') -%}
  {%- if lv_num >= 4 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '緊急避難', '#FF453A', '#FEF2F2', '#FCA5A5', '#DC2626', 'quake_r' -%}
    {%- set act_ic, act_col, act_t, act_d = 'shield_r', '#DC2626', '已啟動緊急模式與全宅廣播', '預估震度達 4 級以上，系統自動開啟全室照明並關閉危險電源。' -%}
    {%- set guide = '請保持冷靜，立即就地趴下、掩護、穩住並抓住桌腳，保護頭頸部！' -%}
  {%- elif lv_num == 3 -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '有感警戒', '#FF9F0A', '#FFF7ED', '#FDBA74', '#EA580C', 'quake_o' -%}
    {%- set act_ic, act_col, act_t, act_d = 'speaker_o', '#D97706', '已啟動全宅語音廣播提醒', '預估震度 3 級，本次啟動語音廣播提醒（未達 4 級緊急模式門檻）。' -%}
    {%- set guide = '請注意搖晃，立即就地趴下、掩護、穩住，保護頭頸部。' -%}
  {%- else -%}
    {%- set badge, b_col, box_bg, box_bd, val_col, q_ic = '輕微有感', '#F59E0B', '#FEFCE8', '#FDE047', '#D97706', 'quake_o' -%}
    {%- set act_ic, act_col, act_t, act_d = 'announce_n', '#4B5563', '僅發送預警通知', '目前未達廣播門檻（3 級）與緊急模式門檻（4 級）。' -%}
    {%- set guide = '' -%}
  {%- endif -%}
  {%- set hdr_row = {
    "type": "box", "layout": "horizontal", "alignItems": "center", "spacing": "6px",
    "contents": [
      {"type": "image", "url": b2 ~ q_ic ~ ".png?v=1", "size": "20px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": "地震預警速報", "weight": "bold", "size": "md", "color": "#111827", "flex": 1, "wrap": true},
      {"type": "box", "layout": "vertical", "backgroundColor": b_col, "cornerRadius": "99px", "paddingTop": "3px", "paddingBottom": "3px", "paddingStart": "10px", "paddingEnd": "10px", "flex": 0,
       "contents": [{"type": "text", "text": badge, "size": "xxs", "weight": "bold", "color": "#FFFFFF"}]}
    ]} -%}
  {%- set grid_box = {
    "type": "box", "layout": "horizontal", "backgroundColor": box_bg, "borderColor": box_bd, "borderWidth": "1px", "cornerRadius": "12px", "paddingAll": "12px", "margin": "md", "spacing": "md", "alignItems": "center",
    "contents": [
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px",
       "contents": [
         {"type": "text", "text": "預估震度", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": lv_disp, "size": "3xl", "weight": "bold", "color": val_col, "wrap": true}
       ]},
      {"type": "separator", "color": box_bd},
      {"type": "box", "layout": "vertical", "flex": 1, "spacing": "2px", "paddingStart": "8px",
       "contents": [
         {"type": "text", "text": "預計抵達", "size": "xxs", "color": "#6B7280"},
         {"type": "text", "text": sec_disp, "size": "3xl", "weight": "bold", "color": "#111827", "wrap": true}
       ]}
    ]} -%}
  {%- set act_box = {
    "type": "box", "layout": "vertical", "backgroundColor": "#F3F4F6", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "4px",
    "contents": [
      {"type": "box", "layout": "horizontal", "spacing": "6px", "alignItems": "center",
       "contents": [
         {"type": "image", "url": b2 ~ act_ic ~ ".png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
         {"type": "text", "text": act_t, "size": "xs", "weight": "bold", "color": act_col, "flex": 1, "wrap": true}
       ]},
      {"type": "text", "text": act_d, "size": "xxs", "color": "#4B5563", "wrap": true, "lineSpacing": "3px"}
    ]} -%}
  {%- set guide_box = ([{
    "type": "box", "layout": "horizontal", "backgroundColor": "#FEF2F2", "borderColor": "#FCA5A5", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "flex-start",
    "contents": [
      {"type": "image", "url": b2 ~ "alarm_r.png?v=1", "size": "16px", "aspectRatio": "1:1", "aspectMode": "fit", "flex": 0},
      {"type": "text", "text": guide, "size": "xs", "weight": "bold", "color": "#B91C1C", "flex": 1, "wrap": true, "lineSpacing": "3px"}
    ]}] if guide else []) -%}
  {%- set m_ep = joined | regex_findall('預估震央[：:]\\s*([^\\n]+)') -%}
  {%- set ep_box = ([{
    "type": "box", "layout": "horizontal", "backgroundColor": "#EFF6FF", "borderColor": "#BFDBFE", "borderWidth": "1px", "cornerRadius": "10px", "paddingAll": "10px", "margin": "sm", "spacing": "6px", "alignItems": "center",
    "contents": [
      {"type": "text", "text": "預估震央", "size": "xs", "color": "#6B7280", "flex": 0},
      {"type": "text", "text": (m_ep[0] | trim), "size": "sm", "weight": "bold", "color": "#1E3A8A", "flex": 1, "wrap": true}
    ]}] if m_ep | length > 0 else []) -%}
  {{- ([hdr_row, grid_box] + ep_box + [act_box] + guide_box) | tojson -}}
{%- elif (not skip) and ('緊急模式啟動' in (title | string) or '緊急模式仍在啟動' in (title | string)) -%}
  {#- V4.2.3：緊急模式專用卡片（05B）：狀態、觸發來源、請確認、還原方式四塊，取代原本 4 個泡泡的長文字 -#}
