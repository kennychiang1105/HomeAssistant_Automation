{# ──────────────────────────────────────────────────────
   通知內文排版 (V4.1.6)：LINE Flex 與 HA 通知共用同一份「行模型」，版面一致。
   - V4.1.6：圖示只放在「小標題（冒號結尾）」「名稱：數值」與「警告」行（標題行不放，保持單行）；圖示顏色依重要度（紅=緊急、橘=警告、綠=正常完成、藍=一般），共 70 款（www/icons/b2/<名稱>_<n|g|o|r>.png）（警告、異常、未關、未上鎖、離線、不穩…），一般項目不放圖示以免干擾閱讀；
             「名稱：數值」拆成灰色小字名稱＋粗體數值（例如 客廳門鎖電量　76%）；一般句子用正常粗細。
   - V4.1.0（已被上一行取代）：每一個項目行都有圖示。
   - 「名稱：舊版 → 新版」與「名稱：V1.2.3」一律拆成兩行：名稱一行、版本獨立一行（舊版灰色、新版綠色粗體）。
   - 每個項目之間空一行（margin）；【小標題】獨立成行、藍色粗體；第一行是通知重點（粗體、較大）。
   用法：{% from 'notify_body.jinja' import flex_rows, md_lines %}
   圖示檔：/local/icons/b/<name>.png（96px）。新增圖示或關鍵字時修改本檔後執行 homeassistant.reload_custom_templates。
   ────────────────────────────────────────────────────── #}
{% macro pick(t) -%}
{%- if t | regex_search('門鈴') -%}doorbell
{%- elif t | regex_search('電量|電池|耗材|濾網') -%}battery
{%- elif t | regex_search('離家|外出|出門') -%}homeout
{%- elif t | regex_search('到家|回家|返家') -%}homein
{%- elif t | regex_search('解鎖|開鎖|已開鎖') -%}unlock
{%- elif t | regex_search('指紋|密碼|鑰匙|卡片') -%}key
{%- elif t | regex_search('門鎖|上鎖|已鎖|未鎖') -%}lock
{%- elif t | regex_search('天數|日期|星期|今天|明天|本週|週報') -%}calendar
{%- elif t | regex_search('預估|倒數|分鐘|等待|秒後|逾時|剩餘') -%}hourglass
{%- elif t | regex_search('\d{1,2}:\d{2}|時間|時刻') -%}clock
{%- elif t | regex_search('溫度|°C|體感') -%}thermo
{%- elif t | regex_search('冷氣|空調|暖氣') -%}ac
{%- elif t | regex_search('濕度') -%}humid
{%- elif t | regex_search('降雨|豪雨|下雨|水位|洩洪|漏水') -%}drop
{%- elif t | regex_search('PM2|PM1|空氣|清淨機|CO2|二氧化碳|一氧化碳') -%}air
{%- elif t | regex_search('風扇|風速') -%}fan
{%- elif t | regex_search('鐵門|車庫') and t | regex_search('開啟|打開|未關|沒關|開著') -%}gateopen
{%- elif t | regex_search('鐵門|車庫') -%}gate
{%- elif t | regex_search('Tesla|充電|充電樁') -%}ev
{%- elif t | regex_search('電壓|電流|功率|用電|耗電|插座') -%}plug
{%- elif t | regex_search('車牌|車輛|汽車|車子') -%}car
{%- elif t | regex_search('影片|錄影') -%}video
{%- elif t | regex_search('攝影|影像|截圖|監視') -%}camera
{%- elif t | regex_search('地震|震度|規模') -%}quake
{%- elif t | regex_search('颱風|氣象|天氣|豪雨') -%}weather
{%- elif t | regex_search('日出|日落|白天|早安') -%}sun
{%- elif t | regex_search('晚安|夜間|深夜') -%}moon
{%- elif t | regex_search('熟睡|睡眠|睡') -%}bed
{%- elif t | regex_search('闖入|入侵') -%}shieldoff
{%- elif t | regex_search('警戒|布防|撤防') -%}shieldlock
{%- elif t | regex_search('保全|防區') -%}shield
{%- elif t | regex_search('警報') -%}alarm
{%- elif t | regex_search('路由|AP|Wi-Fi|WiFi') -%}router
{%- elif t | regex_search('伺服器|主機|NAS') -%}server
{%- elif t | regex_search('網路|網關|連線|離線|斷線') -%}network
{%- elif t | regex_search('麥克風') -%}mic
{%- elif t | regex_search('廣播|喇叭|語音|HomePod') -%}speaker
{%- elif t | regex_search('電視') -%}tv
{%- elif t | regex_search('燈') -%}bulb
{%- elif t | regex_search('感應|移動|偵測|動作') -%}motion
{%- elif t | regex_search('家人|人員|所有人|成員') -%}people
{%- elif t | regex_search('在家|有人|人物') -%}person
{%- elif t | regex_search('樓梯') -%}stairs
{%- elif t | regex_search('客廳') -%}sofa
{%- elif t | regex_search('臥室|房間') -%}bed
{%- elif t | regex_search('廁所|浴室') -%}toilet
{%- elif t | regex_search('廚房') -%}kitchen
{%- elif t | regex_search('大門|房門|門') -%}door
{%- elif t | regex_search('手機|平板|iPhone|iPad') -%}phone
{%- elif t | regex_search('位置|地點|座標') -%}pin
{%- elif t | regex_search('次數|數量|統計|計數') -%}counter
{%- elif t | regex_search('款式|型號|名稱|版本') -%}tag
{%- elif t | regex_search('更新') -%}update
{%- elif t | regex_search('重置|重啟|重新|重試') -%}refresh
{%- elif t | regex_search('關機|開機|電源') -%}power
{%- elif t | regex_search('通知|訊息|LINE') -%}mail
{%- elif t | regex_search('Bot|對話') -%}chat
{%- elif t | regex_search('維修|維護|保養') -%}tool
{%- elif t | regex_search('設定|參數|模式|情境|系統') -%}gear
{%- elif t | regex_search('失敗|異常|錯誤') -%}bug
{%- elif t | regex_search('已完成|成功|正常') -%}check
{%- endif -%}
{%- endmacro %}

{# 重要度配色：r 紅（緊急）／o 橘（警告）／g 綠（正常完成）／n 藍（一般資訊） #}
{% macro tone(t) -%}
{%- if t | regex_search('緊急|入侵|闖入|警報|地震|火災|一氧化碳|嚴重') -%}r
{%- elif t | regex_search('注意|警告|異常|失敗|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠') -%}o
{%- elif t | regex_search('已完成|成功|正常|已關閉|已上鎖|皆已|已恢復|已啟動|已執行|已開啟|已提前|已關') -%}g
{%- else -%}n
{%- endif -%}
{%- endmacro %}

{# V4.1.6：過長的句子在「，」靠近中間處斷行（LINE 自動換行會留下孤字，例如「請注／意。」）#}
{% macro balance(t, lim) -%}
{%- if (t | length) <= lim or '，' not in t -%}{{ t }}
{%- else -%}
  {%- set parts = t.split('，') -%}
  {%- set ns = namespace(best=1, bd=999, acc=0) -%}
  {%- for p in parts[:-1] -%}
    {%- set ns.acc = ns.acc + (p | length) + 1 -%}
    {%- set d = (ns.acc - (t | length) / 2) | abs -%}
    {%- if d < ns.bd -%}{%- set ns.bd = d -%}{%- set ns.best = loop.index -%}{%- endif -%}
  {%- endfor -%}
  {{- parts[:ns.best] | join('，') ~ '，' ~ '\n' ~ parts[ns.best:] | join('，') -}}
{%- endif -%}
{%- endmacro %}

{# V4.1.6：句尾的「請注意」拆出來，後面加注意圖示。回傳 JSON [前段, 請注意] ；沒有就回 ["",""] #}
{% macro ca_split(t) -%}
{%- set m = t | regex_findall('^(.*?)\\s*(請注意[。.]?)$') -%}
{%- if m | length > 0 and (m[0][0] == '' or m[0][0][-1:] in ['，', ',']) -%}{{ [m[0][0], m[0][1]] | tojson }}{%- else -%}["", ""]{%- endif -%}
{%- endmacro %}

{# V4.1.6：需要注意的行才放圖示 #}
{% macro is_warn(t) -%}
{%- if t | regex_search('注意|警告|異常|失敗|未關|沒關|未上鎖|沒上鎖|未鎖|離線|斷線|不穩|逾時|過低|過高|過熱|偏低|偏高|請確認|⚠|‼|❗|入侵|闖入|緊急') -%}1{%- endif -%}
{%- endmacro %}

{# 去掉行首的項目符號與 emoji（圖示取代它們） #}
{% macro noemoji(t) -%}
{{- (t | trim) | regex_replace('[🌀-🫿☀-➿⬀-⯿️‼❗❓]\uFE0F?', '') | regex_replace('^[，,、\s]+', '') | regex_replace('[，,、]+(?=。|$)', '') | regex_replace('\s{2,}', ' ') | trim -}}
{%- endmacro %}
{% macro clean(t) -%}
{{- noemoji((t | trim) | regex_replace('^[\s•·\-\*]+', '')) -}}
{%- endmacro %}
{% macro bullet(t) -%}
{{- noemoji((t | trim) | regex_replace('^[•·\-\*]+\s*', '')) -}}
{%- endmacro %}

{# 前處理：①每句（以「。」結尾）自成一行；②版本行拆成「名稱」＋「@@V@@舊@@新」兩行；網址行不拆 #}
{% macro prep(lines) -%}
{%- set arrow_re = '^(.+?)[：:]\s*(.*?\d.*?)\s*(?:→|->|➜)\s*(.+?)\s*$' -%}
{%- set one_re = '^(.+?)[：:]\s*((?:[Vv]\d|\d+\.\d+\.\d+|\d+(?:\.\d+)?\s*[（(]上次).*)$' -%}
{%- set ver_hint = '[Vv]\d|\d+\.\d+\.\d+|[Bb]eta' -%}
{%- set ns = namespace(out=[]) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.out = ns.out + [''] -%}
  {%- elif t | regex_search('https?://') -%}
    {%- set ns.out = ns.out + [t] -%}
  {%- elif t | regex_search('→|->|➜') and t | regex_search(ver_hint) and (t | regex_findall(arrow_re) | length) > 0 -%}
    {%- set m = (t | regex_findall(arrow_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@' ~ (m[1] | trim) ~ '@@' ~ (m[2] | trim)] -%}
  {%- elif (t | regex_findall(one_re) | length) > 0 and not (t | regex_search('。')) -%}
    {%- set m = (t | regex_findall(one_re))[0] -%}
    {%- set ns.out = ns.out + [m[0] | trim, '@@V@@@@' ~ (m[1] | trim)] -%}
  {%- else -%}
    {%- for part in (t | regex_replace('。\s*', '。\n')).split('\n') -%}
      {%- if part | trim != '' -%}{%- set ns.out = ns.out + [part | trim] -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# 行模型：JSON 清單，每個元素 {k: hdr|sec|ent|ver, t, icon, old, new, gap} #}
{% macro model(lines0) -%}
{%- set lines = prep(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[], first=true, sect='', gap=false, insec=false) -%}
{%- for l in lines -%}
  {%- set t = (l | string) | trim -%}
  {%- if t == '' -%}
    {%- set ns.gap = true -%}
  {%- elif ns.first -%}
    {%- set hb = bullet(t) -%}
    {%- set hc = ca_split(hb) | from_json(['', '']) -%}
    {%- set ns.out = ns.out + [{'k': 'hdr', 't': hb, 'tb': balance(hb, 15), 'ca': hc[1], 'pre': balance(hc[0], 15), 'cain': (hc[1] != '' and (hb | length) <= 15)}] -%}
    {%- set ns.first = false -%}
  {%- elif t.startswith('@@V@@') -%}
    {%- set p = t[5:].split('@@') -%}
    {%- set ns.out = ns.out + [{'k': 'ver', 'old': p[0], 'new': p[1] if p | length > 1 else ''}] -%}
  {%- elif t | regex_search('^[【\[].+[】\]]$') -%}
    {%- set ns.sect = t -%}
    {%- set ns.out = ns.out + [{'k': 'sec', 't': t}] -%}
    {%- set ns.gap = false -%}
  {%- else -%}
    {%- set c = clean(t) | trim -%}
    {%- set body = c if c else t -%}
    {%- set warn = is_warn(t) | trim == '1' -%}
    {%- set lv = (body | regex_findall('^([^：:。，,\s]{1,12})[：:]\s*(.+)$')) if not (body | regex_search('https?://')) else [] -%}
    {%- set is_sec = body | regex_search('^[^。]{1,16}[：:]$') -%}
    {#- V4.1.6：圖示只給「小標題行（以冒號結尾）」「名稱：數值」與「警告」行；一般句子不放圖示；顏色依重要度 -#}
    {%- set cat = pick(body) | trim -%}
    {%- set icon = (cat if cat else 'alarm') if warn else ((cat if cat else 'list') if is_sec else ((cat if cat else 'tag') if lv | length > 0 else '')) -%}
    {%- if ns.gap and not is_sec -%}{%- set ns.insec = false -%}{%- endif -%}
    {%- set sub = ns.insec and not is_sec and not warn -%}
    {%- if is_sec -%}{%- set ns.insec = true -%}{%- endif -%}
    {%- set lim = 20 if sub else (16 if icon else 18) -%}
    {%- set ec = (ca_split(body) | from_json(['', ''])) if (lv | length == 0) else ['', ''] -%}
    {%- set ns.out = ns.out + [{'k': 'ent', 't': body, 'tb': (body if (lv | length > 0) else balance(body, lim)), 'ca': ec[1], 'pre': balance(ec[0], lim), 'cain': (ec[1] != '' and (body | length) <= lim), 'sub': sub, 'icon': icon, 'tone': tone(body) | trim, 'sec': is_sec, 'lab': (lv[0][0] if lv | length > 0 else ''), 'val': (lv[0][1] if lv | length > 0 else ''), 'gap': ns.gap}] -%}
    {%- set ns.gap = false -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# LINE Flex：回傳 JSON 字串（清單） #}
{% macro flex_rows(lines0, base, max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(out=[]) -%}
{%- set b2 = base | replace('/icons/b/', '/icons/b2/') -%}
{%- for it in items -%}
  {%- set caimg = {"type": "image", "url": b2 ~ "alarm_o.png?v=1", "size": ("14px" if it.sub else "16px"), "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
  {%- if it.k == 'hdr' -%}
    {%- if it.ca -%}
      {%- set ns.out = ns.out + [{"type": "text", "size": "md", "weight": "bold", "wrap": true, "lineSpacing": "4px", "color": "#111827", "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": " ⚠︎", "color": "#F2994A"}]}] -%}
    {%- else -%}
      {%- set ns.out = ns.out + [{"type": "text", "text": it.tb, "size": "md", "weight": "bold", "wrap": true, "lineSpacing": "4px", "color": "#111827"}] -%}
    {%- endif -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.out = ns.out + [{"type": "text", "text": it.t, "size": "sm", "weight": "bold", "wrap": true, "margin": "xxl", "color": "#2F80ED"}] -%}
  {%- elif it.k == 'ent' -%}
    {%- set col = ({"r": "#B91C1C", "o": "#B45309"}[it.tone] if it.tone in ["r", "o"] else ("#111827" if it.sec else "#374151")) -%}
    {%- set sz = "xs" if it.sub else "sm" -%}
    {%- if it.lab -%}
      {%- set txt = {"type": "text", "size": "sm", "wrap": true, "flex": 1, "lineSpacing": "4px", "contents": [{"type": "span", "text": it.lab ~ "　", "color": "#6B7280", "size": "xs"}, {"type": "span", "text": it.val, "weight": "bold", "size": sz, "color": ({"r": "#B91C1C", "o": "#B45309"}[it.tone] if it.tone in ["r", "o"] else "#111827")}]} -%}
    {%- elif it.ca -%}
      {#- 句尾「請注意」：注意符號（無圓圈）接在同一段文字最後，換行時跟著文字走 -#}
      {%- set txt = {"type": "text", "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if it.icon else "regular"), "contents": [{"type": "span", "text": it.tb}, {"type": "span", "text": " ⚠︎", "color": "#F2994A", "weight": "bold"}]} -%}
    {%- else -%}
      {%- set txt = {"type": "text", "text": it.tb, "size": sz, "wrap": true, "flex": 1, "lineSpacing": "4px", "color": col, "weight": ("bold" if (it.icon and not it.lab) else "regular")} -%}
    {%- endif -%}
    {%- set mg = 'xl' if it.gap else ('sm' if it.sub else 'md') -%}
    {%- set pad = '26px' if it.sub else '0px' -%}
    {%- if it.icon -%}
      {%- set iimg = {"type": "image", "url": b2 ~ it.icon ~ "_" ~ it.tone ~ ".png?v=1", "size": ('14px' if it.sub else '20px'), "aspectRatio": "1:1", "flex": 0, "aspectMode": "fit"} -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "spacing": "sm", "alignItems": "center", "margin": mg, "paddingStart": pad, "contents": [iimg, txt]}] -%}
    {%- else -%}
      {%- set ns.out = ns.out + [{"type": "box", "layout": "horizontal", "margin": mg, "paddingStart": pad, "contents": [txt]}] -%}
    {%- endif -%}
  {%- else -%}
    {%- set spans = ([{"type": "span", "text": it.old, "color": "#9CA3AF"}, {"type": "span", "text": "   →   ", "color": "#9CA3AF"}] if it.old else []) + [{"type": "span", "text": it.new, "weight": "bold", "color": ("#16A34A" if it.old else "#4B5563")}] -%}
    {%- set ns.out = ns.out + [{"type": "box", "layout": "vertical", "margin": "xs", "paddingStart": "28px", "contents": [{"type": "text", "size": "xs", "wrap": true, "contents": spans}]}] -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.out | tojson -}}
{%- endmacro %}

{# HA 通知（Markdown）：與 LINE 同一份行模型；每個項目之間空一行，版本接在名稱下一行 #}
{% macro md_lines(lines0, base, url='', max_icons=5) -%}
{%- set items = model(lines0) | from_json([]) -%}
{%- set ns = namespace(md=[]) -%}
{%- for it in items -%}
  {%- if it.k == 'hdr' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set ns.md = ns.md + ['**' ~ body ~ '**' ~ (' <span style="color:#F2994A">⚠︎</span>' if it.ca else '')] -%}
  {%- elif it.k == 'sec' -%}
    {%- set ns.md = ns.md + ['**' ~ it.t ~ '**'] -%}
  {%- elif it.k == 'ent' -%}
    {%- set body = it.t | replace(url, '[開啟連結](' ~ url ~ ')') if url else it.t -%}
    {%- set pre = ('<img src="' ~ (base | replace('/icons/b/', '/icons/b2/')) ~ it.icon ~ '_' ~ it.tone ~ '.png" width="18" height="18" style="vertical-align:middle"> ') if it.icon else '' -%}
    {%- set ind = '  ' if it.sub else '' -%}
    {%- set caimg = ' <span style="color:#F2994A">⚠︎</span>' if it.ca else '' -%}
    {%- if it.lab and not url -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ it.lab ~ '　**' ~ it.val ~ '**'] -%}
    {%- else -%}
      {%- set ns.md = ns.md + [ind ~ '- ' ~ pre ~ body ~ caimg] -%}
    {%- endif -%}
  {%- else -%}
    {%- set v = ('<code>' ~ it.old ~ '</code> → <b><code>' ~ it.new ~ '</code></b>') if it.old else ('<code>' ~ it.new ~ '</code>') -%}
    {%- if ns.md | length > 0 -%}
      {%- set ns.md = ns.md[:-1] + [ns.md[-1] ~ '<br>' ~ v] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{- ns.md | join('\n\n') -}}
{%- endmacro %}
